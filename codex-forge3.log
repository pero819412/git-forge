        if (chunk.done) break;
        const text = decoder.decode(chunk.value, { stream: true });
        bodyText += text;
        buffer += text;
        for (;;) {
          const newline = buffer.indexOf('\n');
          if (newline < 0) break;
          const raw = buffer.slice(0, newline);
          buffer = buffer.slice(newline + 1);
          const line = raw.endsWith('\r') ? raw.slice(0, -1) : raw;
