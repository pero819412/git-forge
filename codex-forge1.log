// github-core-clone-01's check manifest and scoring constants: the seven check groups (120 checks),
// the feature column (600), the agent-native column (200), the four benchmark workloads with their
// T_ref slots, and the perf column (200) with the tier formula. The score is their sum, 0..1000.
//
// Why a table of groups and not a table of checks: a sealed bundle inlines whatever its source imports,
// so a manifest that held every check's function would pull the whole suite into one module and make
// every group's code inseparable. Instead each check lives in its group's module
// (env/src/checks-git.ts, checks-rest.ts, checks-graphql.ts, checks-mcp.ts), which exports a
// `readonly CheckSpec[]`; this file fixes the group names, the counts they must add up to, the
// CheckSpec/CheckContext types, and every constant the scorer reads. validateCheckSpecs() is the one
// place that proves the four lists add up to the manifest before a run.
//
// The columns (the settled scoring contract):
//   feature = round(600 * passedChecks / totalChecks), totalChecks = TOTAL_CHECKS (120)
//   agent   = round(200 * passedAgentChecks / AGENT_CHECKS), the mcp group's passed count out of 15
//   perf    = sum over the four workloads of round(clamp(25 - 12.5*log2(t_ms / T_ref_ms), 0, 50))
//   score   = feature + agent + perf, an integer 0..1000
// The mcp group is counted both in the feature column's 120 and, alone, as the agent column: the
// settled contract weights agent-native support that way on purpose. A T_ref of 0 means the house
// reference has not been calibrated for that workload yet, and the workload earns 0 points (the run is
// `calibrated: false` in perf.json). T_ref is the house reference's measured time for the same fixed
// work, in ms, on the production sandbox; T_REF_MS reads the four values from env/src/calibration.json
// (the calibration run's measured medians) and nothing else.
//
// The tie-break is `perf_p50_us` ascending (the geometric mean of the four workloads' p50_ms, in
// microseconds, rounded): a lower figure ranks first among equal scores, then the earlier receipt.
// Nothing in a pass/fail check reads a clock; these constants are the only place a time becomes points.

import calibration from './calibration.json' with { type: 'json' };
import type { Bit, CheckId, PerfFile, PerfTier, Scenario, StateCounts, StateFile } from './wire.ts';
import {
  BENCHMARK_BUDGET_MS,
  CHECK_TIMEOUT_MAX_MS,
  CHECK_TIMEOUT_MS,
  CHECK_TIMEOUT_MIN_MS,
  STATE_VERSION,
  WireError,
} from './wire.ts';

/** The manifest's version, bumped when the groups or the scoring constants change. */
export const MANIFEST_VERSION = 1;

// ---------------------------------------------------------------- the check groups

/** The seven check groups, in the order the SDK and the checks trace print them. */
export type CheckGroupId = 'git' | 'repos' | 'issues' | 'pulls' | 'graphql' | 'mcp' | 'protocol';

/** One group: its id, what it proves, and how many checks it declares. */
export interface CheckGroupSpec {
  readonly id: CheckGroupId;
  /** The short name a person reads on the checks table. */
  readonly title: string;
  /** How many checks the group declares; the group's module must register exactly this many. */
  readonly checks: number;
  /** One line: what the group proves. */
  readonly about: string;
}

/**
 * The check groups. `git` is the smart-HTTP protocol; `repos`, `issues` and `pulls` are REST v3;
 * `graphql` is v4; `mcp` is the Model Context Protocol endpoint (and the agent column); `protocol`
 * is the status/auth/JSON discipline every surface shares. The counts are the settled contract:
 * 30 + 15 + 15 + 20 + 20 + 15 + 5 = 120.
 */
export const CHECK_GROUPS: readonly CheckGroupSpec[] = Object.freeze([
  Object.freeze({ id: 'git', title: 'Git smart HTTP', checks: 30, about: 'clone, fetch, push and the pack protocol against the entry as a real git server' }),
  Object.freeze({ id: 'repos', title: 'Repositories', checks: 15, about: 'the REST v3 repository, branch, commit and contents APIs' }),
  Object.freeze({ id: 'issues', title: 'Issues', checks: 15, about: 'the REST v3 issue, comment and label APIs' }),
  Object.freeze({ id: 'pulls', title: 'Pull requests', checks: 20, about: 'the REST v3 pull request, files and merge APIs' }),
  Object.freeze({ id: 'graphql', title: 'GraphQL v4', checks: 20, about: 'the v4 documents gh and github-mcp-server actually send' }),
  Object.freeze({ id: 'mcp', title: 'MCP', checks: 15, about: 'the streamable-HTTP MCP endpoint, its tools, and their effect on the REST view' }),
  Object.freeze({ id: 'protocol', title: 'Wire protocol', checks: 5, about: 'status codes, JSON and error bodies, auth, pagination headers and method handling' }),
]);

/** The group ids, in table order. */
export const CHECK_GROUP_IDS: readonly CheckGroupId[] = Object.freeze(CHECK_GROUPS.map((group) => group.id));

/** The group table as a map: id to its spec. */
export const CHECK_GROUP_BY_ID: Readonly<Record<CheckGroupId, CheckGroupSpec>> = Object.freeze(
  Object.fromEntries(CHECK_GROUPS.map((group) => [group.id, group])) as Record<CheckGroupId, CheckGroupSpec>,
);

/** How many checks each group declares. */
export const CHECK_COUNTS: Readonly<Record<CheckGroupId, number>> = Object.freeze(
  Object.fromEntries(CHECK_GROUPS.map((group) => [group.id, group.checks])) as Record<CheckGroupId, number>,
);

/** Every check the manifest declares: the feature column's denominator. */
export const TOTAL_CHECKS = 120;

/** The group whose passed count is the agent column. */
export const AGENT_GROUP: CheckGroupId = 'mcp';

/** The agent column's denominator: the mcp group's checks, fixed. */
export const AGENT_CHECKS = 15;

/** Every issue the group table itself holds (empty is the only healthy answer). */
export function groupTableIssues(): string[] {
  const issues: string[] = [];
  let sum = 0;
  const seen = new Set<string>();
  for (const group of CHECK_GROUPS) {
    if (seen.has(group.id)) issues.push(`group ${group.id} appears twice`);
    seen.add(group.id);
    if (!Number.isSafeInteger(group.checks) || group.checks <= 0) issues.push(`group ${group.id} declares ${String(group.checks)} checks`);
    sum += Number.isSafeInteger(group.checks) && group.checks > 0 ? group.checks : 0;
    if (group.title.trim() === '') issues.push(`group ${group.id} has no title`);
  }
  if (sum !== TOTAL_CHECKS) issues.push(`the groups declare ${sum} checks, not TOTAL_CHECKS (${TOTAL_CHECKS})`);
  if (CHECK_COUNTS[AGENT_GROUP] !== AGENT_CHECKS) issues.push(`${AGENT_GROUP} declares ${String(CHECK_COUNTS[AGENT_GROUP])} checks, not AGENT_CHECKS (${AGENT_CHECKS})`);
  return issues;
}

// ---------------------------------------------------------------- a check

/** What one check reports: a pass/fail bit and, when it fails, one line of why (no times). */
export interface CheckResult {
  readonly ok: boolean;
  readonly detail?: string;
}

/** A passing result, with an optional line of what it proved. */
export function pass(detail?: string): CheckResult {
  return detail === undefined ? { ok: true } : { ok: true, detail };
}

/** A failing result: `detail` says what the entry answered, never a timing. */
export function fail(detail: string): CheckResult {
  return { ok: false, detail };
}

/**
 * What a check gets to work with: the entry's origin and token, the one seeded scenario, its own
 * deadline and timeout, an abort signal, and a log sink for diagnostics that never reaches state.json.
 * The runner aborts `signal` when the phase's deadline falls and records the check 0 with "deadline".
 */
export interface CheckContext {
  /** The entry's origin, no trailing slash (wire.ts EntryBase.url). */
  readonly baseUrl: string;
  /** The bearer token every API call presents (wire.ts TOKEN_ENV, MAKEFUN_SHOP_TOKEN). */
  readonly token: string;
  /** The seeded scenario every name, path, blob and title comes from (wire.ts buildScenario()). */
  readonly scenario: Scenario;
  /** Aborted when the phase's deadline or the trial's abort falls: a check must stop. */
  readonly signal: AbortSignal;
  /** The runner's monotonic clock (performance.now()) at which this check must stop. */
  readonly deadlineMs: number;
  /** The check's own timeout budget, ms: CHECK_TIMEOUT_MIN_MS..CHECK_TIMEOUT_MAX_MS, clamped to the phase. */
  readonly timeoutMs: number;
  /** A diagnostic line (stderr, the SDK's table); never scored, never written to state.json. */
  log(message: string): void;
}

/** One check's body: a result, or a throw the runner records as a failure with the message. */
export type CheckFn = (context: CheckContext) => CheckResult | Promise<CheckResult>;

/** One registered check: its id, its group, its title, an optional timeout, and its body. */
export interface CheckSpec {
  /** `<group>.<slug>`: build it with checkId() so group and id can never disagree. */
  readonly id: CheckId;
  readonly group: CheckGroupId;
  /** What the check proves, one line, shown in the SDK's table. */
  readonly title: string;
  /** Its timeout, ms; default CHECK_TIMEOUT_MS, clamped to CHECK_TIMEOUT_MIN_MS..CHECK_TIMEOUT_MAX_MS. */
  readonly timeoutMs?: number;
  readonly fn: CheckFn;
}

const CHECK_SLUG_RE = /^[a-z0-9][a-z0-9-]*$/;

/** A check id from its group and slug: `checkId('git', 'clone-empty')` is `git.clone-empty`. */
export function checkId(group: CheckGroupId, slug: string): CheckId {
  if (!CHECK_SLUG_RE.test(slug)) throw new WireError(`a check slug is lowercase letters, digits and hyphens, not ${JSON.stringify(slug)}`);
  return `${group}.${slug}`;
}

/** A parsed check id. */
export interface ParsedCheckId {
  readonly group: CheckGroupId;
  readonly slug: string;
}

/** The group and slug of an id, or null when it is not `<known group>.<slug>`. */
export function parseCheckId(id: string): ParsedCheckId | null {
  const at = id.indexOf('.');
  if (at <= 0 || at === id.length - 1) return null;
  const group = id.slice(0, at);
  const slug = id.slice(at + 1);
  if (!CHECK_GROUP_IDS.includes(group as CheckGroupId)) return null;
  if (!CHECK_SLUG_RE.test(slug)) return null;
  return { group: group as CheckGroupId, slug };
}

/** The group an id belongs to, or null when it is not a manifest id. */
export function checkGroupOf(id: string): CheckGroupId | null {
  return parseCheckId(id)?.group ?? null;
}

/** The timeout a check gets: its own or the default, inside the allowed range and the phase's remainder. */
export function checkTimeoutMs(requestedMs: number | undefined, remainingMs: number): number {
  const want = requestedMs === undefined ? CHECK_TIMEOUT_MS : requestedMs;
  const inRange = Number.isFinite(want) ? Math.min(CHECK_TIMEOUT_MAX_MS, Math.max(CHECK_TIMEOUT_MIN_MS, want)) : CHECK_TIMEOUT_MS;
  if (!Number.isFinite(remainingMs)) return inRange;
  return Math.max(0, Math.min(inRange, remainingMs));
}

/**
 * Every way the registered checks disagree with the manifest: a duplicate id, an id not
 * `<group>.<slug>`, an id registered under another group, an empty title, a group whose registered
 * count is not its declared count. Empty when the suite is exactly the manifest; the runner refuses to
 * score a suite that is not, so a missing group cannot be papered over by a smaller denominator.
 */
export function validateCheckSpecs(specs: readonly CheckSpec[]): string[] {
  const issues: string[] = [];
  const ids = new Set<string>();
  const counts: Partial<Record<CheckGroupId, number>> = {};
  for (const spec of specs) {
    if (ids.has(spec.id)) issues.push(`duplicate check id ${spec.id}`);
    ids.add(spec.id);
    const parsed = parseCheckId(spec.id);
    if (parsed === null) issues.push(`check id ${JSON.stringify(spec.id)} is not <group>.<slug>`);
    else if (parsed.group !== spec.group) issues.push(`check id ${spec.id} names group ${parsed.group} but is registered as ${spec.group}`);
    if (spec.title.trim() === '') issues.push(`check ${spec.id} has no title`);
    if (typeof spec.fn !== 'function') issues.push(`check ${spec.id} has no fn`);
    counts[spec.group] = (counts[spec.group] ?? 0) + 1;
  }
  for (const group of CHECK_GROUPS) {
    const registered = counts[group.id] ?? 0;
    if (registered !== group.checks) issues.push(`${group.id} declares ${group.checks} checks but ${registered} are registered`);
  }
  return issues;
}

/** Every check id the four group modules register, in table then registration order (for the export). */
export function checkIdsOf(specs: readonly CheckSpec[]): CheckId[] {
  return specs.map((spec) => spec.id);
}

// ---------------------------------------------------------------- the columns

/** The feature column's maximum: 600 of a score's 1000. */
export const FEATURE_COLUMN_MAX = 600;
/** The agent-native column's maximum: 200. */
export const AGENT_COLUMN_MAX = 200;
/** The performance column's maximum: 200. */
export const PERF_COLUMN_MAX = 200;
/** A perfect score: 1000. */
export const SCORE_MAX = 1000;
/** The most points one benchmark workload earns. */
export const PERF_WORKLOAD_MAX = 50;
/** One perf tier's width: 12.5 points. */
export const PERF_TIER_STEP = 12.5;
/** The highest perf tier: 4 (a workload at 50 points). */
export const PERF_TIER_MAX = 4;

/**
 * The feature column: `round(600 * passedChecks / totalChecks)`, clamped to 0..600. `passedChecks`
 * beyond the total (a malformed counts block) is clamped; a non-positive or missing total falls back
 * to TOTAL_CHECKS so the column can only be 0 at worst, never NaN.
 */
export function featurePoints(passedChecks: number, totalChecks: number = TOTAL_CHECKS): number {
  const total = Number.isFinite(totalChecks) && totalChecks > 0 ? totalChecks : TOTAL_CHECKS;
  const passed = Number.isFinite(passedChecks) ? Math.min(Math.max(0, passedChecks), total) : 0;
  return Math.round((FEATURE_COLUMN_MAX * passed) / total);
}

/** The agent column: `round(200 * passedAgentChecks / totalAgentChecks)`, clamped to 0..200. */
export function agentPoints(passedAgentChecks: number, totalAgentChecks: number = AGENT_CHECKS): number {
  const total = Number.isFinite(totalAgentChecks) && totalAgentChecks > 0 ? totalAgentChecks : AGENT_CHECKS;
  const passed = Number.isFinite(passedAgentChecks) ? Math.min(Math.max(0, passedAgentChecks), total) : 0;
  return Math.round((AGENT_COLUMN_MAX * passed) / total);
}

/** One column value clamped to an integer 0..max (a corrupt export's NaN becomes 0). */
export function clampColumn(value: number, max: number): number {
  if (!Number.isFinite(value)) return 0;
  return Math.min(max, Math.max(0, Math.round(value)));
}

/** A score's parts: the three columns and their sum. */
export interface ScoreParts {
  readonly feature: number;
  readonly agent: number;
  readonly perf: number;
  readonly score: number;
}

/** feature + agent + perf, each clamped to its column, so the score is an integer 0..1000. */
export function compositeScore(feature: number, agent: number, perf: number): ScoreParts {
  const f = clampColumn(feature, FEATURE_COLUMN_MAX);
  const a = clampColumn(agent, AGENT_COLUMN_MAX);
  const p = clampColumn(perf, PERF_COLUMN_MAX);
  return Object.freeze({ feature: f, agent: a, perf: p, score: f + a + p });
}

/** The mcp group's passed count, the agent column's numerator (0 when the export has no mcp row). */
export function agentPassedOf(counts: StateCounts): number {
  return counts.byGroup[AGENT_GROUP]?.passed ?? 0;
}

/**
 * The columns a trial's exports earn. `feature` reads the counts the env wrote, `agent` the mcp
 * group's row, `perf` perf.json's points_total. A missing group falls back to its declared count (the
 * column scores 0, never NaN). This is the scorer's reference arithmetic; it never reads the clock.
 */
export function scoreOf(state: Pick<StateFile, 'counts'>, perf: Pick<PerfFile, 'points_total'>): ScoreParts {
  const feature = featurePoints(state.counts.passed, state.counts.total);
  const mcp = state.counts.byGroup[AGENT_GROUP];
  const agentPassed = mcp?.passed ?? 0;
  const agentTotal = mcp !== undefined && mcp.total > 0 ? mcp.total : AGENT_CHECKS;
  const agent = agentPoints(agentPassed, agentTotal);
  const perfPoints = clampColumn(perf.points_total, PERF_COLUMN_MAX);
  return compositeScore(feature, agent, perfPoints);
}

// ---------------------------------------------------------------- the benchmark workloads

/** The four benchmark workloads' names. */
export type BenchWorkloadName = 'push' | 'clone' | 'read' | 'write';

/** One benchmark workload: fixed work, timed in rounds, scored by the tier formula. */
export interface BenchWorkloadSpec {
  readonly name: BenchWorkloadName;
  readonly title: string;
  /** One line: exactly what a round does and what is timed. */
  readonly about: string;
  /** The fixed operations one round performs, so a time means the same work for every entry. */
  readonly ops: number;
  /** Timed rounds; the median round is the workload's time. */
  readonly rounds: number;
  /** Untimed warm-up operations before the first round. */
  readonly warmupOps: number;
  /** The most wall time this workload may take in the benchmark phase; past it the workload is 0. */
  readonly budgetMs: number;
}

/** How many timed rounds every workload runs (manifest.ts BENCH_WORKLOADS' rounds). */
export const BENCH_ROUNDS = 3;
/** How many untimed warm-up operations precede a workload's first round. */
export const BENCH_WARMUP_OPS = 5;
/** The benchmark phase's budget for all four workloads together (wire.ts BENCHMARK_BUDGET_MS). */
export const BENCH_PHASE_BUDGET_MS = BENCHMARK_BUDGET_MS;

/**
 * The four workloads. Each is one fixed amount of work measured three times with a monotonic clock;
 * the payloads are built before the first timing starts, the rounds are timed after BENCH_WARMUP_OPS
 * untimed operations, and a workload that cannot finish in budgetMs stops early and scores 0. The
 * workload's own p50 is the median round; perf.json keeps every round's ms. No pass/fail check reads
 * these times.
 */
export const BENCH_WORKLOADS: readonly BenchWorkloadSpec[] = Object.freeze([
  Object.freeze({
    name: 'push',
    title: 'Push',
    about: '200 sequential pushes of a 1 KiB change to one repository (one receive-pack update and new commit each)',
    ops: 200,
    rounds: BENCH_ROUNDS,
    warmupOps: BENCH_WARMUP_OPS,
    budgetMs: 60_000,
  }),
  Object.freeze({
    name: 'clone',
    title: 'Clone',
    about: '50 concurrent shallow clones (depth 1) of a 200-commit repository, each stream checksum-verified',
    ops: 50,
    rounds: BENCH_ROUNDS,
    warmupOps: BENCH_WARMUP_OPS,
    budgetMs: 60_000,
  }),
  Object.freeze({
    name: 'read',
    title: 'Read',
    about: '2,000 sequential GET /api/v3/repos/{owner}/{repo}/issues/{n} on a warm keep-alive connection',
    ops: 2_000,
    rounds: BENCH_ROUNDS,
    warmupOps: BENCH_WARMUP_OPS,
    budgetMs: 60_000,
  }),
  Object.freeze({
    name: 'write',
    title: 'Write',
    about: '200 sequential POST /api/v3/repos/{owner}/{repo}/issues',
    ops: 200,
    rounds: BENCH_ROUNDS,
    warmupOps: BENCH_WARMUP_OPS,
    budgetMs: 60_000,
  }),
]);

/** The workload names, in table order. */
export const BENCH_WORKLOAD_NAMES: readonly BenchWorkloadName[] = Object.freeze(BENCH_WORKLOADS.map((workload) => workload.name));

/** The calibration contract this manifest reads: env/src/calibration.json's schema and contest. */
export const CALIBRATION_SCHEMA = 'agent-fun/calibration/v1';
/** The contest the calibration file was measured for: a file for another contest is a build error, not a silently wrong T_ref. */
export const CALIBRATION_CONTEST = 'github-core-clone-01';

if (calibration.schema !== CALIBRATION_SCHEMA) {
  throw new TypeError(`calibration.json is ${JSON.stringify(calibration.schema)}, not ${JSON.stringify(CALIBRATION_SCHEMA)}`);
}
if (calibration.contest !== CALIBRATION_CONTEST) {
  throw new TypeError(`calibration.json was measured for ${JSON.stringify(calibration.contest)}, not ${JSON.stringify(CALIBRATION_CONTEST)}`);
}

/** One workload's measured p50 from calibration.json, in ms; 0 when it is not a positive number (uncalibrated). */
function calibratedTRefMs(name: BenchWorkloadName): number {
  const p50 = calibration.workloads[name]?.p50_ms;
  return typeof p50 === 'number' && Number.isFinite(p50) && p50 > 0 ? p50 : 0;
}

/**
 * The T_ref slots: the house reference's calibrated time for each workload's fixed work, in ms, on the
 * production sandbox. They are calibration.json's four measured p50_ms values (env/src/calibration.json,
 * measured in a gVisor pod on the e2e rig); esbuild inlines the JSON into env/server.mjs, and
 * sdk/sync.sh copies the file beside sdk/conformance/manifest.ts so the kit's runner resolves it. 0 means
 * "not calibrated yet": that workload earns 0 points and perf.json's `calibrated` is false. Nothing else
 * edits these four values; re-measure only when the trial shape changes (calibration.json's re_measure).
 */
export const T_REF_MS: Readonly<Record<BenchWorkloadName, number>> = Object.freeze({
  push: calibratedTRefMs('push'),
  clone: calibratedTRefMs('clone'),
  read: calibratedTRefMs('read'),
  write: calibratedTRefMs('write'),
});

/** Whether every workload has a calibrated T_ref (perf.json's `calibrated`). */
export function isCalibrated(tRefs: Readonly<Record<BenchWorkloadName, number>> = T_REF_MS): boolean {
  return BENCH_WORKLOADS.every((workload) => Number.isFinite(tRefs[workload.name]) && tRefs[workload.name] > 0);
}

/** A workload's T_ref in ms (0 when uncalibrated). */
export function tRefMs(name: BenchWorkloadName): number {
  return T_REF_MS[name];
}

/** One workload's spec by name; a WireError on an unknown name. */
export function benchWorkload(name: string): BenchWorkloadSpec {
  const found = BENCH_WORKLOADS.find((workload) => workload.name === name);
  if (found === undefined) throw new WireError(`no benchmark workload ${JSON.stringify(name)} (the workloads are ${BENCH_WORKLOAD_NAMES.join(', ')})`);
  return found;
}

/**
 * One workload's points: `round(clamp(25 - 12.5*log2(t_ms / T_ref_ms), 0, 50))`. A missing, zero or
 * non-finite time, or an uncalibrated T_ref (0), is 0 points: never a bonus for a workload that did
 * not run.
 */
export function workloadPoints(tMs: number, tRef: number): number {
  if (!Number.isFinite(tMs) || tMs <= 0) return 0;
  if (!Number.isFinite(tRef) || tRef <= 0) return 0;
  const raw = 25 - 12.5 * Math.log2(tMs / tRef);
  return Math.round(Math.min(PERF_WORKLOAD_MAX, Math.max(0, raw)));
}

/** The perf column: the four workloads' points summed, 0..200 (an absent time is 0 points). */
export function perfColumn(timesMs: Partial<Record<BenchWorkloadName, number>>, tRefs: Readonly<Record<BenchWorkloadName, number>> = T_REF_MS): number {
  let total = 0;
  for (const workload of BENCH_WORKLOADS) {
    total += workloadPoints(timesMs[workload.name] ?? 0, tRefs[workload.name]);
  }
  return total;
}

/** One workload's points as the perf tier state.json carries: floor(points / 12.5), clamped 0..4. */
export function perfTier(points: number): PerfTier {
  if (!Number.isFinite(points) || points <= 0) return 0;
  const tier = Math.floor(points / PERF_TIER_STEP);
  return Math.min(PERF_TIER_MAX, Math.max(0, tier)) as PerfTier;
}

/** The four workloads' tiers, keyed by name (state.json's perfTiers and perf.json's tiers). */
export function perfTiersOf(points: Readonly<Partial<Record<BenchWorkloadName, number>>>): Record<string, PerfTier> {
  const tiers: Record<string, PerfTier> = {};
  for (const workload of BENCH_WORKLOADS) tiers[workload.name] = perfTier(points[workload.name] ?? 0);
  return tiers;
}

/**
 * The leaderboard's tie-break: the geometric mean of the workloads' p50_ms, in microseconds, rounded.
 * Each time is floored at 1 microsecond so a 0 ms round cannot make the mean 0 and win by accident.
 */
export function perfTieBreakUs(p50Ms: readonly number[]): number {
  if (p50Ms.length === 0) return 0;
  let logSum = 0;
  for (const ms of p50Ms) logSum += Math.log(Math.max(Number.isFinite(ms) ? ms : 0.001, 0.001));
  return Math.round(1000 * Math.exp(logSum / p50Ms.length));
}

// ---------------------------------------------------------------- the export's counts

/**
 * The counts block from a run's checks: every group's declared total and the passed count its checks
 * earned. An id not in the manifest is ignored (it cannot earn points); a missing id is a check that
 * did not run, hence 0. `total` is always TOTAL_CHECKS, so the feature column's denominator cannot be
 * shrunk by dropping checks from the export.
 */
export function countsFromChecks(checks: Readonly<Record<CheckId, Bit>>): StateCounts {
  const byGroup: Record<string, { total: number; passed: number }> = {};
  for (const group of CHECK_GROUPS) byGroup[group.id] = { total: group.checks, passed: 0 };
  let passed = 0;
  for (const [id, bit] of Object.entries(checks)) {
    const group = checkGroupOf(id);
    if (group === null) continue;
    const row = byGroup[group];
    if (row === undefined) continue;
    if (bit === 1) {
      row.passed += 1;
      passed += 1;
    }
  }
  return { total: TOTAL_CHECKS, passed, byGroup };
}

/**
 * state.json from a run's results: every declared id gets its 0|1 (`checkIds` is the manifest's whole
 * list; an id missing from `checks` is 0), counts are derived, and the perf tiers are the four
 * workloads' bands. `working` is the caller's bit (wire.ts workingBit); the notes hold fixed causes only.
 */
export function stateFromChecks(input: {
  readonly checks: Readonly<Record<CheckId, Bit>>;
  readonly checkIds: readonly CheckId[];
  readonly perfTiers?: Readonly<Record<string, PerfTier>>;
  readonly working?: Bit;
  readonly notes?: readonly string[];
}): StateFile {
  const complete: Record<CheckId, Bit> = {};
  for (const id of input.checkIds) complete[id] = input.checks[id] === 1 ? 1 : 0;
  for (const [id, bit] of Object.entries(input.checks)) {
    if (!(id in complete)) complete[id] = bit === 1 ? 1 : 0;
  }
  const state: StateFile = {
    version: STATE_VERSION,
    working: input.working ?? 0,
    checks: complete,
    counts: countsFromChecks(complete),
    perfTiers: { ...(input.perfTiers ?? {}) },
    ...(input.notes !== undefined && input.notes.length > 0 ? { notes: input.notes.slice() } : {}),
  };
  return state;
}
// The GitHub REST v3 conformance checks: the `repos`, `issues` and `pulls` groups, plus the
// REST share of `protocol`. Every check drives the entry's `/api/v3` surface through
// rest-client.ts and returns {ok, detail}; a check never throws and never scores a timing.
//
// The entry is a fresh server each trial and holds no state of its own, so every check creates
// what it needs through the API: a repository (POST /user/repos), its first commit (PUT
// /contents, which an unborn repository accepts), a branch (POST /git/refs) and the commits and
// pull requests above it. Every name, path, blob, message and title comes from wire.ts's one
// seeded scenario (restScenarioOf), so two runs on the same entry and seed send byte-identical
// requests in the same order and reach the same pass/fail bits. No check reads the clock or
// Math.random, and no timing reaches a bit.
//
// One bearer token (wire.ts TOKEN_ENV, MAKEFUN_SHOP_TOKEN) is the viewer's; a repository belongs
// to the login the token names, and the same name under another seeded login (the stranger) is
// not this token's to read.
//
// The endpoint contract these checks require (the exact statuses the rules must state):
//
//   GET    /api/v3/                                     200, JSON, X-OAuth-Scopes header
//   GET    /api/v3/meta                                 200, {"installed_version": string}
//   POST   /api/v3/user/repos                           201 {name, private, default_branch, ...}
//   GET    /api/v3/repos/{o}/{r}                        200 {name, private, default_branch, description}
//                                                       404 {"message": string} when absent
//   PATCH  /api/v3/repos/{o}/{r}                        200, description updated
//   DELETE /api/v3/repos/{o}/{r}                        204, gone afterwards (404)
//   GET    /api/v3/user/repos?per_page=10               200 list, Link: <...>; rel="next"
//   POST   /api/v3/repos/{o}/{r}/git/refs               201 {ref, object:{sha}}   (branch create)
//   GET    /api/v3/repos/{o}/{r}/branches               200 [{name, commit:{sha}}]
//   GET    /api/v3/repos/{o}/{r}/commits[?sha=<ref>]    200 [{sha, commit:{message}}]
//   PUT    /api/v3/repos/{o}/{r}/contents/{path}        201 {content:{sha, encoding}, commit:{sha}}
//                                                       200 on update, 409 on a stale sha
//   GET    /api/v3/repos/{o}/{r}/contents/{path}[?ref=] 200 file {encoding:"base64", content, sha, size}
//                                                       or a directory listing (array) when a directory
//   DELETE /api/v3/repos/{o}/{r}/contents/{path}        200 {commit:{sha}}, 404 afterwards
//   POST   /api/v3/repos/{o}/{r}/labels                 201 {name, color}
//   POST   /api/v3/repos/{o}/{r}/issues                 201 {number, title, body, state, labels}
//                                                       422 on an unknown label
//   GET    /api/v3/repos/{o}/{r}/issues?state=&sort=    200 list, filtered and sorted
//   GET    /api/v3/repos/{o}/{r}/issues/{n}             200 one issue
//   PATCH  /api/v3/repos/{o}/{r}/issues/{n}             200, {state:"closed"} closes
//   POST   /api/v3/repos/{o}/{r}/issues/{n}/comments    201 {id, body}
//   GET    /api/v3/repos/{o}/{r}/issues/{n}/comments    200 list
//   POST   /api/v3/repos/{o}/{r}/pulls                  201 {number, state:"open", head, base}
//   GET    /api/v3/repos/{o}/{r}/pulls?state=all        200 list
//   GET    /api/v3/repos/{o}/{r}/pulls/{n}              200 one pull; 404 when unknown
//   GET    /api/v3/repos/{o}/{r}/pulls/{n}/files        200 [{filename, status, additions, ...}]
//   PUT    /api/v3/repos/{o}/{r}/pulls/{n}/merge        200 {sha, merged:true, message}
//                                                       404 unknown PR, 405 a conflicted PR
//
// Ownership: a repository belongs to the login the token names, so the same repository name
// under another seeded login is 404 (never 403), and a request with no token is 401.
// Protocol: every reply is application/json (never HTML), an unknown route is a JSON 404, a
// malformed JSON request body is a 400, every reply carries a non-empty X-GitHub-Request-Id
// header, and no X-RateLimit-* header is required.

import {
  apiPath,
  b64decode,
  b64encode,
  checkShape,
  describeResponse,
  expectHeader,
  expectJsonResponse,
  expectNoHtml,
  expectStatus,
  isJsonContentType,
  parseLinkHeader,
  RestClient,
  sameOrigin,
  shapes,
  type RestResponse,
  type Shape,
  type StatusExpectation,
} from './rest-client.ts';
import { checkId, type CheckContext, type CheckGroupId, type CheckSpec } from './manifest.ts';
import type { Scenario } from './wire.ts';

type Json = Record<string, unknown>;

/** The manifest groups this module fills. */
export type RestGroup = Extract<CheckGroupId, 'repos' | 'issues' | 'pulls' | 'protocol'>;

/**
 * Everything the checks send, derived from wire.ts's one seeded scenario. Two runs on the same
 * entry and seed build this object identically: no Date, no Math.random, no process values.
 */
export interface RestScenario {
  /** The login the bearer token owns (wire.ts Scenario.viewer). */
  owner: string;
  /** Another user's login, with no rights on the first user's repositories (Scenario.stranger). */
  otherOwner: string;
  /** Every repository a check creates is named from this prefix plus the check id. */
  repoPrefix: string;
  /** The 30 seeded viewer repository names, created for the pagination check (Scenario.repos). */
  paginationRepos: readonly string[];
  /** A repository-relative file path, usable with the contents API (may hold '/'). */
  filePath: string;
  /** A repository-relative directory path, for the directory-listing check. */
  dirPath: string;
  /** The file's seeded contents, and the second revision the update checks commit. */
  fileContent: string;
  fileContentAlt: string;
  /** The commit message every contents commit carries. */
  commitMessage: string;
  /** The base name of the head branches the pull-request checks open from. */
  branchName: string;
  /** Seeded issue and pull text. */
  issueTitle: string;
  issueBody: string;
  commentBody: string;
  pullTitle: string;
  pullBody: string;
  /** An existing label name (the checks create it through POST /labels) and one that never exists. */
  label: string;
  badLabel: string;
  /** Seeded repository descriptions, before and after the PATCH check. */
  description: string;
  descriptionAlt: string;
}

/** Derive the strings the checks send from wire.ts's scenario; pure and deterministic. */
export function restScenarioOf(scenario: Scenario): RestScenario {
  const first = scenario.repos[0];
  const blobA = scenario.blobs[0];
  const blobB = scenario.blobs[1] ?? scenario.blobs[0];
  const issue = scenario.issues[0];
  const issueAlt = scenario.issues[1] ?? scenario.issues[0];
  const pull = scenario.pulls[0];
  if (first === undefined || blobA === undefined || blobB === undefined || issue === undefined || issueAlt === undefined || pull === undefined) {
    throw new Error('wire.ts buildScenario() returned an empty repos, blobs, issues or pulls list');
  }
  const dirBlob = scenario.blobs.find((blob) => blob.path.includes('/'));
  const dirPath = dirBlob === undefined ? 'src' : dirBlob.path.slice(0, dirBlob.path.lastIndexOf('/'));
  const branchName = scenario.branches.find((name) => name !== first.defaultBranch && !name.endsWith('/')) ?? 'feature';
  const label = scenario.labels[0] ?? 'bug';
  return {
    owner: scenario.viewer.login,
    otherOwner: scenario.stranger.login,
    repoPrefix: first.name,
    paginationRepos: scenario.repos.map((repo) => repo.name),
    filePath: blobA.path,
    dirPath,
    fileContent: blobA.content,
    fileContentAlt: blobB.content,
    commitMessage: scenario.commits[0]?.message ?? 'seeded commit',
    branchName,
    issueTitle: issue.title,
    issueBody: issue.body,
    commentBody: issueAlt.body,
    pullTitle: pull.title,
    pullBody: pull.body,
    label,
    badLabel: `${label}-not-a-label`,
    description: first.description,
    descriptionAlt: `${first.description} (updated)`,
  };
}

/** One check's body: it runs against the clients the runner builds from the manifest CheckContext. */
interface RestDefinition {
  slug: string;
  group: RestGroup;
  title: string;
  run: (set: ClientSet) => Promise<void>;
}

/**
 * The `repos`, `issues` and `pulls` checks: 15 + 15 + 20, one point each in the manifest's
 * group maxima. `repos.pagination` runs first: it creates the 30 seeded repositories and walks
 * the viewer's whole list, so the fewer repositories other checks have made by then the tighter
 * the count (the check itself needs only that all 30 are reachable through the Link chain).
 */
export function restChecks(): CheckSpec[] {
  return [
    check('repos', 'pagination', 'GET /user/repos pages 30 seeded repos at per_page=10 through Link rel="next"', reposPagination),
    check('repos', 'root', 'GET /api/v3/ answers 200 JSON with X-OAuth-Scopes', reposRoot),
    check('repos', 'meta', 'GET /api/v3/meta reports installed_version', reposMeta),
    check('repos', 'create', 'POST /user/repos creates and GET round-trips name, private and default_branch', reposCreate),
    check('repos', 'not-found', 'GET a missing repository is a JSON 404', reposNotFound),
    check('repos', 'patch', 'PATCH /repos/{o}/{r} updates the description', reposPatch),
    check('repos', 'delete', 'DELETE /repos/{o}/{r} deletes it and a later GET is 404', reposDelete),
    check('repos', 'branches', 'GET /branches lists a branch created through POST /git/refs', reposBranches),
    check('repos', 'commits', 'GET /commits reflects a commit made on a branch and not the default branch', reposCommits),
    check('repos', 'unauthorized', 'a request without a token is 401', reposUnauthorized),
    check('repos', 'foreign-token', 'the same repository name under another owner is a 404 for this token', reposForeignToken),
    check('repos', 'contents-create', 'PUT /contents creates a file with a commit; GET returns base64 content and sha', reposContentsCreate),
    check('repos', 'contents-directory', 'GET /contents on a directory lists its entries', reposContentsDirectory),
    check('repos', 'contents-stale-sha', 'PUT /contents with a stale sha is 409', reposContentsStaleSha),
    check('repos', 'contents-delete', 'DELETE /contents removes the file with a commit and GET is 404', reposContentsDelete),

    check('issues', 'create', 'POST /issues creates a 201 open issue with a number', issuesCreate),
    check('issues', 'create-title-body', 'POST /issues echoes the title and body', issuesCreateTitleBody),
    check('issues', 'create-labels', 'POST /issues attaches an existing label', issuesCreateLabels),
    check('issues', 'numbers-increment', 'issue numbers increment by one', issuesNumbersIncrement),
    check('issues', 'list-open', 'GET /issues?state=open lists the open issue', issuesListOpen),
    check('issues', 'list-open-excludes-closed', 'GET /issues?state=open omits a closed issue', issuesListOpenExcludesClosed),
    check('issues', 'list-sort-asc', 'GET /issues?sort=created&direction=asc orders by creation', issuesListSortAsc),
    check('issues', 'list-sort-desc', 'GET /issues?sort=created&direction=desc reverses it', issuesListSortDesc),
    check('issues', 'list-shape', 'GET /issues returns the GitHub issue shape', issuesListShape),
    check('issues', 'get-one', 'GET /issues/{n} returns the issue', issuesGetOne),
    check('issues', 'patch-close', 'PATCH /issues/{n} closes it', issuesPatchClose),
    check('issues', 'patch-close-persists', 'the close survives a later GET', issuesPatchClosePersists),
    check('issues', 'comment-create', 'POST /issues/{n}/comments creates a comment', issuesCommentCreate),
    check('issues', 'comments-list', 'GET /issues/{n}/comments lists the comment', issuesCommentsList),
    check('issues', 'bad-label', 'POST /issues with an unknown label is 422', issuesBadLabel),

    check('pulls', 'create', 'POST /pulls creates an open pull request from a head branch', pullsCreate),
    check('pulls', 'create-body', 'POST /pulls echoes the title and body', pullsCreateBody),
    check('pulls', 'create-head-sha', 'the pull head.sha is the head branch tip', pullsCreateHeadSha),
    check('pulls', 'create-base-sha', 'the pull base.sha is the base branch tip', pullsCreateBaseSha),
    check('pulls', 'get-one', 'GET /pulls/{n} returns the pull request', pullsGetOne),
    check('pulls', 'files-list', 'GET /pulls/{n}/files lists the changed path', pullsFilesList),
    check('pulls', 'files-shape', 'pull files carry filename, status and the change counts', pullsFilesShape),
    check('pulls', 'files-multiple', 'GET /pulls/{n}/files lists every changed path', pullsFilesMultiple),
    check('pulls', 'merge-status', 'PUT /pulls/{n}/merge with merge_method=squash is 200', pullsMergeStatus),
    check('pulls', 'merge-body', 'the merge reply is {merged:true, sha, message}', pullsMergeBody),
    check('pulls', 'merge-closes', 'the merged pull is closed, merged and carries merged_at', pullsMergeCloses),
    check('pulls', 'merge-commit-on-default', 'the merge commit appears on the default branch', pullsMergeCommitOnDefault),
    check('pulls', 'merge-content-on-default', 'the squash content is on the default branch', pullsMergeContentOnDefault),
    check('pulls', 'merge-commit-sha', 'the pull reports merge_commit_sha equal to the merge sha', pullsMergeCommitSha),
    check('pulls', 'merge-unknown', 'merging an unknown pull request is 404', pullsMergeUnknown),
    check('pulls', 'merge-conflict', 'merging a conflicted pull request is 405', pullsMergeConflict),
    check('pulls', 'list-state-all', 'GET /pulls?state=all lists open and merged pull requests', pullsListStateAll),
    check('pulls', 'list-default-open', 'GET /pulls defaults to open pull requests', pullsListDefaultOpen),
    check('pulls', 'list-shape', 'GET /pulls returns the GitHub pull-request shape', pullsListShape),
    check('pulls', 'get-unknown', 'GET an unknown pull request is 404', pullsGetUnknown),
  ].map(spec);
}

/**
 * The REST share of the `protocol` group (5 of the manifest's 10): JSON content types, a JSON
 * 404 for unknown routes, a 400 for a malformed body, the request-id header, and the
 * `{message}` error shape. The rate-limit headers are deliberately not required.
 */
export function restProtocolChecks(): CheckSpec[] {
  return [
    check('protocol', 'content-type-json', 'every REST reply is application/json, never HTML', protocolContentType),
    check('protocol', 'unknown-route-json-404', 'an unknown /api/v3 route is a JSON 404', protocolUnknownRoute),
    check('protocol', 'malformed-body-400', 'a malformed JSON body is a 400', protocolMalformedBody),
    check('protocol', 'request-id', 'every reply carries a non-empty X-GitHub-Request-Id', protocolRequestId),
    check('protocol', 'error-message', '401, 404 and 422 bodies carry a string message', protocolErrorMessage),
  ].map(spec);
}

/** Build one definition; ids are `<group>.<slug>` through the manifest's own checkId. */
function check(group: RestGroup, slug: string, title: string, run: (set: ClientSet) => Promise<void>): RestDefinition {
  return { slug, group, title, run };
}

/** A definition as the manifest CheckSpec the runner collects and validates. */
function spec(definition: RestDefinition): CheckSpec {
  return {
    id: checkId(definition.group, definition.slug),
    group: definition.group,
    title: definition.title,
    fn: (context: CheckContext) => runDefinition(context, definition),
  };
}

// ---------------------------------------------------------------------------------------------
// Plumbing

class CheckFailure extends Error {}

function fail(detail: string): never {
  throw new CheckFailure(detail);
}

/** Turn a helper's detail (null on success) into a failed check. */
function expect(detail: string | null): void {
  if (detail !== null) throw new CheckFailure(detail);
}

function clip(text: string, max = 600): string {
  return text.length <= max ? text : `${text.slice(0, max)}…`;
}

interface ClientSet {
  scenario: RestScenario;
  owner: string;
  otherOwner: string;
  baseUrl: string;
  client: RestClient;
  anon: RestClient;
}

function clientSet(context: CheckContext): ClientSet {
  const timeoutMs = Math.max(1_000, Math.min(context.timeoutMs, 5_000));
  const scenario = restScenarioOf(context.scenario);
  const shared = { baseUrl: context.baseUrl, timeoutMs, signal: context.signal };
  return {
    scenario,
    owner: scenario.owner,
    otherOwner: scenario.otherOwner,
    baseUrl: context.baseUrl,
    client: new RestClient({ ...shared, token: context.token }),
    anon: new RestClient({ ...shared, token: null }),
  };
}

/** Run one definition against a fresh client set; a throw is a failure, never a crash. */
async function runDefinition(context: CheckContext, definition: RestDefinition): Promise<{ ok: boolean; detail: string }> {
  try {
    await definition.run(clientSet(context));
    return { ok: true, detail: `${definition.title}: ok` };
  } catch (err) {
    if (err instanceof CheckFailure) return { ok: false, detail: clip(err.message) };
    const message = err instanceof Error ? `${err.name}: ${err.message}` : String(err);
    return { ok: false, detail: clip(`${definition.slug}: threw ${message}`) };
  }
}

const SHA40 = /^[0-9a-f]{40}$/i;
const shaShape = (): Shape => shapes.string({ nonEmpty: true, pattern: SHA40 });
const messageShape = (): Shape => shapes.object({ message: shapes.string({ nonEmpty: true }) });
const labelShape = (): Shape => shapes.object({ name: shapes.string({ nonEmpty: true }) });

function slug(id: string): string {
  return id.toLowerCase().replace(/[^a-z0-9._-]+/g, '-').replace(/^-+|-+$/g, '');
}

/** A repository name for one check, from the seeded prefix; never longer than GitHub's limit. */
function repoName(set: ClientSet, id: string): string {
  const name = `${set.scenario.repoPrefix}-${slug(id)}`;
  return name.length <= 100 ? name : name.slice(0, 100);
}

/** The 30 seeded viewer repository names the pagination check creates. */
function paginationNames(set: ClientSet): readonly string[] {
  return set.scenario.paginationRepos;
}

/** `docs/readme.md` + `alt` -> `docs/readme-alt.md`; a path with no extension -> `docs/readme-alt`. */
function variantPath(path: string, suffix: string): string {
  const slash = path.lastIndexOf('/');
  const dir = slash === -1 ? '' : path.slice(0, slash + 1);
  const base = slash === -1 ? path : path.slice(slash + 1);
  const dot = base.lastIndexOf('.');
  const stem = dot <= 0 ? base : base.slice(0, dot);
  const ext = dot <= 0 ? '' : base.slice(dot);
  return `${dir}${stem}-${suffix}${ext}`;
}

function lower(value: unknown): string {
  return typeof value === 'string' ? value.toLowerCase() : '';
}

function numberField(object: Json, field: string): number {
  const value = object[field];
  return typeof value === 'number' ? value : Number.NaN;
}

function stringField(object: Json, field: string): string {
  const value = object[field];
  return typeof value === 'string' ? value : '';
}

function objectBody(response: RestResponse, label: string): Json {
  const value = response.body;
  if (typeof value !== 'object' || value === null || Array.isArray(value)) fail(`${label}: expected a JSON object body`);
  return value as Json;
}

function arrayBody(response: RestResponse, label: string): Json[] {
  const value = response.body;
  if (!Array.isArray(value)) fail(`${label}: expected a JSON array body`);
  return value as Json[];
}

// ---------------------------------------------------------------------------------------------
// Repository and content fixtures

interface RepoRef {
  owner: string;
  name: string;
  /** `/api/v3/repos/<owner>/<name>` */
  path: string;
  /** The branch the entry reports, read back after the first commit. */
  defaultBranch: string;
  /** The tip of the default branch after the initial file commit. */
  initialCommitSha: string;
}

interface ContentCommit {
  commitSha: string;
  contentSha: string;
}

const contentCommitShape = (): Shape =>
  shapes.object({
    content: shapes.object({ sha: shaShape(), encoding: shapes.string({ oneOf: ['base64'] }) }),
    commit: shapes.object({ sha: shaShape() }),
  });

/** Create a repository and its first commit through PUT /contents (an unborn repository accepts it). */
async function prepareRepo(set: ClientSet, id: string, options: { private?: boolean; description?: string; filePath?: string; content?: string } = {}): Promise<RepoRef> {
  const name = repoName(set, id);
  const created = await set.client.post(apiPath('user', 'repos'), {
    body: { name, private: options.private ?? true, description: options.description ?? set.scenario.description },
  });
  expect(expectJsonResponse(created, 201, shapes.object({ name: shapes.string({ oneOf: [name] }), private: shapes.boolean() }), `POST /api/v3/user/repos (${name})`));
  const path = apiPath('repos', set.owner, name);
  const put = await putContent(set, { owner: set.owner, name }, { filePath: options.filePath ?? set.scenario.filePath, content: options.content ?? set.scenario.fileContent, message: set.scenario.commitMessage });
  const commit = contentCommit(put, `PUT ${path}/contents/${options.filePath ?? set.scenario.filePath}`);
  const got = await set.client.get(path);
  expect(expectJsonResponse(got, 200, shapes.object({ default_branch: shapes.string({ nonEmpty: true }) }), `GET ${path}`));
  const defaultBranch = stringField(objectBody(got, `GET ${path}`), 'default_branch');
  return { owner: set.owner, name, path, defaultBranch, initialCommitSha: commit.commitSha };
}

/** One contents PUT, unasserted; callers pick the expected status. */
async function putContent(
  set: ClientSet,
  repo: { owner: string; name: string },
  options: { filePath: string; content: string; message: string; branch?: string; sha?: string },
): Promise<RestResponse> {
  const body: Json = { message: options.message, content: b64encode(options.content) };
  if (options.branch !== undefined) body.branch = options.branch;
  if (options.sha !== undefined) body.sha = options.sha;
  return set.client.put(apiPath('repos', repo.owner, repo.name, 'contents', options.filePath), { body });
}

function contentCommit(response: RestResponse, label: string, expected: StatusExpectation = 201): ContentCommit {
  expect(expectJsonResponse(response, expected, contentCommitShape(), label));
  const body = objectBody(response, label);
  const content = body.content as Json;
  const commit = body.commit as Json;
  return { commitSha: stringField(commit, 'sha'), contentSha: stringField(content, 'sha') };
}

interface ContentEntry {
  sha: string;
  content: string;
  size: number;
}

/** GET one file's contents, asserting the file shape. */
async function getContent(set: ClientSet, repo: { owner: string; name: string; path: string }, filePath: string, ref?: string): Promise<ContentEntry> {
  const path = apiPath('repos', repo.owner, repo.name, 'contents', filePath);
  const response = await set.client.get(path, ref === undefined ? {} : { query: { ref } });
  const label = `GET ${path}${ref === undefined ? '' : `?ref=${ref}`}`;
  expect(
    expectJsonResponse(
      response,
      200,
      shapes.object({
        type: shapes.string({ oneOf: ['file'] }),
        encoding: shapes.string({ oneOf: ['base64'] }),
        content: shapes.string(),
        sha: shaShape(),
        size: shapes.number({ integer: true, min: 0 }),
      }),
      label,
    ),
  );
  const body = objectBody(response, label);
  return { sha: stringField(body, 'sha'), content: stringField(body, 'content'), size: numberField(body, 'size') };
}

/** POST /repos/{o}/{r}/git/refs: create a branch at `sha`. */
async function createBranch(set: ClientSet, repo: RepoRef, branch: string, sha: string): Promise<void> {
  const path = `${repo.path}/git/refs`;
  const response = await set.client.post(path, { body: { ref: `refs/heads/${branch}`, sha } });
  expect(
    expectJsonResponse(
      response,
      201,
      shapes.object({ ref: shapes.string({ oneOf: [`refs/heads/${branch}`] }), object: shapes.object({ sha: shaShape() }) }),
      `POST ${path} (${branch})`,
    ),
  );
}

/** Commit one file on a branch through PUT /contents with `branch`; `update` sends the blob sha. */
async function commitOnBranch(set: ClientSet, repo: RepoRef, options: { branch: string; filePath: string; content: string; message: string; update?: boolean }): Promise<ContentCommit> {
  const sha = options.update === true ? (await getContent(set, repo, options.filePath, options.branch)).sha : undefined;
  const response = await putContent(set, repo, { filePath: options.filePath, content: options.content, message: options.message, branch: options.branch, sha });
  return contentCommit(response, `PUT ${repo.path}/contents/${options.filePath}?branch=${options.branch}`, options.update === true ? [200, 201] : 201);
}

const pullShape = (): Shape =>
  shapes.object({
    number: shapes.number({ integer: true, min: 1 }),
    state: shapes.string({ oneOf: ['open', 'closed'] }),
    title: shapes.string(),
    body: shapes.string(),
    head: shapes.object({ ref: shapes.string({ nonEmpty: true }), sha: shaShape() }),
    base: shapes.object({ ref: shapes.string({ nonEmpty: true }), sha: shaShape() }),
  });

async function createPull(set: ClientSet, repo: RepoRef, input: { head: string; base: string; title: string; body: string }): Promise<Json> {
  const response = await set.client.post(`${repo.path}/pulls`, { body: input });
  const label = `POST ${repo.path}/pulls (head ${input.head})`;
  expect(expectJsonResponse(response, 201, pullShape(), label));
  return objectBody(response, label);
}

async function mergePull(set: ClientSet, repo: RepoRef, number: number): Promise<RestResponse> {
  return set.client.put(`${repo.path}/pulls/${number}/merge`, { body: { merge_method: 'squash' } });
}

interface PullFixture {
  repo: RepoRef;
  head: string;
  base: string;
  number: number;
  headCommitSha: string;
  changedPaths: string[];
}

/** A repository with a head branch one commit ahead of the default branch, and an open PR from it. */
async function preparePull(set: ClientSet, id: string, files?: readonly { path: string; content: string }[]): Promise<PullFixture> {
  const repo = await prepareRepo(set, id);
  const head = `${set.scenario.branchName}-${slug(id)}`;
  await createBranch(set, repo, head, repo.initialCommitSha);
  const changes = files ?? [{ path: variantPath(set.scenario.filePath, slug(id)), content: set.scenario.fileContentAlt }];
  let headCommitSha = repo.initialCommitSha;
  for (const change of changes) {
    const commit = await commitOnBranch(set, repo, { branch: head, filePath: change.path, content: change.content, message: `${set.scenario.commitMessage} (${slug(id)})` });
    headCommitSha = commit.commitSha;
  }
  const pull = await createPull(set, repo, { head, base: repo.defaultBranch, title: set.scenario.pullTitle, body: set.scenario.pullBody });
  return { repo, head, base: repo.defaultBranch, number: numberField(pull, 'number'), headCommitSha, changedPaths: changes.map((change) => change.path) };
}

/** The number of a pull request created for a second branch of the same repository. */
async function secondBranchPull(set: ClientSet, repo: RepoRef, id: string): Promise<number> {
  const head = `${set.scenario.branchName}-${slug(id)}-b`;
  await createBranch(set, repo, head, repo.initialCommitSha);
  await commitOnBranch(set, repo, { branch: head, filePath: variantPath(set.scenario.filePath, `${slug(id)}-b`), content: set.scenario.fileContentAlt, message: `${set.scenario.commitMessage} (${slug(id)}-b)` });
  const pull = await createPull(set, repo, { head, base: repo.defaultBranch, title: set.scenario.pullTitle, body: set.scenario.pullBody });
  return numberField(pull, 'number');
}

// ---------------------------------------------------------------------------------------------
// Issues and labels

const issueShape = (): Shape =>
  shapes.object({
    number: shapes.number({ integer: true, min: 1 }),
    title: shapes.string(),
    body: shapes.string(),
    state: shapes.string({ oneOf: ['open', 'closed'] }),
    labels: shapes.array(labelShape()),
  });

interface IssueFixture {
  repo: RepoRef;
  label: string;
}

async function prepareIssueRepo(set: ClientSet, id: string): Promise<IssueFixture> {
  const repo = await prepareRepo(set, id);
  const label = set.scenario.label;
  const response = await set.client.post(`${repo.path}/labels`, { body: { name: label, color: 'ededed' } });
  expect(expectJsonResponse(response, 201, labelShape(), `POST ${repo.path}/labels (${label})`));
  return { repo, label };
}

async function createIssue(set: ClientSet, repo: RepoRef, input: { title: string; body: string; labels?: readonly string[] }): Promise<Json> {
  const response = await set.client.post(`${repo.path}/issues`, { body: input });
  const label = `POST ${repo.path}/issues (${input.title})`;
  expect(expectJsonResponse(response, 201, issueShape(), label));
  return objectBody(response, label);
}

async function listIssues(set: ClientSet, repo: RepoRef, query: Readonly<Record<string, string | number>>): Promise<Json[]> {
  const response = await set.client.get(`${repo.path}/issues`, { query });
  const rendered = Object.entries(query).map(([key, value]) => `${key}=${value}`).join('&');
  const label = `GET ${repo.path}/issues${rendered === '' ? '' : `?${rendered}`}`;
  expect(expectJsonResponse(response, 200, shapes.array(issueShape()), label));
  return arrayBody(response, label);
}

async function setIssueState(set: ClientSet, repo: RepoRef, number: number, state: 'open' | 'closed'): Promise<Json> {
  const response = await set.client.patch(`${repo.path}/issues/${number}`, { body: { state } });
  const label = `PATCH ${repo.path}/issues/${number} {state:${state}}`;
  expect(expectJsonResponse(response, 200, shapes.object({ number: shapes.number({ integer: true, min: 1 }), state: shapes.string({ oneOf: [state] }) }), label));
  return objectBody(response, label);
}

function issueNumber(issue: Json): number {
  return numberField(issue, 'number');
}

function positionOf(list: readonly Json[], number: number): number {
  return list.findIndex((item) => issueNumber(item) === number);
}

