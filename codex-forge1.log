// ---------------------------------------------------------------------------------------------
// protocol (5)

async function protocolContentType(set: ClientSet): Promise<void> {
  const repo = await prepareRepo(set, 'protocol-content-type');
  const calls: readonly { label: string; run: () => Promise<RestResponse> }[] = [
    { label: 'GET /api/v3/', run: () => set.client.get(`${apiPath()}/`) },
    { label: 'GET /api/v3/meta', run: () => set.client.get(apiPath('meta')) },
    { label: `GET ${repo.path}`, run: () => set.client.get(repo.path) },
    { label: `GET ${repo.path}/issues`, run: () => set.client.get(`${repo.path}/issues`) },
    { label: 'GET an unknown route', run: () => set.client.get(apiPath('no-such-route-content-type')) },
    { label: `GET ${repo.path} without a token`, run: () => set.anon.get(repo.path) },
  ];
  for (const call of calls) {
    const response = await call.run();
    if (response.status === 0) fail(`${call.label}: ${describeResponse(response)}`);
    if (!isJsonContentType(response.contentType)) fail(`${call.label}: content-type is ${response.contentType ?? 'none'}, expected application/json`);
    expect(expectNoHtml(response, call.label));
  }
}

async function protocolUnknownRoute(set: ClientSet): Promise<void> {
  const path = apiPath('no-such-route', set.scenario.repoPrefix);
  const response = await set.client.get(path);
  expect(expectJsonResponse(response, 404, messageShape(), `GET ${path}`));
  expect(expectNoHtml(response, `GET ${path}`));
}

async function protocolMalformedBody(set: ClientSet): Promise<void> {
  const path = apiPath('user', 'repos');
  const response = await set.client.post(path, { rawBody: '{"name":', headers: { 'content-type': 'application/json' } });
  expect(expectJsonResponse(response, 400, messageShape(), `POST ${path} with the body {"name":`));
}

async function protocolRequestId(set: ClientSet): Promise<void> {
  const repo = await prepareRepo(set, 'protocol-request-id');
  const calls: readonly { label: string; run: () => Promise<RestResponse> }[] = [
    { label: 'GET /api/v3/', run: () => set.client.get(`${apiPath()}/`) },
    { label: `GET ${repo.path}`, run: () => set.client.get(repo.path) },
    { label: 'GET an unknown route', run: () => set.client.get(apiPath('no-such-route-request-id')) },
    { label: `GET ${repo.path} without a token`, run: () => set.anon.get(repo.path) },
  ];
  for (const call of calls) {
    const response = await call.run();
    if (response.status === 0) fail(`${call.label}: ${describeResponse(response)}`);
    expect(expectHeader(response, 'x-github-request-id', call.label, { nonEmpty: true }));
  }
}

async function protocolErrorMessage(set: ClientSet): Promise<void> {
  const missing = await set.client.get(apiPath('repos', set.owner, `${set.scenario.repoPrefix}-never-created`));
  expect(expectJsonResponse(missing, 404, messageShape(), 'GET a missing repository'));

  const repo = await prepareRepo(set, 'protocol-error-message', { private: true });
  const unauthorized = await set.anon.get(repo.path);
  expect(expectJsonResponse(unauthorized, 401, messageShape(), `GET ${repo.path} without a token`));

  const { repo: issueRepo } = await prepareIssueRepo(set, 'protocol-error-message-issues');
  const unprocessable = await set.client.post(`${issueRepo.path}/issues`, { body: { title: set.scenario.issueTitle, body: set.scenario.issueBody, labels: [set.scenario.badLabel] } });
  expect(expectJsonResponse(unprocessable, 422, messageShape(), `POST ${issueRepo.path}/issues with an unknown label`));
}
// The `graphql` group: the 20 conformance checks of manifest.ts's GraphQL v4 group. Each sends a document
// gh or github-mcp-server actually sends — gh's `api` package and its githubv4 client (viewer, repository
// fields, the feature-detection `__type` probes, issue and pull-request reads, the create/close/merge
// mutations) and the same githubv4 shapes in github-mcp-server — to POST /api/graphql on the entry's base
// URL with the trial's bearer token and a JSON {query, variables} body.
//
// The group's rules:
//   - the entry serves its data on a fresh, empty forge; the checks seed their own fixtures through the
//     entry's own surfaces: a repository and its branches (REST create plus a git push), issues (REST),
//     pull requests (REST). Every name, path, branch and body is a function of wire.ts's one seeded
//     Scenario (the viewer's first repository, three of its generated branches, two of its blobs, its
//     issue templates), with a fixed suffix on the repository name so no other group's fixtures collide;
//   - a check that needs a fixture builds it on first use and reuses it across the group's checks; a
//     fixture that cannot be built is that check's failure detail, never a crash (the wrapper turns any
//     throw into a failed verdict);
//   - a 200 carrying an `errors` array is a GraphQL-level failure unless the check expects it (only the
//     invalid-field check does);
//   - nothing here times anything: no pass/fail bit reads a clock;
//   - the pull-request checks need a branch with a commit. The env main (#14) installs a git adapter once
//     with configureGraphQLGit(), over the env's git client (#9); without it those four checks fail with a
//     clear detail and the other sixteen still run.
//
// The schema surface the reference forge must implement for this group (the reference-forge item reads
// this list):
//   Query.viewer{login}
//   Query.repository(owner: String!, name: String!) -> Repository, nullable
//   Repository{id, databaseId, name, nameWithOwner, owner{login}, defaultBranchRef{name},
//              viewerPermission, hasIssuesEnabled, issue(number: Int!),
//              issues(first: Int, states: [IssueState!], orderBy: {field: IssueOrderField!,
//              direction: OrderDirection!}, after: String), pullRequests(first: Int),
//              pullRequest(number: Int!)}
//   Issue{id, number, title, state, body}
//   IssueConnection{nodes, pageInfo{hasNextPage, endCursor}}
//   PullRequest{id, number, state, merged, headRefName, baseRefName, mergeable, files(first: Int)}
//   PullRequestConnection{nodes}
//   PullRequestChangedFile{path}
//   User{login}
//   Query.node(id: ID!) -> Node, with `... on Repository { name nameWithOwner }`
//   Query.__type(name: String!) -> __Type, with fields(includeDeprecated: Boolean) and
//              enumValues(includeDeprecated: Boolean), and the aliases gh uses (`Issue: __type(...)`)
//   Mutation.createIssue(input: CreateIssueInput{repositoryId, title, body}) -> {issue{number, id}}
//   Mutation.closeIssue(input: CloseIssueInput{issueId}) -> {issue{number, id, state}}
//   Mutation.createPullRequest(input: CreatePullRequestInput{repositoryId, baseRefName, headRefName, title})
//              -> {pullRequest{number, id, state, headRefName, baseRefName}}
//   Mutation.mergePullRequest(input: MergePullRequestInput{pullRequestId, mergeMethod}) ->
//              {pullRequest{number, merged, state}}, mergeMethod SQUASH accepted
//   Mutation.addComment(input: AddCommentInput{subjectId, body}) -> {commentEdge{node{id, body}}}
//   Arguments: string/int variables, inline enum lists (`states: [OPEN]`), inline input objects
//              (`orderBy: {field: CREATED_AT, direction: DESC}`), null variables (`after: null`),
//              operation names, and a JSON array of operation documents in one request (batching).
//   Enums: IssueState OPEN/CLOSED, MergeableState MERGEABLE/CONFLICTING/UNKNOWN, PullRequestState
//              OPEN/CLOSED/MERGED, PullRequestMergeMethod MERGE/SQUASH/REBASE, RepositoryPermission
//              ADMIN/MAINTAIN/WRITE/TRIAGE/READ, SearchType ISSUE/... (enumValues), IssueOrderField
//              CREATED_AT/UPDATED_AT/COMMENTS, OrderDirection ASC/DESC.
// The reference also implements the REST reads the checks use as their cross-surface view (item #16's
// routes): POST /user/repos, GET /repos/{o}/{r}, POST/GET/PATCH /repos/{o}/{r}/issues[/{n}],
// GET /repos/{o}/{r}/issues/{n}/comments, POST/GET /repos/{o}/{r}/pulls[/{n}].
//
// The 20 checks are exactly the manifest's count for this group (manifest.ts CHECK_GROUPS). gh's three
// remaining feature probes (PullRequest, Repository, SearchType) share one check
// (`graphql.introspection-types`) so the group stays at 20; every other check below is one check.

import { checkId, fail, pass, type CheckContext, type CheckResult, type CheckSpec } from './manifest.ts';
import { CHECK_TIMEOUT_MAX_MS, type Scenario } from './wire.ts';
import { GraphQLClient, type GraphQLResponse } from './graphql-client.ts';

/** The manifest's group name. */
export const GRAPHQL_GROUP = 'graphql' as const;

/**
 * One commit pushed to the fixture repository by the env's git client (#9). The env main installs this
 * adapter with configureGraphQLGit() so the pull-request checks can create the branches a pull request needs
 * without importing the git client here.
 */
export interface GraphQLGitPush {
  owner: string;
  repo: string;
  branch: string;
  /** The branch the commit builds on; unset for the repository's first (root) commit. */
  from?: string;
  path: string;
  content: string;
  message: string;
}

/** The branch fixture the env main installs. */
export interface GraphQLGitFixture {
  /** Push one commit and resolve null on success, or a human-readable failure detail. */
  pushBranch(request: GraphQLGitPush): Promise<string | null>;
}

let gitAdapter: GraphQLGitFixture | null = null;

/**
 * Install the git adapter the pull-request checks use to create their head branches. The env main calls
 * this once before the conformance phase, over the env's git client (#9); passing null removes it.
 */
export function configureGraphQLGit(git: GraphQLGitFixture | null): void {
  gitAdapter = git;
}

// ---------------------------------------------------------------------------------------------------------
// The documents. Each is sent as `query` with its variables; nothing here builds GraphQL text at run time.
// ---------------------------------------------------------------------------------------------------------

/** query ViewerLogin — gh's `api.CurrentLoginName` (api_queries_repo.go: viewer { login }). */
const VIEWER_LOGIN = `query ViewerLogin {
  viewer {
    login
  }
}`;

/** query RepositoryFields — gh's repository lookup (api_queries_repo.go's repository(owner: $owner, name: $name)). */
const REPOSITORY_FIELDS = `query RepositoryFields($owner: String!, $name: String!) {
  repository(owner: $owner, name: $name) {
    id
    databaseId
    name
    owner {
      login
    }
    defaultBranchRef {
      name
    }
    viewerPermission
    hasIssuesEnabled
  }
}`;

/** query Issue_fields — gh's featuredetection.IssueFeatures probe (internal/featuredetection/fd.go). */
const ISSUE_FIELDS = `query Issue_fields {
  Issue: __type(name: "Issue") {
    fields(includeDeprecated: true) {
      name
    }
  }
}`;

/** query PullRequestAndRepositoryFields — gh's two probes in one document (fd.go keeps to two __type expressions). */
const TYPE_FIELDS = `query PullRequestAndRepositoryFields {
  PullRequest: __type(name: "PullRequest") {
    fields(includeDeprecated: true) {
      name
    }
  }
  Repository: __type(name: "Repository") {
    fields(includeDeprecated: true) {
      name
    }
  }
}`;

/** query SearchType_enumValues — gh's SearchFeatures probe (fd.go). */
const SEARCH_TYPE_ENUM_VALUES = `query SearchType_enumValues {
  SearchType: __type(name: "SearchType") {
    enumValues(includeDeprecated: true) {
      name
    }
  }
}`;

/** query OpenIssues — gh's issue list (pkg/cmd/issue/list, states + orderBy on repository.issues). */
const OPEN_ISSUES = `query OpenIssues($owner: String!, $name: String!, $first: Int!) {
  repository(owner: $owner, name: $name) {
    issues(first: $first, states: [OPEN], orderBy: {field: CREATED_AT, direction: DESC}) {
      nodes {
        number
        title
        state
        id
      }
    }
  }
}`;

/** query IssueByNumber — gh's issue view (api_queries_issue.go's repository.issue(number: $number)). */
const ISSUE_BY_NUMBER = `query IssueByNumber($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number
      title
      state
      id
      body
    }
  }
}`;

/** mutation IssueCreate — gh's `gh issue create` (api_queries_issue.go IssueCreate). */
const CREATE_ISSUE = `mutation IssueCreate($input: CreateIssueInput!) {
  createIssue(input: $input) {
    issue {
      number
      id
    }
  }
}`;

/** mutation IssueClose — gh's `gh issue close` (pkg/cmd/issue/close/close.go apiClose). */
const CLOSE_ISSUE = `mutation IssueClose($input: CloseIssueInput!) {
  closeIssue(input: $input) {
    issue {
      number
      id
      state
    }
  }
}`;

/** query PullRequests — gh's `gh pr list` (api_queries_pr.go's repository.pullRequests(first:)). */
const PULL_REQUESTS = `query PullRequests($owner: String!, $name: String!, $first: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequests(first: $first) {
      nodes {
        number
        headRefName
        baseRefName
        mergeable
        state
      }
    }
  }
}`;

/** query PullRequestFiles — gh's PR files read (api_queries_pr.go's pullRequest(number:).files(first:)). */
const PULL_REQUEST_FILES = `query PullRequestFiles($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      number
      files(first: 10) {
        nodes {
          path
        }
      }
    }
  }
}`;

/** query PullRequestId — the minimal read a mutation input needs (the pull request's global id). */
const PULL_REQUEST_ID = `query PullRequestId($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      id
      number
    }
  }
}`;

/** mutation PullRequestCreate — gh's `gh pr create` (api_queries_pr.go CreatePullRequest). */
const CREATE_PULL_REQUEST = `mutation PullRequestCreate($input: CreatePullRequestInput!) {
  createPullRequest(input: $input) {
    pullRequest {
      number
      id
      state
      headRefName
      baseRefName
    }
  }
}`;

/** mutation MergePullRequest — gh's `gh pr merge` (pkg/cmd/pr/merge/http.go mergePullRequest(input:)). */
const MERGE_PULL_REQUEST = `mutation MergePullRequest($input: MergePullRequestInput!) {
  mergePullRequest(input: $input) {
    pullRequest {
      number
      merged
      state
    }
  }
}`;

/** mutation AddComment — GitHub's AddCommentInput, the shape gh's comment paths build. */
const ADD_COMMENT = `mutation AddComment($input: AddCommentInput!) {
  addComment(input: $input) {
    commentEdge {
      node {
        id
        body
      }
    }
  }
}`;

/** query ViewerInvalidField — a document with one field the schema does not hold. */
const INVALID_FIELD = `query ViewerInvalidField {
  viewer {
    login
    noSuchFieldOnViewer
  }
}`;

/** query NodeRepository — gh's Relay `node(id:)` read (api_queries_pr.go SuggestedAssignableActors). */
const NODE_REPOSITORY = `query NodeRepository($id: ID!) {
  node(id: $id) {
    id
    ... on Repository {
      name
      nameWithOwner
    }
  }
}`;

/** query IssuesPage — the cursor form of gh's issue list (first/after). */
const ISSUES_PAGE = `query IssuesPage($owner: String!, $name: String!, $first: Int!, $after: String) {
  repository(owner: $owner, name: $name) {
    issues(first: $first, after: $after) {
      nodes {
        number
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}`;

/** Every document the group sends, for the report and the reference forge's executor. */
export const GRAPHQL_DOCUMENTS = Object.freeze({
  viewerLogin: VIEWER_LOGIN,
  repositoryFields: REPOSITORY_FIELDS,
  issueFields: ISSUE_FIELDS,
  typeFields: TYPE_FIELDS,
  searchTypeEnumValues: SEARCH_TYPE_ENUM_VALUES,
  openIssues: OPEN_ISSUES,
  issueByNumber: ISSUE_BY_NUMBER,
  createIssue: CREATE_ISSUE,
  closeIssue: CLOSE_ISSUE,
  pullRequests: PULL_REQUESTS,
  pullRequestFiles: PULL_REQUEST_FILES,
  pullRequestId: PULL_REQUEST_ID,
  createPullRequest: CREATE_PULL_REQUEST,
  mergePullRequest: MERGE_PULL_REQUEST,
  addComment: ADD_COMMENT,
  invalidField: INVALID_FIELD,
  nodeRepository: NODE_REPOSITORY,
  issuesPage: ISSUES_PAGE,
});

// ---------------------------------------------------------------------------------------------------------
// Small readers and assertions.
// ---------------------------------------------------------------------------------------------------------

class CheckFailure extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'CheckFailure';
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

/** `at(body, 'repository', 'issue', 'number')`: a nested JSON read that answers undefined on any miss. */
function at(value: unknown, ...keys: readonly string[]): unknown {
  let current = value;
  for (const key of keys) {
    if (!isRecord(current)) return undefined;
    current = current[key];
  }
  return current;
}

function json(value: unknown): string {
  try {
    const text = JSON.stringify(value);
    return text === undefined ? String(value) : text;
  } catch {
    return String(value);
  }
}

/** Every `name` in a `fields`/`enumValues` list, keeping only non-empty strings. */
function namesFrom(value: unknown): string[] {
  if (!Array.isArray(value)) return [];
  const names: string[] = [];
  for (const entry of value) {
    const name = at(entry, 'name');
    if (typeof name === 'string' && name !== '') names.push(name);
  }
  return names;
}

function arrayFrom(value: unknown): unknown[] {
  return Array.isArray(value) ? value : [];
}

function positiveInteger(value: unknown, what: string): number {
  if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
    throw new CheckFailure(`${what} is ${json(value)}, expected a positive integer`);
  }
  return value;
}

function nonEmptyString(value: unknown, what: string): string {
  if (typeof value !== 'string' || value === '') {
    throw new CheckFailure(`${what} is ${json(value)}, expected a non-empty string`);
  }
  return value;
}

function statusText(answer: { status: number; transportError?: string; parseError?: string }): string {
  if (answer.transportError !== undefined) return `transport error: ${answer.transportError}`;
  if (answer.parseError !== undefined) return `unparseable response: ${answer.parseError}`;
  return `HTTP ${answer.status}`;
}

/** The `data` object of a GraphQL response, or a CheckFailure naming what the wire did instead. */
function dataOf<T>(response: GraphQLResponse<T>, what: string): T {
  if (response.transportError !== undefined) throw new CheckFailure(`${what}: ${response.transportError}`);
  if (response.parseError !== undefined) throw new CheckFailure(`${what}: ${response.parseError}`);
  if (response.status !== 200) throw new CheckFailure(`${what}: HTTP ${response.status}`);
  if (response.errors.length > 0) {
    throw new CheckFailure(`${what}: GraphQL errors: ${response.errors.map((error) => error.message).join('; ')}`);
  }
  if (response.data === null || typeof response.data !== 'object') {
    throw new CheckFailure(`${what}: the response carries no data object`);
  }
  return response.data;
}

interface RestAnswer {
  status: number;
  body: unknown;
  text: string;
  transportError?: string;
  parseError?: string;
}

/** A per-call budget: the check's remaining timeout for this request. */
interface CallOptions {
  signal: AbortSignal;
  timeoutMs: number;
}

/** The REST v3 view, used as the cross-surface verifier and the fixture creator (prefix /api/v3). */
class RestSurface {
  private readonly root: string;
  private readonly token: string;
  private readonly fetchImpl: (input: string, init: RequestInit) => Promise<Response>;

  constructor(baseUrl: string, token: string, fetchImpl: (input: string, init: RequestInit) => Promise<Response>) {
    this.root = `${baseUrl.replace(/\/+$/u, '')}/api/v3`;
    this.token = token;
    this.fetchImpl = fetchImpl;
  }

  get(path: string, options: CallOptions): Promise<RestAnswer> {
    return this.request('GET', path, undefined, options);
  }

  post(path: string, body: unknown, options: CallOptions): Promise<RestAnswer> {
    return this.request('POST', path, body, options);
  }

  patch(path: string, body: unknown, options: CallOptions): Promise<RestAnswer> {
    return this.request('PATCH', path, body, options);
  }

  async request(method: string, path: string, body: unknown, options: CallOptions): Promise<RestAnswer> {
    const headers: Record<string, string> = {
      accept: 'application/vnd.github+json',
      'user-agent': 'makefun-github-core-clone-env/1',
      authorization: `Bearer ${this.token}`,
    };
    if (body !== undefined) headers['content-type'] = 'application/json';
    let response: Response;
    try {
      response = await this.fetchImpl(`${this.root}${path}`, {
        method,
        headers,
        body: body === undefined ? undefined : JSON.stringify(body),
        signal: options.signal,
      });
    } catch (err) {
      return { status: 0, body: null, text: '', transportError: err instanceof Error ? `${err.name}: ${err.message}` : String(err) };
    }
    let text: string;
    try {
      text = await response.text();
    } catch (err) {
      return { status: response.status, body: null, text: '', transportError: `could not read the response body: ${err instanceof Error ? err.message : String(err)}` };
    }
    if (text.trim() === '') return { status: response.status, body: null, text };
    try {
      return { status: response.status, body: JSON.parse(text) as unknown, text };
    } catch {
      const contentType = response.headers.get('content-type') ?? 'no content-type';
      return { status: response.status, body: null, text, parseError: `response is not JSON (${contentType})` };
    }
  }
}

/** A REST response's JSON object, checked for a status and a body. */
function restObject(answer: RestAnswer, expected: number | readonly number[], what: string): Record<string, unknown> {
  const expectedList = typeof expected === 'number' ? [expected] : expected;
  if (answer.transportError !== undefined) throw new CheckFailure(`${what}: ${answer.transportError}`);
  if (answer.parseError !== undefined) throw new CheckFailure(`${what}: ${answer.parseError}`);
  if (!expectedList.includes(answer.status)) {
    throw new CheckFailure(`${what}: ${statusText(answer)}, expected ${expectedList.join(' or ')}`);
  }
  if (!isRecord(answer.body)) throw new CheckFailure(`${what}: the body is not a JSON object`);
  return answer.body;
}

/** A REST response's JSON array, checked for a status. */
function restArray(answer: RestAnswer, expected: number | readonly number[], what: string): unknown[] {
  const expectedList = typeof expected === 'number' ? [expected] : expected;
  if (answer.transportError !== undefined) throw new CheckFailure(`${what}: ${answer.transportError}`);
  if (answer.parseError !== undefined) throw new CheckFailure(`${what}: ${answer.parseError}`);
  if (!expectedList.includes(answer.status)) {
    throw new CheckFailure(`${what}: ${statusText(answer)}, expected ${expectedList.join(' or ')}`);
  }
  if (!Array.isArray(answer.body)) throw new CheckFailure(`${what}: the body is not a JSON array`);
  return answer.body;
}

// ---------------------------------------------------------------------------------------------------------
// The fixture: one repository, its branches, issues and pull requests, built lazily from the scenario.
// ---------------------------------------------------------------------------------------------------------

/** The names and bodies the fixture uses, all functions of wire.ts's seeded Scenario. */
interface FixtureNames {
  repository: string;
  pagesRepository: string;
  unknownRepository: string;
  baseBranch: string;
  headBranch: string;
  createBranch: string;
  mergeBranch: string;
  filePath: string;
  baseFilePath: string;
  titlePrefix: string;
  body: string;
  comment: string;
  pageSize: number;
  pageCount: number;
}

function fixtureNames(scenario: Scenario): FixtureNames {
  const repo = scenario.repos[0];
  const pulls = scenario.pulls;
  const blobs = scenario.blobs;
  const issues = scenario.issues;
  if (repo === undefined) throw new CheckFailure('the scenario has no viewer repository to build the GraphQL fixture on');
  if (pulls[0] === undefined || pulls[1] === undefined || pulls[2] === undefined) {
    throw new CheckFailure('the scenario has fewer than three pull-request branch pairs');
  }
  if (blobs[0] === undefined || blobs[1] === undefined) throw new CheckFailure('the scenario has fewer than two blobs');
  if (issues[0] === undefined || issues[1] === undefined) throw new CheckFailure('the scenario has fewer than two issue templates');
  const headBranches = [pulls[0].head, pulls[1].head, pulls[2].head];
  if (new Set(headBranches).size !== headBranches.length) throw new CheckFailure('the scenario reuses a pull-request head branch');
  return {
    repository: `${repo.name}-graphql`,
    pagesRepository: `${repo.name}-graphql-pages`,
    unknownRepository: `${repo.name}-graphql-missing`,
    baseBranch: repo.defaultBranch,
    headBranch: pulls[0].head,
    createBranch: pulls[1].head,
    mergeBranch: pulls[2].head,
    filePath: blobs[0].path,
    baseFilePath: blobs[1].path,
    titlePrefix: issues[0].title,
    body: issues[0].body,
    comment: issues[1].body,
    pageSize: 5,
    pageCount: 7,
  };
}

interface RepoFixture {
  /** The repository's global (Relay) id, from the GraphQL read. */
  id: string;
  /** The REST/GraphQL numeric database id. */
  databaseId: number;
}

interface IssueFixture {
  /** Three open issues, in creation order. */
  open: number[];
  /** One closed issue, created after the open three. */
  closed: number;
}

interface PullRequestFixture {
  number: number;
}

interface PageFixture {
  /** The pagination repository's issue numbers, in creation order. */
  numbers: number[];
}

function repoPath(owner: string, repo: string): string {
  return `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}`;
}

/** One check's working set: its context and the run's shared harness. */
interface Session {
  readonly ctx: CheckContext;
  readonly harness: Harness;
}

/** One harness per entry base URL and scenario; fixtures are memoized so a check pays for what it needs once. */
class Harness {
  readonly client: GraphQLClient;
  readonly rest: RestSurface;
  readonly viewer: string;
  readonly names: FixtureNames;
  private readonly repoSeed: { private: boolean; description: string };
  private repo: Promise<RepoFixture> | null = null;
  private baseBranch: Promise<void> | null = null;
  private branches: Promise<void> | null = null;
  private issues: Promise<IssueFixture> | null = null;
  private pullRequest: Promise<PullRequestFixture> | null = null;
  private mergePullRequest: Promise<PullRequestFixture> | null = null;
  private pages: Promise<PageFixture> | null = null;

  constructor(context: CheckContext) {
    const fetchImpl = (input: string, init: RequestInit) => fetch(input, init);
    this.client = new GraphQLClient({ baseUrl: context.baseUrl, token: context.token, timeoutMs: CHECK_TIMEOUT_MAX_MS, fetchImpl });
    this.rest = new RestSurface(context.baseUrl, context.token, fetchImpl);
    this.viewer = context.scenario.viewer.login;
    this.names = fixtureNames(context.scenario);
    const seedRepo = context.scenario.repos[0];
    this.repoSeed = { private: seedRepo?.private ?? false, description: seedRepo?.description ?? 'graphql checks' };
  }

  /** Whether a git adapter was installed (check 2 asserts defaultBranchRef only when branches exist). */
  get branchesAvailable(): boolean {
    return gitAdapter !== null;
  }

  /** One GraphQL call, bounded by the check's own budget. */
  query<T>(options: CallOptions, document: string, variables: Readonly<Record<string, unknown>> = {}): Promise<GraphQLResponse<T>> {
    return this.client.request<T>(document, variables, { signal: options.signal, timeoutMs: options.timeoutMs });
  }

  private callOptions(session: Session): CallOptions {
    return { signal: session.ctx.signal, timeoutMs: session.ctx.timeoutMs };
  }

  repoFixture(session: Session): Promise<RepoFixture> {
    this.repo ??= this.buildRepo(session);
    return this.repo;
  }

  /** The repository's first commit on the default branch (the defaultBranchRef the repository check reads). */
  baseBranchFixture(session: Session): Promise<void> {
    this.baseBranch ??= this.buildBaseBranch(session);
    return this.baseBranch;
  }

  branchFixture(session: Session): Promise<void> {
    this.branches ??= this.buildBranches(session);
    return this.branches;
  }

  issueFixture(session: Session): Promise<IssueFixture> {
    this.issues ??= this.buildIssues(session);
    return this.issues;
  }

  pullRequestFixture(session: Session): Promise<PullRequestFixture> {
    this.pullRequest ??= this.buildPullRequest(this.names.headBranch, `${this.names.titlePrefix} fixture pull request`, 'fixture', session);
    return this.pullRequest;
  }

  mergePullRequestFixture(session: Session): Promise<PullRequestFixture> {
    this.mergePullRequest ??= this.buildPullRequest(this.names.mergeBranch, `${this.names.titlePrefix} merge pull request`, 'fixture-merge', session);
    return this.mergePullRequest;
  }

  pageFixture(session: Session): Promise<PageFixture> {
    this.pages ??= this.buildPages(session);
    return this.pages;
  }

  /** Create the fixture repository (idempotent), then read its global and numeric ids over GraphQL. */
  private async buildRepo(session: Session): Promise<RepoFixture> {
    const name = this.names.repository;
    const created = await this.rest.post(
      '/user/repos',
      { name, private: this.repoSeed.private, description: this.repoSeed.description },
      this.callOptions(session),
    );
    if (created.status !== 201 && created.status !== 200 && created.status !== 422 && created.status !== 409) {
      throw new CheckFailure(`POST /api/v3/user/repos answered ${statusText(created)}`);
    }
    const read = await this.rest.get(repoPath(this.viewer, name), this.callOptions(session));
    if (read.status !== 200) {
      throw new CheckFailure(`the fixture repository ${this.viewer}/${name} was not readable after POST /user/repos: ${statusText(read)}`);
    }
    const response = await this.query(this.callOptions(session), REPOSITORY_FIELDS, { owner: this.viewer, name });
    const data = dataOf(response, `graphql lookup of the fixture repository ${this.viewer}/${name}`);
    const id = nonEmptyString(at(data, 'repository', 'id'), 'the fixture repository id');
    const databaseId = positiveInteger(at(data, 'repository', 'databaseId'), 'the fixture repository databaseId');
    return { id, databaseId };
  }

  /** The repository's first commit on its default branch, so defaultBranchRef names it. */
  private async buildBaseBranch(session: Session): Promise<void> {
    await this.repoFixture(session);
    const git = gitAdapter;
    if (git === null) {
      throw new CheckFailure('no git fixture provider was installed: the env main must call configureGraphQLGit() so the check can create the branch a pull request needs');
    }
    const detail = await git.pushBranch({
      owner: this.viewer,
      repo: this.names.repository,
      branch: this.names.baseBranch,
      path: this.names.baseFilePath,
      content: `# ${this.names.repository}\n\n${this.names.body}\n`,
      message: `fixture: first commit on ${this.names.baseBranch}`,
    });
    if (detail !== null) throw new CheckFailure(`git fixture for the default branch ${this.names.baseBranch}: ${detail}`);
  }

  /** Push the three head branches the pull-request checks need (the base branch is already there). */
  private async buildBranches(session: Session): Promise<void> {
    await this.baseBranchFixture(session);
    const git = gitAdapter;
    if (git === null) throw new CheckFailure('no git fixture provider was installed: the env main must call configureGraphQLGit()');
    const push = async (branch: string, from: string, path: string, content: string, message: string): Promise<void> => {
      const detail = await git.pushBranch({ owner: this.viewer, repo: this.names.repository, branch, from, path, content, message });
      if (detail !== null) throw new CheckFailure(`git fixture for branch ${branch}: ${detail}`);
    };
    await push(this.names.headBranch, this.names.baseBranch, this.names.filePath, `${this.names.body}\n`, `fixture: add ${this.names.filePath}`);
    await push(this.names.createBranch, this.names.baseBranch, `${this.names.filePath}.create`, `${this.names.body}\n`, 'fixture: branch for createPullRequest');
    await push(this.names.mergeBranch, this.names.baseBranch, `${this.names.filePath}.merge`, `${this.names.body}\n`, 'fixture: branch for mergePullRequest');
  }

  /** Create one issue over REST and answer its number. */
  private async createRestIssue(session: Session, title: string, body: string): Promise<number> {
    const answer = await this.rest.post(`${repoPath(this.viewer, this.names.repository)}/issues`, { title, body }, this.callOptions(session));
    const issue = restObject(answer, 201, `POST an issue "${title}"`);
    return positiveInteger(issue.number, 'the created issue number');
  }

  /** Three open issues and one closed issue, all from the scenario's seed-derived text. */
  private async buildIssues(session: Session): Promise<IssueFixture> {
    await this.repoFixture(session);
    const open: number[] = [];
    for (let index = 1; index <= 3; index += 1) {
      open.push(await this.createRestIssue(session, `${this.names.titlePrefix} open ${index}`, this.names.body));
    }
    const closed = await this.createRestIssue(session, `${this.names.titlePrefix} closed`, this.names.body);
    const patched = await this.rest.patch(`${repoPath(this.viewer, this.names.repository)}/issues/${closed}`, { state: 'closed' }, this.callOptions(session));
    restObject(patched, 200, `PATCH issue #${closed} closed`);
    return { open, closed };
  }

  /** An open pull request from `branch` to the base branch, created over REST; tolerant of a re-run. */
  private async buildPullRequest(branch: string, title: string, tag: string, session: Session): Promise<PullRequestFixture> {
    await this.branchFixture(session);
    const created = await this.rest.post(
      `${repoPath(this.viewer, this.names.repository)}/pulls`,
      { title, body: this.names.body, head: branch, base: this.names.baseBranch },
      this.callOptions(session),
    );
    if (created.status === 201) {
      const pullRequest = restObject(created, 201, `POST a pull request from ${branch}`);
      return { number: positiveInteger(pullRequest.number, `the ${tag} pull request number`) };
    }
    if (created.status === 422) {
      const listed = await this.rest.get(`${repoPath(this.viewer, this.names.repository)}/pulls?state=all`, this.callOptions(session));
      for (const entry of restArray(listed, 200, 'GET the pull requests after a 422 on creation')) {
        if (at(entry, 'head', 'ref') !== branch) continue;
        if (at(entry, 'state') !== 'open') continue;
        return { number: positiveInteger(at(entry, 'number'), `the ${tag} pull request number`) };
      }
    }
    throw new CheckFailure(`POST a pull request from ${branch}: ${statusText(created)}${created.status === 422 ? ' (and no open pull request from that branch was found)' : ''}`);
  }

  /** A second repository holding exactly the scenario's pageCount issues, for the cursor check. */
  private async buildPages(session: Session): Promise<PageFixture> {
    const name = this.names.pagesRepository;
    const created = await this.rest.post('/user/repos', { name, private: false }, this.callOptions(session));
    if (created.status !== 201 && created.status !== 200 && created.status !== 422 && created.status !== 409) {
      throw new CheckFailure(`POST /api/v3/user/repos for the pagination repository answered ${statusText(created)}`);
    }
    const numbers: number[] = [];
    for (let index = 1; index <= this.names.pageCount; index += 1) {
      const answer = await this.rest.post(
        `${repoPath(this.viewer, name)}/issues`,
        { title: `${this.names.titlePrefix} page ${index}`, body: this.names.body },
        this.callOptions(session),
      );
      const issue = restObject(answer, 201, `POST pagination issue ${index}`);
      numbers.push(positiveInteger(issue.number, `pagination issue ${index}'s number`));
    }
    return { numbers };
  }

  /** Read an issue's global id (the input closeIssue and addComment take). */
  async issueGlobalId(session: Session, number: number): Promise<string> {
    const response = await this.query(this.callOptions(session), ISSUE_BY_NUMBER, { owner: this.viewer, name: this.names.repository, number });
    const data = dataOf(response, `query IssueByNumber for issue #${number}`);
    return nonEmptyString(at(data, 'repository', 'issue', 'id'), `issue #${number}'s id`);
  }

  /** Read a pull request's global id (the input mergePullRequest takes). */
  async pullRequestGlobalId(session: Session, number: number): Promise<string> {
    const response = await this.query(this.callOptions(session), PULL_REQUEST_ID, { owner: this.viewer, name: this.names.repository, number });
    const data = dataOf(response, `query PullRequestId for pull request #${number}`);
    return nonEmptyString(at(data, 'repository', 'pullRequest', 'id'), `pull request #${number}'s id`);
  }
}

/** One harness per base URL and seed: all of a run's checks share its fixtures. */
const HARNESSES = new Map<string, Harness>();

function harnessFor(context: CheckContext): Harness {
  const key = `${context.baseUrl}\n${context.scenario.seed}`;
  let harness = HARNESSES.get(key);
  if (harness === undefined) {
    harness = new Harness(context);
    HARNESSES.set(key, harness);
  }
  return harness;
}

/** The one session a check body gets: the run's harness and the check's own context. */
function sessionOf(context: CheckContext): Session {
  const harness = harnessFor(context);
  const signal =
    Number.isFinite(context.timeoutMs) && context.timeoutMs > 0
      ? AbortSignal.any([context.signal, AbortSignal.timeout(context.timeoutMs)])
      : context.signal;
  return { ctx: { ...context, signal }, harness };
}

// ---------------------------------------------------------------------------------------------------------
// The checks.
// ---------------------------------------------------------------------------------------------------------

type CheckBody = (session: Session) => Promise<CheckResult>;

/** 1. query ViewerLogin — the token owner's login. */
async function viewerLogin({ ctx, harness }: Session): Promise<CheckResult> {
  const response = await harness.query(ctx, VIEWER_LOGIN);
  const data = dataOf(response, 'query ViewerLogin');
  const login = at(data, 'viewer', 'login');
  if (typeof login !== 'string' || login === '') return fail(`viewer.login is ${json(login)}, expected a non-empty login`);
  if (login !== harness.viewer) return fail(`viewer.login is ${json(login)}, expected the token owner ${json(harness.viewer)}`);
  return pass(`viewer.login is ${login}`);
}

/** 2. query RepositoryFields — the repository read gh does before every repo command. */
async function repositoryFields(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const repo = await harness.repoFixture(session);
  if (harness.branchesAvailable) await harness.baseBranchFixture(session);
  const response = await harness.query(ctx, REPOSITORY_FIELDS, { owner: harness.viewer, name: harness.names.repository });
  const data = dataOf(response, 'query RepositoryFields');
  const node = at(data, 'repository');
  if (!isRecord(node)) throw new CheckFailure(`data.repository is ${json(node)}, expected the fixture repository`);
  if (node.id !== repo.id) throw new CheckFailure(`data.repository.id is ${json(node.id)}, expected ${json(repo.id)}`);
  if (node.databaseId !== repo.databaseId) throw new CheckFailure(`data.repository.databaseId is ${json(node.databaseId)}, expected ${repo.databaseId}`);
  if (node.name !== harness.names.repository) throw new CheckFailure(`data.repository.name is ${json(node.name)}, expected ${json(harness.names.repository)}`);
  const ownerLogin = at(node, 'owner', 'login');
  if (ownerLogin !== harness.viewer) throw new CheckFailure(`data.repository.owner.login is ${json(ownerLogin)}, expected ${json(harness.viewer)}`);
  if (harness.branchesAvailable) {
    const defaultBranch = at(node, 'defaultBranchRef', 'name');
    if (defaultBranch !== harness.names.baseBranch) {
      throw new CheckFailure(`data.repository.defaultBranchRef.name is ${json(defaultBranch)}, expected ${json(harness.names.baseBranch)}`);
    }
  }
  const permission = node.viewerPermission;
  if (typeof permission !== 'string' || !['ADMIN', 'MAINTAIN', 'WRITE', 'TRIAGE', 'READ'].includes(permission)) {
    throw new CheckFailure(`data.repository.viewerPermission is ${json(permission)}, expected one of ADMIN, MAINTAIN, WRITE, TRIAGE, READ`);
  }
  if (node.hasIssuesEnabled !== true) throw new CheckFailure(`data.repository.hasIssuesEnabled is ${json(node.hasIssuesEnabled)}, expected true`);
  return pass(`repository ${harness.viewer}/${harness.names.repository} reads back with every requested field`);
}

/** 3. query Issue_fields — gh's IssueRelationshipsSupported probe. */
async function issueIntrospection({ ctx, harness }: Session): Promise<CheckResult> {
  const response = await harness.query(ctx, ISSUE_FIELDS);
  const data = dataOf(response, 'query Issue_fields');
  const names = namesFrom(at(data, 'Issue', 'fields'));
  if (names.length === 0) return fail('Issue: __type(name: "Issue").fields is empty');
  const missing = ['id', 'number', 'title', 'state', 'body'].filter((name) => !names.includes(name));
  if (missing.length > 0) return fail(`Issue's schema does not list ${missing.join(', ')}, which the suite reads: ${names.join(', ')}`);
  return pass(`Issue lists ${names.length} field(s), including id, number, title, state and body`);
}

/** 4. query PullRequest_fields + Repository_fields and query SearchType_enumValues — gh's three remaining probes. */
async function typeIntrospection({ ctx, harness }: Session): Promise<CheckResult> {
  const types = await harness.query(ctx, TYPE_FIELDS);
  const data = dataOf(types, 'query PullRequestAndRepositoryFields');
  const pullRequestNames = namesFrom(at(data, 'PullRequest', 'fields'));
  if (pullRequestNames.length === 0) return fail('PullRequest: __type(name: "PullRequest").fields is empty');
  const pullRequestMissing = ['id', 'number', 'headRefName', 'baseRefName', 'mergeable', 'state', 'merged', 'files'].filter(
    (name) => !pullRequestNames.includes(name),
  );
  if (pullRequestMissing.length > 0) return fail(`PullRequest's schema does not list ${pullRequestMissing.join(', ')}: ${pullRequestNames.join(', ')}`);
  const repositoryNames = namesFrom(at(data, 'Repository', 'fields'));
  if (repositoryNames.length === 0) return fail('Repository: __type(name: "Repository").fields is empty');
  const repositoryMissing = [
    'id',
    'databaseId',
    'name',
    'nameWithOwner',
    'owner',
    'defaultBranchRef',
    'viewerPermission',
    'hasIssuesEnabled',
    'issue',
    'issues',
    'pullRequests',
    'pullRequest',
  ].filter((name) => !repositoryNames.includes(name));
  if (repositoryMissing.length > 0) return fail(`Repository's schema does not list ${repositoryMissing.join(', ')}: ${repositoryNames.join(', ')}`);
  const search = await harness.query(ctx, SEARCH_TYPE_ENUM_VALUES);
  const searchData = dataOf(search, 'query SearchType_enumValues');
  const enumNames = namesFrom(at(searchData, 'SearchType', 'enumValues'));
  if (enumNames.length === 0) return fail('SearchType: __type(name: "SearchType").enumValues is empty');
  if (!enumNames.includes('ISSUE')) return fail(`SearchType does not list ISSUE: ${enumNames.join(', ')}`);
  return pass(`PullRequest (${pullRequestNames.length}), Repository (${repositoryNames.length}) and SearchType (${enumNames.length}) describe their schema`);
}

/** 5. query OpenIssues — the states filter and CREATED_AT DESC order. */
async function openIssues(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  await harness.repoFixture(session);
  const issues = await harness.issueFixture(session);
  const response = await harness.query(ctx, OPEN_ISSUES, { owner: harness.viewer, name: harness.names.repository, first: 10 });
  const data = dataOf(response, 'query OpenIssues');
  const nodes = arrayFrom(at(data, 'repository', 'issues', 'nodes'));
  if (nodes.length === 0) return fail('the OPEN issue list is empty after the fixture created open issues');
  if (nodes.length > 10) return fail(`the OPEN issue list has ${nodes.length} nodes for first: 10`);
  const numbers: number[] = [];
  for (const node of nodes) {
    const number = positiveInteger(at(node, 'number'), 'an open issue number');
    const state = at(node, 'state');
    if (state !== 'OPEN') return fail(`issue #${number} has state ${json(state)}, expected OPEN`);
    if (typeof at(node, 'title') !== 'string') return fail(`issue #${number} has no title string`);
    nonEmptyString(at(node, 'id'), `issue #${number}'s id`);
    numbers.push(number);
  }
  for (let index = 1; index < numbers.length; index += 1) {
    if (numbers[index] > numbers[index - 1]) {
      return fail(`the CREATED_AT DESC list is out of order: #${numbers[index - 1]} comes before #${numbers[index]}`);
    }
  }
  if (numbers.includes(issues.closed)) return fail(`the closed issue #${issues.closed} appears in the OPEN list`);
  const missing = issues.open.filter((number) => !numbers.includes(number));
  if (missing.length > 0) return fail(`the OPEN list is missing open fixture issue(s) ${missing.join(', ')}`);
  return pass(`${numbers.length} OPEN issue(s) in CREATED_AT DESC order, the closed issue excluded`);
}

/** 6. query IssueByNumber — a single issue read. */
async function issueByNumber(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  await harness.repoFixture(session);
  const issues = await harness.issueFixture(session);
  const number = issues.open[0];
  const response = await harness.query(ctx, ISSUE_BY_NUMBER, { owner: harness.viewer, name: harness.names.repository, number });
  const data = dataOf(response, `query IssueByNumber for #${number}`);
  const issue = at(data, 'repository', 'issue');
  if (!isRecord(issue)) throw new CheckFailure(`data.repository.issue is ${json(issue)}, expected #${number}`);
  if (issue.number !== number) throw new CheckFailure(`the issue read back as #${json(issue.number)}, expected #${number}`);
  if (issue.state !== 'OPEN') throw new CheckFailure(`issue #${number}'s state is ${json(issue.state)}, expected OPEN`);
  if (issue.title !== `${harness.names.titlePrefix} open 1`) {
    throw new CheckFailure(`issue #${number}'s title is ${json(issue.title)}, expected ${json(`${harness.names.titlePrefix} open 1`)}`);
  }
  if (issue.body !== harness.names.body) throw new CheckFailure(`issue #${number}'s body does not match the seeded body`);
  nonEmptyString(issue.id, `issue #${number}'s id`);
  return pass(`issue #${number} reads back with its title, state, body and id`);
}

/** 7. mutation IssueCreate — gh's `gh issue create`, then the REST view. */
async function createIssue(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const repo = await harness.repoFixture(session);
  const title = `${harness.names.titlePrefix} created over graphql`;
  const response = await harness.query(ctx, CREATE_ISSUE, { input: { repositoryId: repo.id, title, body: harness.names.body } });
  const data = dataOf(response, 'mutation IssueCreate');
  const issue = at(data, 'createIssue', 'issue');
  if (!isRecord(issue)) throw new CheckFailure(`createIssue.issue is ${json(issue)}`);
  const number = positiveInteger(issue.number, 'createIssue.issue.number');
  nonEmptyString(issue.id, 'createIssue.issue.id');
  const rest = await harness.rest.get(`${repoPath(harness.viewer, harness.names.repository)}/issues/${number}`, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  const created = restObject(rest, 200, `GET issue #${number} after creating it over GraphQL`);
  if (created.number !== number) throw new CheckFailure(`the REST view answers #${json(created.number)}, expected #${number}`);
  if (created.title !== title) throw new CheckFailure(`the REST view's title is ${json(created.title)}, expected ${json(title)}`);
  if (created.state !== 'open') throw new CheckFailure(`the REST view's state is ${json(created.state)}, expected open`);
  return pass(`createIssue made #${number} and the REST view reads it open with the same title`);
}

/** 8. mutation IssueClose — gh's `gh issue close`, then the REST view. */
async function closeIssue(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  await harness.repoFixture(session);
  const created = await harness.rest.post(
    `${repoPath(harness.viewer, harness.names.repository)}/issues`,
    { title: `${harness.names.titlePrefix} closed over graphql`, body: harness.names.body },
    { signal: ctx.signal, timeoutMs: ctx.timeoutMs },
  );
  const number = positiveInteger(restObject(created, 201, 'POST the issue to close').number, 'the issue number');
  const id = await harness.issueGlobalId(session, number);
  const response = await harness.query(ctx, CLOSE_ISSUE, { input: { issueId: id } });
  const data = dataOf(response, 'mutation IssueClose');
  const closed = at(data, 'closeIssue', 'issue');
  if (!isRecord(closed)) throw new CheckFailure(`closeIssue.issue is ${json(closed)}`);
  if (closed.number !== number) throw new CheckFailure(`closeIssue names #${json(closed.number)}, expected #${number}`);
  if (closed.state !== 'CLOSED') throw new CheckFailure(`closeIssue.issue.state is ${json(closed.state)}, expected CLOSED`);
  const rest = await harness.rest.get(`${repoPath(harness.viewer, harness.names.repository)}/issues/${number}`, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  const read = restObject(rest, 200, `GET issue #${number} after closing it`);
  if (read.state !== 'closed') throw new CheckFailure(`the REST view's state is ${json(read.state)}, expected closed`);
  return pass(`closeIssue closed #${number} and the REST view shows it closed`);
}

/** 9. query PullRequests — gh's `gh pr list`. */
async function pullRequests(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const pullRequest = await harness.pullRequestFixture(session);
  const response = await harness.query(ctx, PULL_REQUESTS, { owner: harness.viewer, name: harness.names.repository, first: 5 });
  const data = dataOf(response, 'query PullRequests');
  const nodes = arrayFrom(at(data, 'repository', 'pullRequests', 'nodes'));
  if (nodes.length > 5) return fail(`the pull request list has ${nodes.length} nodes for first: 5`);
  const node = nodes.find((entry) => at(entry, 'number') === pullRequest.number);
  if (node === undefined) return fail(`pull request #${pullRequest.number} is not in the open list: ${nodes.map((entry) => json(at(entry, 'number'))).join(', ')}`);
  const head = at(node, 'headRefName');
  const base = at(node, 'baseRefName');
  if (head !== harness.names.headBranch) throw new CheckFailure(`pull request #${pullRequest.number}'s headRefName is ${json(head)}, expected ${json(harness.names.headBranch)}`);
  if (base !== harness.names.baseBranch) throw new CheckFailure(`pull request #${pullRequest.number}'s baseRefName is ${json(base)}, expected ${json(harness.names.baseBranch)}`);
  if (at(node, 'state') !== 'OPEN') throw new CheckFailure(`pull request #${pullRequest.number}'s state is ${json(at(node, 'state'))}, expected OPEN`);
  const mergeable = at(node, 'mergeable');
  if (typeof mergeable !== 'string' || !['MERGEABLE', 'CONFLICTING', 'UNKNOWN'].includes(mergeable)) {
    throw new CheckFailure(`pull request #${pullRequest.number}'s mergeable is ${json(mergeable)}, expected MERGEABLE, CONFLICTING or UNKNOWN`);
  }
  return pass(`pull request #${pullRequest.number} lists with its head, base, state and mergeable`);
}

/** 10. query PullRequestFiles — the changed files of a pull request. */
async function pullRequestFiles(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const pullRequest = await harness.pullRequestFixture(session);
  const response = await harness.query(ctx, PULL_REQUEST_FILES, {
    owner: harness.viewer,
    name: harness.names.repository,
    number: pullRequest.number,
  });
  const data = dataOf(response, `query PullRequestFiles for #${pullRequest.number}`);
  const node = at(data, 'repository', 'pullRequest');
  if (!isRecord(node)) throw new CheckFailure(`data.repository.pullRequest is ${json(node)}`);
  if (node.number !== pullRequest.number) throw new CheckFailure(`the pull request read back as #${json(node.number)}, expected #${pullRequest.number}`);
  const paths: string[] = [];
  for (const entry of arrayFrom(at(node, 'files', 'nodes'))) {
    const path = at(entry, 'path');
    if (typeof path === 'string' && path !== '') paths.push(path);
  }
  if (!paths.includes(harness.names.filePath)) {
    return fail(`pull request #${pullRequest.number}'s files do not include the changed path ${json(harness.names.filePath)}: ${paths.length === 0 ? 'none' : paths.join(', ')}`);
  }
  return pass(`pull request #${pullRequest.number}'s files include ${harness.names.filePath}`);
}

/** 11. mutation PullRequestCreate — gh's `gh pr create`. */
async function createPullRequest(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const repo = await harness.repoFixture(session);
  await harness.branchFixture(session);
  const title = `${harness.names.titlePrefix} created over graphql`;
  const response = await harness.query(ctx, CREATE_PULL_REQUEST, {
    input: { repositoryId: repo.id, baseRefName: harness.names.baseBranch, headRefName: harness.names.createBranch, title },
  });
  const data = dataOf(response, 'mutation PullRequestCreate');
  const pullRequest = at(data, 'createPullRequest', 'pullRequest');
  if (!isRecord(pullRequest)) throw new CheckFailure(`createPullRequest.pullRequest is ${json(pullRequest)}`);
  const number = positiveInteger(pullRequest.number, 'createPullRequest.pullRequest.number');
  nonEmptyString(pullRequest.id, 'createPullRequest.pullRequest.id');
  if (pullRequest.state !== 'OPEN') throw new CheckFailure(`createPullRequest.pullRequest.state is ${json(pullRequest.state)}, expected OPEN`);
  if (pullRequest.headRefName !== harness.names.createBranch) {
    throw new CheckFailure(`createPullRequest.pullRequest.headRefName is ${json(pullRequest.headRefName)}, expected ${json(harness.names.createBranch)}`);
  }
  if (pullRequest.baseRefName !== harness.names.baseBranch) {
    throw new CheckFailure(`createPullRequest.pullRequest.baseRefName is ${json(pullRequest.baseRefName)}, expected ${json(harness.names.baseBranch)}`);
  }
  const rest = await harness.rest.get(`${repoPath(harness.viewer, harness.names.repository)}/pulls/${number}`, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  const read = restObject(rest, 200, `GET pull request #${number} after creating it over GraphQL`);
  if (at(read, 'head', 'ref') !== harness.names.createBranch) {
    throw new CheckFailure(`the REST view's head.ref is ${json(at(read, 'head', 'ref'))}, expected ${json(harness.names.createBranch)}`);
  }
  if (at(read, 'base', 'ref') !== harness.names.baseBranch) {
    throw new CheckFailure(`the REST view's base.ref is ${json(at(read, 'base', 'ref'))}, expected ${json(harness.names.baseBranch)}`);
  }
  return pass(`createPullRequest made #${number} from ${harness.names.createBranch} and the REST view reads it`);
}

/** 12. mutation MergePullRequest — gh's `gh pr merge --squash`, then the REST view. */
async function mergePullRequest(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const pullRequest = await harness.mergePullRequestFixture(session);
  const id = await harness.pullRequestGlobalId(session, pullRequest.number);
  const response = await harness.query(ctx, MERGE_PULL_REQUEST, { input: { pullRequestId: id, mergeMethod: 'SQUASH' } });
  const data = dataOf(response, `mutation MergePullRequest for #${pullRequest.number}`);
  const merged = at(data, 'mergePullRequest', 'pullRequest');
  if (!isRecord(merged)) throw new CheckFailure(`mergePullRequest.pullRequest is ${json(merged)}`);
  if (merged.merged !== true) throw new CheckFailure(`mergePullRequest.pullRequest.merged is ${json(merged.merged)}, expected true`);
  const rest = await harness.rest.get(`${repoPath(harness.viewer, harness.names.repository)}/pulls/${pullRequest.number}`, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  const read = restObject(rest, 200, `GET pull request #${pullRequest.number} after merging it`);
  if (read.merged !== true) throw new CheckFailure(`the REST view's merged is ${json(read.merged)}, expected true`);
  if (read.state !== 'closed') throw new CheckFailure(`the REST view's state is ${json(read.state)}, expected closed after a merge`);
  return pass(`mergePullRequest squash-merged #${pullRequest.number} and the REST view shows merged: true, state closed`);
}

/** 13. mutation AddComment — a comment on an issue, then the REST view's comment list. */
async function addComment(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  await harness.repoFixture(session);
  const created = await harness.rest.post(
    `${repoPath(harness.viewer, harness.names.repository)}/issues`,
    { title: `${harness.names.titlePrefix} commented over graphql`, body: harness.names.body },
    { signal: ctx.signal, timeoutMs: ctx.timeoutMs },
  );
  const number = positiveInteger(restObject(created, 201, 'POST the issue to comment on').number, 'the issue number');
  const id = await harness.issueGlobalId(session, number);
  const response = await harness.query(ctx, ADD_COMMENT, { input: { subjectId: id, body: harness.names.comment } });
  const data = dataOf(response, 'mutation AddComment');
  const comment = at(data, 'addComment', 'commentEdge', 'node');
  if (!isRecord(comment)) throw new CheckFailure(`addComment.commentEdge.node is ${json(comment)}`);
  if (comment.body !== harness.names.comment) throw new CheckFailure('addComment did not echo the comment body');
  nonEmptyString(comment.id, 'addComment.commentEdge.node.id');
  const rest = await harness.rest.get(`${repoPath(harness.viewer, harness.names.repository)}/issues/${number}/comments`, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  const comments = restArray(rest, 200, `GET issue #${number}'s comments`);
  if (!comments.some((entry) => at(entry, 'body') === harness.names.comment)) {
    return fail(`the REST comment list for issue #${number} does not hold the added comment`);
  }
  return pass(`addComment wrote a comment on #${number} and the REST view lists it`);
}

/** 14. An unknown field is a 200 with an `errors` array, not an HTTP 400. */
async function invalidField({ ctx, harness }: Session): Promise<CheckResult> {
  const response = await harness.query(ctx, INVALID_FIELD);
  if (response.transportError !== undefined) throw new CheckFailure(`query with an invalid field: ${response.transportError}`);
  if (response.status !== 200) return fail(`HTTP ${response.status} for a query with an invalid field, expected 200 with an errors array`);
  if (response.parseError !== undefined) throw new CheckFailure(`query with an invalid field: ${response.parseError}`);
  if (response.errors.length === 0) return fail('the response carries no errors array: the invalid field was not reported');
  if (!response.errors.some((error) => error.message.includes('noSuchFieldOnViewer'))) {
    return fail(`the errors do not name the invalid field: ${response.errors.map((error) => error.message).join('; ')}`);
  }
  return pass(`HTTP 200 with ${response.errors.length} GraphQL error(s) naming noSuchFieldOnViewer`);
}

/** 15. An unauthenticated query is a 401. */
async function unauthenticated({ ctx, harness }: Session): Promise<CheckResult> {
  const anon = harness.client.withoutToken();
  const response = await anon.request(VIEWER_LOGIN, {}, { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  if (response.transportError !== undefined) throw new CheckFailure(`unauthenticated query: ${response.transportError}`);
  if (response.status !== 401) return fail(`HTTP ${response.status} for an unauthenticated query, expected 401`);
  return pass('an unauthenticated POST /api/graphql is 401');
}

/** 16. Query.node(id:) — the Relay global id round-trips a repository. */
async function nodeRepository(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const repo = await harness.repoFixture(session);
  const response = await harness.query(ctx, NODE_REPOSITORY, { id: repo.id });
  const data = dataOf(response, 'query NodeRepository');
  const node = at(data, 'node');
  if (!isRecord(node)) throw new CheckFailure(`data.node is ${json(node)}, expected the repository`);
  if (node.id !== repo.id) throw new CheckFailure(`data.node.id is ${json(node.id)}, expected ${json(repo.id)}`);
  if (node.name !== harness.names.repository) throw new CheckFailure(`data.node.name is ${json(node.name)}, expected ${json(harness.names.repository)}`);
  const nameWithOwner = `${harness.viewer}/${harness.names.repository}`;
  if (node.nameWithOwner !== nameWithOwner) throw new CheckFailure(`data.node.nameWithOwner is ${json(node.nameWithOwner)}, expected ${json(nameWithOwner)}`);
  return pass(`node(id:) round-trips repository ${nameWithOwner}`);
}

/** 17. A repository lookup for an unknown owner/name is data.repository = null and no errors. */
async function unknownRepository({ ctx, harness }: Session): Promise<CheckResult> {
  const response = await harness.query(ctx, REPOSITORY_FIELDS, { owner: harness.viewer, name: harness.names.unknownRepository });
  const data = dataOf(response, `query RepositoryFields for the unknown repository ${harness.names.unknownRepository}`);
  const repository = at(data, 'repository');
  if (repository !== null) return fail(`data.repository is ${json(repository)}, expected null`);
  return pass(`data.repository is null for ${json(harness.names.unknownRepository)} with no errors`);
}

/** 18. Two operation documents in one HTTP body (GitHub's operation batching). */
async function batchedOperations({ ctx, harness }: Session): Promise<CheckResult> {
  const response = await harness.client.batch([{ query: VIEWER_LOGIN }, { query: ISSUE_FIELDS }], { signal: ctx.signal, timeoutMs: ctx.timeoutMs });
  if (response.transportError !== undefined) throw new CheckFailure(`batched request: ${response.transportError}`);
  if (response.status !== 200) return fail(`HTTP ${response.status} for a batched request, expected 200`);
  if (response.parseError !== undefined) throw new CheckFailure(`batched request: ${response.parseError}`);
  if (response.responses.length !== 2) return fail(`the batched response holds ${response.responses.length} entries, expected 2`);
  const viewer = dataOf(response.responses[0], 'the batched viewer operation');
  const introspection = dataOf(response.responses[1], 'the batched Issue introspection operation');
  const login = at(viewer, 'viewer', 'login');
  if (login !== harness.viewer) return fail(`the first batched operation answered viewer.login ${json(login)}, expected ${json(harness.viewer)}`);
  const names = namesFrom(at(introspection, 'Issue', 'fields'));
  if (names.length === 0) return fail('the second batched operation answered an empty Issue fields list');
  return pass('two operation documents in one body answer two data objects in order');
}

/** 19. The global id is opaque and stable across reads. */
async function globalIdStability(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const repo = await harness.repoFixture(session);
  const first = await harness.query(ctx, REPOSITORY_FIELDS, { owner: harness.viewer, name: harness.names.repository });
  const second = await harness.query(ctx, REPOSITORY_FIELDS, { owner: harness.viewer, name: harness.names.repository });
  const firstData = dataOf(first, 'the first repository read');
  const secondData = dataOf(second, 'the second repository read');
  const firstId = nonEmptyString(at(firstData, 'repository', 'id'), 'the repository id');
  const secondId = nonEmptyString(at(secondData, 'repository', 'id'), 'the repository id on the second read');
  if (firstId !== secondId) return fail(`the repository id changed between reads: ${json(firstId)} then ${json(secondId)}`);
  if (firstId === String(repo.databaseId)) return fail(`the repository id ${json(firstId)} is the plain databaseId, not an opaque global id`);
  const issues = await harness.issueFixture(session);
  const number = issues.open[0];
  const firstIssue = await harness.query(ctx, ISSUE_BY_NUMBER, { owner: harness.viewer, name: harness.names.repository, number });
  const secondIssue = await harness.query(ctx, ISSUE_BY_NUMBER, { owner: harness.viewer, name: harness.names.repository, number });
  const firstIssueData = dataOf(firstIssue, 'the first issue read');
  const secondIssueData = dataOf(secondIssue, 'the second issue read');
  const firstIssueId = nonEmptyString(at(firstIssueData, 'repository', 'issue', 'id'), `issue #${number}'s id`);
  const secondIssueId = nonEmptyString(at(secondIssueData, 'repository', 'issue', 'id'), `issue #${number}'s id on the second read`);
  if (firstIssueId !== secondIssueId) return fail(`issue #${number}'s id changed between reads: ${json(firstIssueId)} then ${json(secondIssueId)}`);
  if (firstIssueId === String(number)) return fail(`issue #${number}'s id ${json(firstIssueId)} is the plain number, not an opaque global id`);
  return pass('the repository and issue global ids are non-empty, opaque and equal on repeated reads');
}

/** 20. Cursor pagination on issues(first, after) with pageInfo. */
async function issuesPagination(session: Session): Promise<CheckResult> {
  const { harness, ctx } = session;
  const pages = await harness.pageFixture(session);
  const first = await harness.query(ctx, ISSUES_PAGE, {
    owner: harness.viewer,
    name: harness.names.pagesRepository,
    first: harness.names.pageSize,
    after: null,
  });
  const firstData = dataOf(first, 'the first issues page');
  const firstConnection = at(firstData, 'repository', 'issues');
  if (!isRecord(firstConnection)) throw new CheckFailure(`data.repository.issues is ${json(firstConnection)}`);
  const firstNodes = arrayFrom(firstConnection.nodes);
  if (firstNodes.length !== harness.names.pageSize) return fail(`the first page holds ${firstNodes.length} node(s), expected ${harness.names.pageSize}`);
  if (at(firstConnection, 'pageInfo', 'hasNextPage') !== true) return fail('the first page does not report hasNextPage: true');
  const cursor = at(firstConnection, 'pageInfo', 'endCursor');
  if (typeof cursor !== 'string' || cursor === '') return fail(`the first page's endCursor is ${json(cursor)}, expected a non-empty cursor`);
  const second = await harness.query(ctx, ISSUES_PAGE, {
    owner: harness.viewer,
    name: harness.names.pagesRepository,
    first: harness.names.pageSize,
    after: cursor,
  });
  const secondData = dataOf(second, 'the second issues page');
  const secondConnection = at(secondData, 'repository', 'issues');
  if (!isRecord(secondConnection)) throw new CheckFailure(`the second page's data.repository.issues is ${json(secondConnection)}`);
  const secondNodes = arrayFrom(secondConnection.nodes);
  if (secondNodes.length !== harness.names.pageCount - harness.names.pageSize) {
    return fail(`the second page holds ${secondNodes.length} node(s), expected ${harness.names.pageCount - harness.names.pageSize}`);
  }
  if (at(secondConnection, 'pageInfo', 'hasNextPage') !== false) return fail('the second page does not report hasNextPage: false');
  const seen = new Set<number>();
  for (const node of [...firstNodes, ...secondNodes]) {
    const number = positiveInteger(at(node, 'number'), 'a paged issue number');
    if (seen.has(number)) return fail(`issue #${number} appears on both pages`);
    seen.add(number);
  }
  const expected = new Set(pages.numbers);
  for (const number of seen) {
    if (!expected.has(number)) return fail(`the pages hold issue #${number}, which the fixture did not create`);
  }
  if (seen.size !== harness.names.pageCount) return fail(`the two pages hold ${seen.size} distinct issue(s), expected ${harness.names.pageCount}`);
  return pass(`${harness.names.pageCount} issues paged by the cursor as ${harness.names.pageSize} + ${harness.names.pageCount - harness.names.pageSize}`);
}

/** The check table: one entry per check, in the order the group lists them. */
const CHECK_TABLE: readonly { slug: string; title: string; timeoutMs: number; body: CheckBody }[] = [
  { slug: 'viewer-login', title: 'query { viewer { login } } answers the token owner', timeoutMs: 8_000, body: viewerLogin },
  { slug: 'repository-fields', title: 'repository(owner:, name:) answers id, databaseId, name, owner, defaultBranchRef, viewerPermission and hasIssuesEnabled', timeoutMs: 10_000, body: repositoryFields },
  { slug: 'introspection-issue', title: '__type(name: "Issue") lists the fields gh feature-detects', timeoutMs: 8_000, body: issueIntrospection },
  { slug: 'introspection-types', title: '__type lists PullRequest, Repository and SearchType (gh\'s other probes, one check)', timeoutMs: 10_000, body: typeIntrospection },
  { slug: 'issues-open-order', title: 'issues(first: 10, states: [OPEN], orderBy: CREATED_AT DESC) filters and orders', timeoutMs: 12_000, body: openIssues },
  { slug: 'issue-by-number', title: 'issue(number:) reads one issue', timeoutMs: 10_000, body: issueByNumber },
  { slug: 'create-issue', title: 'createIssue creates an issue the REST view sees', timeoutMs: 12_000, body: createIssue },
  { slug: 'close-issue', title: 'closeIssue closes an issue the REST view shows closed', timeoutMs: 12_000, body: closeIssue },
  { slug: 'pull-requests-list', title: 'pullRequests(first: 5) lists number, headRefName, baseRefName, mergeable and state', timeoutMs: 15_000, body: pullRequests },
  { slug: 'pull-request-files', title: 'pullRequest(number:).files lists the changed paths', timeoutMs: 12_000, body: pullRequestFiles },
  { slug: 'create-pull-request', title: 'createPullRequest creates a pull request', timeoutMs: 15_000, body: createPullRequest },
  { slug: 'merge-pull-request', title: 'mergePullRequest SQUASH merges and the REST view shows merged: true', timeoutMs: 15_000, body: mergePullRequest },
  { slug: 'add-comment', title: 'addComment writes an issue comment the REST view lists', timeoutMs: 12_000, body: addComment },
  { slug: 'invalid-field', title: 'an invalid field is a 200 with an errors array', timeoutMs: 8_000, body: invalidField },
  { slug: 'unauthenticated', title: 'an unauthenticated query is a 401', timeoutMs: 8_000, body: unauthenticated },
  { slug: 'node-repository', title: 'node(id:) round-trips a repository', timeoutMs: 10_000, body: nodeRepository },
  { slug: 'unknown-repository', title: 'an unknown repository reads data.repository = null with no errors', timeoutMs: 8_000, body: unknownRepository },
  { slug: 'batched-operations', title: 'two operation documents in one body answer in order', timeoutMs: 10_000, body: batchedOperations },
  { slug: 'global-id-stability', title: 'global ids are opaque and equal on repeated reads', timeoutMs: 12_000, body: globalIdStability },
  { slug: 'issues-pagination', title: 'issues(first, after) pages by cursor to the end', timeoutMs: 12_000, body: issuesPagination },
];

/** The group's 20 checks, as the manifest's registry takes them. */
export const GRAPHQL_CHECKS: readonly CheckSpec[] = Object.freeze(
  CHECK_TABLE.map((entry) => {
    const body = entry.body;
    return Object.freeze({
      id: checkId('graphql', entry.slug),
      group: 'graphql' as const,
      title: entry.title,
      timeoutMs: entry.timeoutMs,
      fn: async (context: CheckContext): Promise<CheckResult> => {
        try {
          if (!Number.isFinite(context.timeoutMs) || context.timeoutMs <= 0) return fail('deadline');
          return await body(sessionOf(context));
        } catch (err) {
          if (err instanceof CheckFailure) return fail(err.message);
          return fail(`check threw: ${err instanceof Error ? `${err.name}: ${err.message}` : String(err)}`);
        }
      },
    });
  }),
);

/** Every check id in the group, in table order. */
export const GRAPHQL_CHECK_IDS: readonly string[] = Object.freeze(GRAPHQL_CHECKS.map((check) => check.id));
// env/src/checks-mcp.ts: the agent-native arm of the github-core-clone-01 suite — the `mcp` group, 15 checks,
// registered as `readonly CheckSpec[]` against env/src/manifest.ts (the agent column is this group's passed
// count of 15). It drives the entry's Model Context Protocol endpoint at `<entry base URL>/mcp` through
// env/src/mcp-client.ts, and it judges both protocol eras the rules accept:
//
//   modern 2026-07-28: `server/discover` returns the server's identity, capabilities and supported versions;
//           every request declares its revision in `_meta`; no handshake and no session.
//   legacy 2025-11-25 and earlier: `initialize` + `notifications/initialized`, an optional `Mcp-Session-Id`,
//           and no `server/discover` (the discover check passes with detail "pre-discover revision").
//
// The checks (slugs; each id is checkId('mcp', slug); each 1 bit of the group's 15):
//
//   initialize            the server names itself and declares the tools capability — over whichever of
//                         `server/discover` or `initialize` it negotiated: serverInfo.name and .version
//                         are non-empty strings, capabilities.tools is present
//   server-discover       `server/discover` answers a DiscoverResult with a non-empty `supportedVersions`
//                         of YYYY-MM-DD revisions; a server that predates it (a 404, JSON-RPC -32601, or any
//                         other refusal before a working initialize handshake) passes as
//                         "pre-discover revision", never failed
//   tools-list            `tools/list` offers at least six tools and all of create_repo, get_repo,
//                         create_issue, list_issues, create_pull_request, merge_pull_request by name or
//                         an obvious alias (a server prefix allowed, matched by suffix, case-insensitive)
//   tool-schemas          every listed tool has a non-empty description and an inputSchema of type object
//   create-issue          `tools/call` create_issue creates an issue the REST surface lists (same title)
//   list-issues           `tools/call` list_issues returns an issue that exists in the repository
//   create-pull-request   `tools/call` create_pull_request opens a pull request that REST reads back with
//                         the same head and base refs
//   merge-pull-request    `tools/call` merge_pull_request merges a pull request; REST reads merged:true
//   unknown-tool          an unknown tool name answers a JSON-RPC error (-32602 or -32601), never HTTP 500
//   parse-error           a body that is not JSON answers HTTP 400 with JSON-RPC -32700
//   missing-arguments     tools/call without the required arguments answers isError:true or JSON-RPC -32602
//   concurrent-calls      two concurrent tools/call answers keep their own ids and their own objects
//   tools-list-idempotent two `tools/list` answers hold the same tools array, byte for byte
//   rest-parity           a repository and an issue created over MCP are the same objects over REST, their
//                         ids stable across repeated reads
//   auth-required         a tools/call with no Authorization header answers HTTP 401
//
// The tool argument contract the rules state (github-mcp-server's names; the suite maps the documented name
// to the tool's own schema property by exact normalized name, so a server may use owner_login for owner, and
// a property named full_name receives "owner/repo"): create_repo {name, description?, private?};
// get_repo {owner, repo}; create_issue {owner, repo, title, body?}; list_issues {owner, repo, state?};
// create_pull_request {owner, repo, title, head, base}; merge_pull_request {owner, repo, pull_number}.
// A tool whose inputSchema has a required property the suite cannot fill fails its check with the property
// named, rather than being called with made-up arguments.
//
// The setup uses the REST surface the checks judge as it is (a broken REST route fails these checks with the
// route and status named): GET /api/v3/user (the token's login, the repository owner; the scenario's viewer
// when it refuses); POST /api/v3/user/repos; GET /api/v3/repos/{owner}/{repo}; PUT
// /api/v3/repos/{owner}/{repo}/contents/{path} (with and without `branch`); POST
// /api/v3/repos/{owner}/{repo}/git/refs (or the contents route that creates a branch); GET
// /api/v3/repos/{owner}/{repo}/git/refs/heads/{branch} (or /branches/{branch}); GET/POST
// /api/v3/repos/{owner}/{repo}/issues; GET/POST /api/v3/repos/{owner}/{repo}/pulls and
// GET /api/v3/repos/{owner}/{repo}/pulls/{number}.
//
// Determinism: every name, title, branch, path and byte this group sends comes from the scenario
// (wire.ts buildScenario(), one fixed seed); no Math.random and no clock in a pass bit. The same entry and
// the same scenario issue the same requests in the same order, so state.json's bits replay byte for byte.
// A check that throws fails with its message, never crashes the suite. Nothing here logs the token.

import type { CheckContext, CheckSpec } from './manifest.ts';
import { checkId, fail, pass } from './manifest.ts';
import type { Scenario } from './wire.ts';
import { McpClient, MCP_DEFAULT_TIMEOUT_MS, MCP_LEGACY_REVISIONS, MCP_PREFERRED_REVISION, JSON_RPC_INVALID_PARAMS, JSON_RPC_PARSE_ERROR } from './mcp-client.ts';
import type { McpConnectionInfo, McpDiscoverAttempt, McpRequestOptions, McpTool, McpToolCallOutcome } from './mcp-client.ts';

/** The manifest group these checks count into. */
export const MCP_GROUP = 'mcp';

/** The six tools the agent-native arm needs, by their canonical (github-mcp-server) names. */
export const MCP_REQUIRED_TOOLS = Object.freeze(['create_repo', 'get_repo', 'create_issue', 'list_issues', 'create_pull_request', 'merge_pull_request'] as const);

/** The obvious aliases a tool name may carry instead of the canonical name (matched by normalized suffix too). */
export const MCP_TOOL_ALIASES: Readonly<Record<string, readonly string[]>> = Object.freeze({
  create_repo: Object.freeze(['create_repository', 'repo_create', 'repos_create', 'repository_create']),
  get_repo: Object.freeze(['get_repository', 'repo_get', 'repos_get', 'repository_get']),
  create_issue: Object.freeze(['issue_create', 'issues_create']),
  list_issues: Object.freeze(['issues_list', 'issue_list']),
  create_pull_request: Object.freeze(['pull_request_create', 'pulls_create', 'create_pr', 'pr_create']),
  merge_pull_request: Object.freeze(['pull_request_merge', 'pulls_merge', 'merge_pr', 'pr_merge']),
});

/** The revisions this client accepts: the current one, and the handshake revisions it negotiates down to. */
export const MCP_ACCEPTED_REVISIONS = Object.freeze([MCP_PREFERRED_REVISION, ...MCP_LEGACY_REVISIONS]);

// ---------------------------------------------------------------- small utilities

/** Whether `value` is a plain record. */
function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

/** The message of an unknown thrown value. */
function messageOf(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

/** The detail for a check that cannot even start (setup refused). */
class SetupFailure extends Error {
  detail: string;

  constructor(detail: string) {
    super(detail);
    this.name = 'SetupFailure';
    this.detail = detail;
  }
}

/** The detail of a thrown error: a setup refusal's own words, else the message. */
function detailOf(error: unknown): string {
  return error instanceof SetupFailure ? error.detail : messageOf(error);
}

/** A diagnostic line (never scored). */
function logLine(ctx: CheckContext, line: string): void {
  try {
    ctx.log(line);
  } catch {
    // a logger's trouble is never a check's
  }
}

/** The seeded data every check in this group sends, read from the one scenario. */
interface SeededData {
  /** The scenario seed's first 8 hex characters: the tag that keeps this group's names apart from others'. */
  tag: string;
  repo(part: string): string;
  branch(part: string): string;
  filePath(part: string, which: string): string;
  issue(index: number): { title: string; body: string };
  pull(index: number): { title: string; body: string; head: string; base: string };
  blob(index: number): { path: string; base64: string; content: string };
  commitMessage(index: number): string;
}

/** Build the seeded data from the scenario (see the header). */
function dataFor(scenario: Scenario): SeededData {
  const tag = (typeof scenario.seed === 'string' && scenario.seed !== '' ? scenario.seed : '00000000').slice(0, 8);
  const slug = (part: string): string => part.toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
  return {
    tag,
    repo: (part: string) => `mcp-${tag}-${slug(part)}`,
    branch: (part: string) => `mcp-head-${tag}-${slug(part)}`,
    filePath: (part: string, which: string) => `mcp-${tag}-${slug(part)}-${slug(which)}.txt`,
    issue: (index: number) => scenario.issues[index % scenario.issues.length]!,
    pull: (index: number) => scenario.pulls[index % scenario.pulls.length]!,
    blob: (index: number) => scenario.blobs[index % scenario.blobs.length]!,
    commitMessage: (index: number) => scenario.commits[index % scenario.commits.length]!.message,
  };
}

/** The per-request timeout: the check's own budget, capped at the client's default. */
function requestTimeoutOf(ctx: CheckContext): number {
  const budget = Number.isFinite(ctx.timeoutMs) && ctx.timeoutMs > 0 ? Math.trunc(ctx.timeoutMs) : MCP_DEFAULT_TIMEOUT_MS;
  return Math.max(1, Math.min(budget, MCP_DEFAULT_TIMEOUT_MS));
}

/** A fresh client for this check (its timeout and abort signal are the check's). */
function newClient(ctx: CheckContext): McpClient {
  return new McpClient({ baseUrl: ctx.baseUrl, token: ctx.token, timeoutMs: requestTimeoutOf(ctx), signal: ctx.signal });
}

// ---------------------------------------------------------------- tools and arguments

/** A name normalized for matching: lowercase, every non-alphanumeric removed. */
function normalizeName(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]/g, '');
}

/**
 * The tool that serves `canonical`: an exact canonical/alias match first, then a tool whose normalized name
 * ends with one (a server prefix such as `github__create_issue`). Null when the server lists none.
 */
export function findTool(tools: readonly McpTool[], canonical: string): McpTool | null {
  const wanted = new Set<string>([canonical, ...(MCP_TOOL_ALIASES[canonical] ?? [])].map(normalizeName));
  const named = tools.filter((tool): tool is McpTool & { name: string } => typeof tool.name === 'string' && tool.name !== '');
  for (const tool of named) if (wanted.has(normalizeName(tool.name))) return tool;
  for (const tool of named) {
    const name = normalizeName(tool.name);
    for (const suffix of wanted) if (name.length > suffix.length && name.endsWith(suffix)) return tool;
  }
  return null;
}

/** The argument names the suite fills, and the schema properties each may be addressed by (normalized). */
const ARGUMENT_SYNONYMS: Readonly<Record<string, readonly string[]>> = Object.freeze({
  owner: Object.freeze(['owner', 'owner_login', 'org', 'organization', 'organisation', 'user', 'user_login', 'login', 'account', 'namespace', 'owner_name']),
  repo: Object.freeze(['repo', 'repository', 'repository_name', 'repo_name', 'repo_slug', 'project', 'project_name']),
  repo_full_name: Object.freeze(['full_name', 'repo_full_name', 'repository_full_name', 'fullName']),
  title: Object.freeze(['title', 'issue_title', 'pr_title', 'pull_request_title', 'subject']),
  body: Object.freeze(['body', 'issue_body', 'description', 'content', 'text', 'comment']),
  head: Object.freeze(['head', 'head_ref', 'head_branch', 'pull_request_head', 'pr_head', 'source', 'source_ref', 'source_branch', 'from', 'from_branch', 'branch']),
  base: Object.freeze(['base', 'base_ref', 'base_branch', 'pull_request_base', 'pr_base', 'target', 'target_ref', 'target_branch', 'into', 'into_branch']),
  pull_number: Object.freeze(['pull_number', 'pull_request_number', 'pr_number', 'number', 'issue_number', 'index']),
  name: Object.freeze(['name', 'repo', 'repository', 'repository_name', 'repo_name']),
  description: Object.freeze(['description', 'about', 'summary', 'body']),
  private: Object.freeze(['private', 'is_private']),
  state: Object.freeze(['state', 'status']),
});

interface MappedArguments {
  args: Record<string, unknown>;
  /** The inputSchema's required properties the suite has no value for. */
  missing: string[];
}

/** Map the suite's documented arguments onto a tool's own inputSchema property names. */
function mapArguments(tool: McpTool, semantic: Record<string, unknown>): MappedArguments {
  const schema = isRecord(tool.inputSchema) ? tool.inputSchema : null;
  const properties = schema !== null && isRecord(schema.properties) ? schema.properties : null;
  if (properties === null) return { args: { ...semantic }, missing: [] };
  const byNormalized = new Map<string, string>();
  for (const property of Object.keys(properties)) byNormalized.set(normalizeName(property), property);
  const propertyFor = (key: string): string | null => {
    for (const synonym of ARGUMENT_SYNONYMS[key] ?? [key]) {
      const property = byNormalized.get(normalizeName(synonym));
      if (property !== undefined) return property;
    }
    return null;
  };
  const args: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(semantic)) {
    if (value === undefined) continue;
    const property = propertyFor(key);
    if (property !== null) args[property] = value;
  }
  const fullNameProperty = propertyFor('repo_full_name');
  if (propertyFor('repo') === null && fullNameProperty !== null && typeof semantic.owner === 'string' && typeof semantic.repo === 'string') {
    args[fullNameProperty] = `${semantic.owner}/${semantic.repo}`;
  }
  const required = schema !== null && Array.isArray(schema.required) ? schema.required.filter((entry): entry is string => typeof entry === 'string') : [];
  return { args, missing: required.filter((name) => !(name in args)) };
}

/** One mapped tool call, or why it could not be made. */
interface MappedCall {
  toolFound: boolean;
  toolName: string;
  args: Record<string, unknown>;
  missing: string[];
  outcome: McpToolCallOutcome | null;
}

/** Resolve the tool, map the arguments and call it. `allowMissing` calls anyway (the missing-arguments check). */
async function callToolByName(client: McpClient, tools: readonly McpTool[], canonical: string, semantic: Record<string, unknown>, options: McpRequestOptions & { allowMissing?: boolean } = {}): Promise<MappedCall> {
  const tool = findTool(tools, canonical);
  if (tool === null) return { toolFound: false, toolName: canonical, args: {}, missing: [], outcome: null };
  const mapped = mapArguments(tool, semantic);
  const name = tool.name ?? canonical;
  if (mapped.missing.length > 0 && options.allowMissing !== true) return { toolFound: true, toolName: name, args: mapped.args, missing: mapped.missing, outcome: null };
  const outcome = await client.callTool(name, mapped.args, options);
  return { toolFound: true, toolName: name, args: mapped.args, missing: mapped.missing, outcome };
}

/** Why a mapped call could not run, or null. */
function callSetupFailure(call: MappedCall, canonical: string): string | null {
  if (!call.toolFound) return `tools/list lists no ${canonical} tool`;
  if (call.missing.length > 0) return `the ${call.toolName} inputSchema requires ${call.missing.join(', ')}, which the suite has no value for`;
  return null;
}

/** Why a called tool failed, or null: a JSON-RPC error or a tool execution error, as its own words. */
function callFailure(call: MappedCall): string | null {
  const outcome = call.outcome;
  if (outcome === null) return `the ${call.toolName} call was not made`;
  if (outcome.error !== undefined) return `tools/call ${call.toolName} -> JSON-RPC ${outcome.error.code}: ${outcome.error.message}`;
  if (outcome.toolError) return `tools/call ${call.toolName} -> isError: ${resultText(outcome.toolResult).slice(0, 300)}`;
  return null;
}

/** A tool result's text blocks, joined (with structured content when the server sent it). */
function resultText(result: unknown): string {
  if (!isRecord(result)) return '';
  const parts: string[] = [];
  if (Array.isArray(result.content)) {
    for (const block of result.content) if (isRecord(block) && block.type === 'text' && typeof block.text === 'string') parts.push(block.text);
  }
  if (result.structuredContent !== undefined && result.structuredContent !== null) parts.push(JSON.stringify(result.structuredContent));
  return parts.join('\n');
}

/** The first JSON value a tool result holds (structured content first, else the first JSON in its text). */
function resultJson(result: unknown): unknown {
  if (!isRecord(result)) return null;
  if (result.structuredContent !== undefined && result.structuredContent !== null) return result.structuredContent;
  const text = resultText(result).trim();
  if (text === '') return null;
  try {
    return JSON.parse(text) as unknown;
  } catch {
    // a value wrapped in prose: the outermost braces or brackets
  }
  for (const [open, close] of [['{', '}'], ['[', ']']]) {
    const from = text.indexOf(open);
    const to = text.lastIndexOf(close);
    if (from >= 0 && to > from) {
      try {
        return JSON.parse(text.slice(from, to + 1)) as unknown;
      } catch {
        // not this one
      }
    }
  }
  return null;
}

/** A number out of a JSON value (`number`/`pull_number`/`id` fields), or null. */
function numberFrom(value: unknown, keys: readonly string[]): number | null {
  if (!isRecord(value)) return null;
  for (const key of keys) {
    const found = value[key];
    if (typeof found === 'number' && Number.isInteger(found)) return found;
    if (typeof found === 'string' && /^\d+$/.test(found)) return Number(found);
  }
  return null;
}

// ---------------------------------------------------------------- the REST side of the setup

interface RestAnswer {
  status: number;
  headers: Headers;
  text: string;
  json: unknown | null;
}

/** Encode one path segment (never a whole path: a contents path keeps its slashes). */
function encodeSegment(segment: string): string {
  return encodeURIComponent(segment);
}

/** Encode a repo-relative path segment by segment. */
function encodePath(path: string): string {
  return path.split('/').map(encodeSegment).join('/');
}

/** One REST call against the entry's /api/v3 surface, with the suite's token and the check's abort signal. */
async function restCall(ctx: CheckContext, method: string, path: string, body?: unknown): Promise<RestAnswer> {
  const base = ctx.baseUrl.replace(/\/+$/, '');
  const url = `${base}/api/v3${path}`;
  const controller = new AbortController();
  const timeoutMs = requestTimeoutOf(ctx);
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  const onAbort = (): void => controller.abort();
  if (ctx.signal.aborted) throw new SetupFailure(`${method} ${path} was not sent: the check's budget is spent`);
  ctx.signal.addEventListener('abort', onAbort, { once: true });
  const headers: Record<string, string> = { accept: 'application/json', 'user-agent': 'makefun-github-core-clone-env' };
  if (body !== undefined) headers['content-type'] = 'application/json';
  if (ctx.token !== '') headers.authorization = `Bearer ${ctx.token}`;
  try {
    const response = await fetch(url, { method, headers, body: body === undefined ? undefined : JSON.stringify(body), signal: controller.signal, redirect: 'manual' });
    let text = '';
    try {
      text = await response.text();
    } catch (error) {
      if (ctx.signal.aborted) throw new SetupFailure(`${method} ${path}: the check's budget ran out while reading the answer`);
      throw new SetupFailure(`${method} ${path}: reading the answer failed: ${messageOf(error)}`);
    }
    let json: unknown | null = null;
    if (text.trim() !== '') {
      try {
        json = JSON.parse(text) as unknown;
      } catch {
        json = null;
      }
    }
    return { status: response.status, headers: response.headers, text, json };
  } catch (error) {
    if (error instanceof SetupFailure) throw error;
    if (ctx.signal.aborted) throw new SetupFailure(`${method} ${path}: the check's budget ran out`);
    if (controller.signal.aborted) throw new SetupFailure(`${method} ${path} did not answer inside ${timeoutMs} ms`);
    throw new SetupFailure(`${method} ${path} failed: ${messageOf(error)}`);
  } finally {
    clearTimeout(timer);
    ctx.signal.removeEventListener('abort', onAbort);
  }
}

/** The message a REST error body carries, for a detail (never a token). */
function restMessage(json: unknown): string {
  if (isRecord(json) && typeof json.message === 'string' && json.message !== '') return `: ${json.message}`;
  return '';
}

/** Whether a REST status is a success. */
function restOk(status: number): boolean {
  return status >= 200 && status < 300;
}

interface RepoSetup {
  owner: string;
  repo: string;
  defaultBranch: string;
}

/** The token's own login (GET /api/v3/user), falling back on the scenario's viewer when the route refuses. */
async function resolveOwner(ctx: CheckContext): Promise<string> {
  const answer = await restCall(ctx, 'GET', '/user');
  if (answer.status === 200 && isRecord(answer.json) && typeof answer.json.login === 'string' && answer.json.login !== '') return answer.json.login;
  return ctx.scenario.viewer.login;
}

/** Create a repository over REST for a check's setup, and learn its default branch. */
async function createSetupRepo(ctx: CheckContext, name: string): Promise<RepoSetup> {
  const owner = await resolveOwner(ctx);
  const created = await restCall(ctx, 'POST', '/user/repos', { name, private: true, description: 'github-core-clone-01 MCP setup' });
  if (!restOk(created.status)) throw new SetupFailure(`POST /api/v3/user/repos (${name}) -> HTTP ${created.status}${restMessage(created.json)}`);
  let defaultBranch = isRecord(created.json) && typeof created.json.default_branch === 'string' && created.json.default_branch !== '' ? created.json.default_branch : '';
  const view = await restCall(ctx, 'GET', `/repos/${encodeSegment(owner)}/${encodeSegment(name)}`);
  if (defaultBranch === '' && view.status === 200 && isRecord(view.json) && typeof view.json.default_branch === 'string' && view.json.default_branch !== '') defaultBranch = view.json.default_branch;
  return { owner, repo: name, defaultBranch: defaultBranch === '' ? 'main' : defaultBranch };
}

/** A file write through the contents API (create on a branch when `branch` is given); `contentBase64` is wire-ready. */
async function putFile(ctx: CheckContext, setup: RepoSetup, path: string, contentBase64: string, message: string, branch?: string): Promise<RestAnswer> {
  const body: Record<string, unknown> = { message, content: contentBase64 };
  if (branch !== undefined) body.branch = branch;
  return restCall(ctx, 'PUT', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/contents/${encodePath(path)}`, body);
}

/** The sha a ref or branch points at (the Git Data and branches views both answer it, in their own shapes). */
async function refSha(ctx: CheckContext, setup: RepoSetup, branch: string): Promise<string | null> {
  for (const path of [`/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/git/refs/heads/${encodeSegment(branch)}`, `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/branches/${encodeSegment(branch)}`]) {
    const answer = await restCall(ctx, 'GET', path);
    if (answer.status !== 200 || !isRecord(answer.json)) continue;
    const candidates = [isRecord(answer.json.object) ? answer.json.object.sha : undefined, answer.json.sha, isRecord(answer.json.commit) ? answer.json.commit.sha : undefined];
    for (const candidate of candidates) if (typeof candidate === 'string' && candidate !== '') return candidate;
  }
  return null;
}

/** Whether a branch exists (a ref or a branch read answers 200). */
async function branchExists(ctx: CheckContext, setup: RepoSetup, branch: string): Promise<boolean> {
  const paths = [`/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/git/refs/heads/${encodeSegment(branch)}`, `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/branches/${encodeSegment(branch)}`];
  for (const path of paths) {
    const answer = await restCall(ctx, 'GET', path);
    if (answer.status === 200) return true;
  }
  return false;
}

/** A repository with a base commit and a head branch that carries one commit more. */
interface PullRequestSetup extends RepoSetup {
  base: string;
  head: string;
}

/**
 * Prepare a pull request's setup over REST: create the repository, commit a file on its default branch, then
 * create the head branch — through the Git Data API's POST /git/refs, or (when the server does not serve it)
 * through a contents write on the branch, whichever creates the ref. Both routes are stated in the rules.
 */
async function preparePullRequest(ctx: CheckContext, setup: RepoSetup, data: SeededData, part: string): Promise<PullRequestSetup> {
  const base = setup.defaultBranch;
  const basePath = data.filePath(part, 'base');
  const baseWrite = await putFile(ctx, setup, basePath, data.blob(0).base64, data.commitMessage(0));
  if (!restOk(baseWrite.status)) throw new SetupFailure(`PUT contents/${basePath} -> HTTP ${baseWrite.status}${restMessage(baseWrite.json)} (a PR needs a base commit)`);
  const head = data.branch(part);
  const baseSha = commitSha(baseWrite.json) ?? (await refSha(ctx, setup, base));
  let headReady = false;
  if (baseSha !== null) {
    const ref = await restCall(ctx, 'POST', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/git/refs`, { ref: `refs/heads/${head}`, sha: baseSha });
    headReady = restOk(ref.status);
  }
  const headPath = data.filePath(part, 'head');
  if (!headReady) {
    const write = await putFile(ctx, setup, headPath, data.blob(1).base64, data.commitMessage(1), head);
    if (!restOk(write.status)) {
      const refNote = baseSha === null ? 'POST /git/refs: no base commit sha to point it at' : 'POST /git/refs: refused';
      throw new SetupFailure(`could not create the branch ${head} (${refNote}; PUT contents with branch=${head} -> HTTP ${write.status}${restMessage(write.json)})`);
    }
    headReady = await branchExists(ctx, setup, head);
    if (!headReady) throw new SetupFailure(`PUT contents with branch=${head} answered HTTP ${write.status} but the branch does not exist`);
  } else {
    const write = await putFile(ctx, setup, headPath, data.blob(1).base64, data.commitMessage(1), head);
    if (!restOk(write.status)) throw new SetupFailure(`PUT contents/${headPath} on ${head} -> HTTP ${write.status}${restMessage(write.json)}`);
  }
  return { ...setup, base, head };
}

/** A contents answer's commit sha, when it carries one. */
function commitSha(json: unknown): string | null {
  if (!isRecord(json) || !isRecord(json.commit)) return null;
  return typeof json.commit.sha === 'string' && json.commit.sha !== '' ? json.commit.sha : null;
}

/** The issues a list answer holds, whichever shape the server uses. */
function issuesOf(json: unknown): unknown[] {
  if (Array.isArray(json)) return json;
  if (isRecord(json) && Array.isArray(json.issues)) return json.issues;
  if (isRecord(json) && Array.isArray(json.items)) return json.items;
  return [];
}

/** The pull requests a list answer holds. */
function pullsOf(json: unknown): unknown[] {
  if (Array.isArray(json)) return json;
  if (isRecord(json) && Array.isArray(json.pulls)) return json.pulls;
  if (isRecord(json) && Array.isArray(json.items)) return json.items;
  return [];
}

/** The pull request object at GET /pulls/{number}, or null. */
async function readPull(ctx: CheckContext, setup: RepoSetup, number: number): Promise<unknown | null> {
  const answer = await restCall(ctx, 'GET', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/pulls/${number}`);
  return answer.status === 200 ? answer.json : null;
}

/** A pull request's ref name (`head.ref`, `head.label`'s last segment, or `head` itself). */
function refOf(value: unknown): string | null {
  if (typeof value === 'string') return value;
  if (!isRecord(value)) return null;
  if (typeof value.ref === 'string') return value.ref;
  if (typeof value.branch === 'string') return value.branch;
  if (typeof value.label === 'string') return value.label.split(':').pop() ?? null;
  return null;
}

/** Find a pull request by number (from the tool result) or, failing that, by title/head in the list. */
async function findPull(ctx: CheckContext, setup: RepoSetup, wanted: { number: number | null; title: string; head: string }): Promise<unknown | null> {
  if (wanted.number !== null) {
    const direct = await readPull(ctx, setup, wanted.number);
    if (direct !== null) return direct;
  }
  const list = await restCall(ctx, 'GET', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/pulls?state=all&per_page=100`);
  if (list.status !== 200) return null;
  for (const pull of pullsOf(list.json)) {
    if (!isRecord(pull)) continue;
    if (pull.title === wanted.title || refOf(pull.head) === wanted.head) return pull;
  }
  return null;
}

// ---------------------------------------------------------------- the checks

/** The check list: exactly the 15 the manifest's `mcp` group declares (validateCheckSpecs proves the count). */
export const MCP_CHECKS: readonly CheckSpec[] = Object.freeze([
  {
    id: checkId('mcp', 'initialize'),
    group: MCP_GROUP,
    title: 'initialize: serverInfo.name/version and capabilities.tools, over whichever era the server negotiates',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        const info: McpConnectionInfo = await client.connect();
        const name = info.serverInfo?.name;
        const version = info.serverInfo?.version;
        if (typeof name !== 'string' || name.trim() === '') return fail(`the server identity has no name (era ${info.era}, revision ${info.protocolVersion})`);
        if (typeof version !== 'string' || version.trim() === '') return fail(`the server identity has no version (era ${info.era}, revision ${info.protocolVersion})`);
        if (!isRecord(info.capabilities.tools)) return fail(`capabilities.tools is missing (era ${info.era}, revision ${info.protocolVersion})`);
        return pass(`${info.era === 'modern' ? 'server/discover' : 'initialize'}: ${name} ${version}, protocol ${info.protocolVersion}, tools capability present`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'server-discover'),
    group: MCP_GROUP,
    title: 'server/discover: a DiscoverResult with supportedVersions, or the pre-discover era',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        const info: McpConnectionInfo = await client.connect();
        const probe: McpDiscoverAttempt | null = client.discoverAttempt;
        if (info.era === 'modern') {
          if (info.supportedVersions.length === 0) return fail('server/discover answered without a supportedVersions list');
          return pass(`server/discover: supportedVersions ${info.supportedVersions.join(', ')}; negotiated ${info.protocolVersion}`);
        }
        // A pre-discover server may refuse an unknown method in any of its own ways (404, -32601, an HTML 400);
        // what makes it legal is that the initialize handshake then worked, which connect() proved.
        const how = probe === null ? 'no answer' : probe.status === 404 ? 'HTTP 404' : probe.errorCode !== null ? `HTTP ${probe.status ?? 'none'}, JSON-RPC ${probe.errorCode}` : `HTTP ${probe.status ?? 'none'}`;
        return pass(`pre-discover revision (${how}; the server answers initialize)`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'tools-list'),
    group: MCP_GROUP,
    title: 'tools/list: at least six tools, all six required ones present by name or obvious alias',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        if (tools.length < 6) return fail(`tools/list returned ${tools.length} tools, fewer than six`);
        const found: string[] = [];
        const missing: string[] = [];
        for (const canonical of MCP_REQUIRED_TOOLS) {
          const tool = findTool(tools, canonical);
          if (tool !== null) found.push(`${canonical}->${tool.name}`);
          else missing.push(canonical);
        }
        if (missing.length > 0) return fail(`tools/list is missing ${missing.join(', ')} (${tools.length} tools; found ${found.join(', ') || 'none'})`);
        return pass(`${tools.length} tools; all six present: ${found.join(', ')}`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'tool-schemas'),
    group: MCP_GROUP,
    title: 'every tool has a non-empty description and an inputSchema of type object',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        if (tools.length === 0) return fail('tools/list returned no tools to inspect');
        const bad: string[] = [];
        for (const tool of tools) {
          const label = typeof tool.name === 'string' && tool.name !== '' ? tool.name : '(unnamed)';
          if (typeof tool.description !== 'string' || tool.description.trim() === '') bad.push(`${label}: no description`);
          if (!isRecord(tool.inputSchema) || tool.inputSchema.type !== 'object') bad.push(`${label}: inputSchema.type is not object`);
        }
        if (bad.length > 0) return fail(`${bad.slice(0, 4).join('; ')}${bad.length > 4 ? ` (+${bad.length - 4} more)` : ''}`);
        return pass(`all ${tools.length} tools have a description and an object inputSchema`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'create-issue'),
    group: MCP_GROUP,
    title: 'tools/call create_issue creates an issue the REST surface lists',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const setup = await createSetupRepo(ctx, data.repo('issue-create'));
        const issue = data.issue(0);
        const call = await callToolByName(client, tools, 'create_issue', { owner: setup.owner, repo: setup.repo, title: issue.title, body: issue.body });
        const setupFailure = callSetupFailure(call, 'create_issue');
        if (setupFailure !== null) return fail(setupFailure);
        const failure = callFailure(call);
        if (failure !== null) return fail(failure);
        const listed = await restCall(ctx, 'GET', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/issues?state=all&per_page=100`);
        if (listed.status !== 200) return fail(`the REST view of the repository's issues answered HTTP ${listed.status}${restMessage(listed.json)}`);
        const issues = issuesOf(listed.json);
        const found = issues.find((entry) => isRecord(entry) && entry.title === issue.title);
        if (found === undefined) return fail(`the issue created over MCP is not visible over REST (${issues.length} issues listed, none titled "${issue.title}")`);
        return pass(`created issue #${String(isRecord(found) ? found.number : '?')} over MCP; REST lists it with the same title`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'list-issues'),
    group: MCP_GROUP,
    title: 'tools/call list_issues returns an issue the repository holds',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const setup = await createSetupRepo(ctx, data.repo('issue-list'));
        const issue = data.issue(1);
        const created = await restCall(ctx, 'POST', `/repos/${encodeSegment(setup.owner)}/${encodeSegment(setup.repo)}/issues`, { title: issue.title, body: issue.body });
        if (!restOk(created.status)) return fail(`POST /api/v3/repos/${setup.owner}/${setup.repo}/issues -> HTTP ${created.status}${restMessage(created.json)}`);
        const number = numberFrom(created.json, ['number']);
        const call = await callToolByName(client, tools, 'list_issues', { owner: setup.owner, repo: setup.repo, state: 'open' });
        const setupFailure = callSetupFailure(call, 'list_issues');
        if (setupFailure !== null) return fail(setupFailure);
        const failure = callFailure(call);
        if (failure !== null) return fail(failure);
        const text = resultText(call.outcome?.toolResult ?? null);
        const foundByTitle = text.includes(issue.title);
        const foundByNumber = number !== null && new RegExp(`"number"\\s*:\\s*${number}(?!\\d)`).test(text);
        if (!foundByTitle && !foundByNumber) return fail(`list_issues did not return ${number === null ? 'the issue' : `issue #${number}`} ("${issue.title}") the repository holds`);
        return pass(`list_issues returned ${number === null ? 'the issue' : `issue #${number}`} (${foundByTitle ? 'by title' : 'by number'})`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'create-pull-request'),
    group: MCP_GROUP,
    title: 'tools/call create_pull_request opens a pull request REST reads back with the same head and base',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const setup = await createSetupRepo(ctx, data.repo('pr-create'));
        const prepared = await preparePullRequest(ctx, setup, data, 'pr-create');
        const template = data.pull(0);
        const call = await callToolByName(client, tools, 'create_pull_request', { owner: prepared.owner, repo: prepared.repo, title: template.title, body: template.body, head: prepared.head, base: prepared.base });
        const setupFailure = callSetupFailure(call, 'create_pull_request');
        if (setupFailure !== null) return fail(setupFailure);
        const failure = callFailure(call);
        if (failure !== null) return fail(failure);
        const number = numberFrom(resultJson(call.outcome?.toolResult ?? null), ['number', 'pull_number', 'pull_request_number']);
        const pull = await findPull(ctx, prepared, { number, title: template.title, head: prepared.head });
        if (pull === null || !isRecord(pull)) return fail('the pull request created over MCP is not visible over REST');
        if (refOf(pull.head) !== prepared.head) return fail(`REST reads head ${String(refOf(pull.head))}, not ${prepared.head}`);
        if (refOf(pull.base) !== prepared.base) return fail(`REST reads base ${String(refOf(pull.base))}, not ${prepared.base}`);
        return pass(`pull request #${String(pull.number ?? number ?? '?')} created over MCP; REST reads ${prepared.head} into ${prepared.base}, state ${String(pull.state ?? '?')}`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'merge-pull-request'),
    group: MCP_GROUP,
    title: 'tools/call merge_pull_request merges; REST reads merged:true',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const setup = await createSetupRepo(ctx, data.repo('pr-merge'));
        const prepared = await preparePullRequest(ctx, setup, data, 'pr-merge');
        const template = data.pull(1);
        const created = await restCall(ctx, 'POST', `/repos/${encodeSegment(prepared.owner)}/${encodeSegment(prepared.repo)}/pulls`, { title: template.title, head: prepared.head, base: prepared.base });
        if (!restOk(created.status)) return fail(`POST pulls (setup) -> HTTP ${created.status}${restMessage(created.json)}`);
        const number = numberFrom(created.json, ['number']);
        if (number === null) return fail('POST pulls answered no pull request number');
        const call = await callToolByName(client, tools, 'merge_pull_request', { owner: prepared.owner, repo: prepared.repo, pull_number: number });
        const setupFailure = callSetupFailure(call, 'merge_pull_request');
        if (setupFailure !== null) return fail(setupFailure);
        const failure = callFailure(call);
        if (failure !== null) return fail(failure);
        const pull = await readPull(ctx, prepared, number);
        if (!isRecord(pull)) return fail(`REST does not read pull request #${number} after the merge`);
        if (pull.merged !== true) return fail(`REST reads merged=${String(pull.merged)}, state=${String(pull.state)} after merge_pull_request`);
        return pass(`pull request #${number} merged over MCP; REST reads merged:true, state ${String(pull.state ?? '?')}`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'unknown-tool'),
    group: MCP_GROUP,
    title: 'an unknown tool name answers JSON-RPC -32602 or -32601, never HTTP 500',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const data = dataFor(ctx.scenario);
        const outcome = await client.request('tools/call', { name: `mcp_no_such_tool_${data.tag}`, arguments: {} });
        if (outcome.status === 500) return fail('tools/call with an unknown tool name answered HTTP 500');
        if (outcome.error !== undefined) {
          if (outcome.error.code === JSON_RPC_INVALID_PARAMS || outcome.error.code === -32601) return pass(`HTTP ${outcome.status}, JSON-RPC ${outcome.error.code}: ${outcome.error.message}`);
          return fail(`tools/call with an unknown tool name answered JSON-RPC ${outcome.error.code}: ${outcome.error.message}`);
        }
        return fail(`tools/call with an unknown tool name answered a result (HTTP ${outcome.status}), not a JSON-RPC error`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'parse-error'),
    group: MCP_GROUP,
    title: 'a body that is not JSON answers HTTP 400 with JSON-RPC -32700',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        const info = await client.connect();
        const answer = await client.postRaw('{"jsonrpc": "2.0", "id": 424242, "method": "tools/list"', { methodHeader: 'tools/list', expectedId: 424242 });
        const code = answer.rpc?.error?.code ?? null;
        if (code === JSON_RPC_PARSE_ERROR && answer.status === 400) return pass('HTTP 400, JSON-RPC -32700 parse error');
        if (code === JSON_RPC_PARSE_ERROR && answer.status === 200 && info.era === 'legacy') return pass('HTTP 200, JSON-RPC -32700 parse error (the pre-2026-07-28 transport status)');
        return fail(`a malformed body answered HTTP ${answer.status}, ${code === null ? 'no JSON-RPC error' : `JSON-RPC ${code}`}`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'missing-arguments'),
    group: MCP_GROUP,
    title: 'tools/call with missing required arguments answers isError:true or JSON-RPC -32602',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const call = await callToolByName(client, tools, 'create_issue', {}, { allowMissing: true });
        if (!call.toolFound) return fail('tools/list lists no create_issue tool');
        const outcome = call.outcome;
        if (outcome === null) return fail('the create_issue call was not made');
        if (outcome.error !== undefined) {
          if (outcome.error.code === JSON_RPC_INVALID_PARAMS) return pass('JSON-RPC -32602 invalid params');
          return fail(`tools/call create_issue without required arguments answered JSON-RPC ${outcome.error.code}: ${outcome.error.message}`);
        }
        if (outcome.toolError) return pass('isError:true');
        return fail(`tools/call create_issue with no arguments was accepted (HTTP ${outcome.status}, isError=${String(outcome.toolResult?.isError)})`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'concurrent-calls'),
    group: MCP_GROUP,
    title: 'two concurrent tool calls answer under their own ids and their own objects',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const left = await createSetupRepo(ctx, data.repo('concurrent-left'));
        const right = await createSetupRepo(ctx, data.repo('concurrent-right'));
        const leftTool = findTool(tools, 'get_repo');
        if (leftTool === null) return fail('tools/list lists no get_repo tool');
        const leftMapped = mapArguments(leftTool, { owner: left.owner, repo: left.repo });
        const rightMapped = mapArguments(leftTool, { owner: right.owner, repo: right.repo });
        if (leftMapped.missing.length > 0) return fail(`the get_repo inputSchema requires ${leftMapped.missing.join(', ')}, which the suite has no value for`);
        if (rightMapped.missing.length > 0) return fail(`the get_repo inputSchema requires ${rightMapped.missing.join(', ')}, which the suite has no value for`);
        const leftId = `concurrent-left-${data.tag}`;
        const rightId = `concurrent-right-${data.tag}`;
        const [leftAnswer, rightAnswer] = await Promise.all([
          client.callTool(leftTool.name ?? 'get_repo', leftMapped.args, { id: leftId }),
          client.callTool(leftTool.name ?? 'get_repo', rightMapped.args, { id: rightId }),
        ]);
        if (leftAnswer.matchedId !== leftId) return fail(`the answer for id ${leftId} carried id ${String(leftAnswer.matchedId)}`);
        if (rightAnswer.matchedId !== rightId) return fail(`the answer for id ${rightId} carried id ${String(rightAnswer.matchedId)}`);
        if (leftAnswer.error !== undefined || rightAnswer.error !== undefined) return fail(`a concurrent call failed: ${leftAnswer.error?.message ?? rightAnswer.error?.message ?? 'unknown'}`);
        const leftText = resultText(leftAnswer.toolResult);
        const rightText = resultText(rightAnswer.toolResult);
        if (!leftText.includes(left.repo)) return fail(`the answer to ${leftId} does not name ${left.repo}`);
        if (!rightText.includes(right.repo)) return fail(`the answer to ${rightId} does not name ${right.repo}`);
        return pass(`two concurrent tools/call answers kept their ids (${leftId}, ${rightId}) and their own repositories`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'tools-list-idempotent'),
    group: MCP_GROUP,
    title: 'two tools/list answers hold the same tools array, byte for byte',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const first = await client.listTools();
        const second = await client.listTools();
        if (first.length !== second.length) return fail(`tools/list changed between two calls (${first.length} vs ${second.length} tools)`);
        const left = JSON.stringify(first);
        const right = JSON.stringify(second);
        if (left !== right) return fail(`tools/list changed between two calls (${first.length} tools, a different list)`);
        return pass(`${first.length} tools, byte-identical over two calls`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'rest-parity'),
    group: MCP_GROUP,
    title: 'a repository and an issue created over MCP are the same objects over REST, ids stable',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const tools = await client.listTools();
        const data = dataFor(ctx.scenario);
        const repoName = data.repo('parity');
        let owner = await resolveOwner(ctx);
        const createdRepo = await callToolByName(client, tools, 'create_repo', { owner, name: repoName, description: ctx.scenario.repos[0]!.description, private: true });
        const setupFailure = callSetupFailure(createdRepo, 'create_repo');
        if (setupFailure !== null) return fail(setupFailure);
        const repoFailure = callFailure(createdRepo);
        if (repoFailure !== null) return fail(repoFailure);
        const repoJson = resultJson(createdRepo.outcome?.toolResult ?? null);
        let repo = repoName;
        const fullName = isRecord(repoJson) && typeof repoJson.full_name === 'string' ? repoJson.full_name : null;
        if (fullName !== null && fullName.includes('/')) {
          const [namedOwner, namedRepo] = fullName.split('/', 2);
          if (namedOwner !== '' && namedRepo !== '') {
            owner = namedOwner;
            repo = namedRepo;
          }
        }
        const repoPath = `/repos/${encodeSegment(owner)}/${encodeSegment(repo)}`;
        const firstRepo = await restCall(ctx, 'GET', repoPath);
        if (firstRepo.status !== 200) return fail(`GET ${repoPath} -> HTTP ${firstRepo.status} after create_repo${restMessage(firstRepo.json)}`);
        const secondRepo = await restCall(ctx, 'GET', repoPath);
        const repoId = isRecord(firstRepo.json) ? firstRepo.json.id : undefined;
        const secondRepoId = isRecord(secondRepo.json) ? secondRepo.json.id : undefined;
        if (repoId === undefined || repoId === null) return fail('the REST repository object has no id');
        if (String(repoId) !== String(secondRepoId)) return fail(`the REST repository id changed between reads (${String(repoId)} then ${String(secondRepoId)})`);
        const issue = data.issue(2);
        const createdIssue = await callToolByName(client, tools, 'create_issue', { owner, repo, title: issue.title, body: issue.body });
        const issueSetupFailure = callSetupFailure(createdIssue, 'create_issue');
        if (issueSetupFailure !== null) return fail(issueSetupFailure);
        const issueFailure = callFailure(createdIssue);
        if (issueFailure !== null) return fail(issueFailure);
        let number = numberFrom(resultJson(createdIssue.outcome?.toolResult ?? null), ['number']);
        if (number === null) {
          const listed = await restCall(ctx, 'GET', `${repoPath}/issues?state=all&per_page=100`);
          if (listed.status === 200) {
            for (const entry of issuesOf(listed.json)) if (isRecord(entry) && entry.title === issue.title && typeof entry.number === 'number') number = entry.number;
          }
        }
        if (number === null) return fail('the issue created over MCP has no number REST can read');
        const issuePath = `${repoPath}/issues/${number}`;
        const firstIssue = await restCall(ctx, 'GET', issuePath);
        if (firstIssue.status !== 200) return fail(`GET ${issuePath} -> HTTP ${firstIssue.status} after create_issue`);
        const secondIssue = await restCall(ctx, 'GET', issuePath);
        const issueId = isRecord(firstIssue.json) ? firstIssue.json.id : undefined;
        const secondIssueId = isRecord(secondIssue.json) ? secondIssue.json.id : undefined;
        const issueReadTitle = isRecord(firstIssue.json) ? firstIssue.json.title : undefined;
        if (issueId === undefined || issueId === null) return fail('the REST issue object has no id');
        if (String(issueId) !== String(secondIssueId)) return fail(`the REST issue id changed between reads (${String(issueId)} then ${String(secondIssueId)})`);
        if (issueReadTitle !== issue.title) return fail(`the REST issue title is ${String(issueReadTitle)}, not ${issue.title}`);
        return pass(`repo ${owner}/${repo} id ${String(repoId)} and issue #${number} id ${String(issueId)} are the same objects over MCP and REST, stable across reads`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
  {
    id: checkId('mcp', 'auth-required'),
    group: MCP_GROUP,
    title: 'a tools/call with no Authorization header answers HTTP 401',
    async fn(ctx: CheckContext) {
      const client = newClient(ctx);
      try {
        await client.connect();
        const data = dataFor(ctx.scenario);
        const issue = data.issue(3);
        // The resolved name when the server lists one (a prefixed tool is still the same tool); otherwise the
        // canonical name: authentication is decided before any tool exists, so the refusal must be 401 either way.
        const tools = await client.listTools().catch(() => [] as McpTool[]);
        const name = findTool(tools, 'create_issue')?.name ?? 'create_issue';
        const outcome = await client.callTool(name, { owner: 'no-auth', repo: `no-auth-${data.tag}`, title: issue.title, body: issue.body }, { omitAuth: true });
        if (outcome.status === 401) return pass('unauthenticated tools/call -> HTTP 401');
        return fail(`unauthenticated tools/call -> HTTP ${outcome.status}${outcome.error !== undefined ? ` (JSON-RPC ${outcome.error.code})` : ''}`);
      } catch (error) {
        return fail(detailOf(error));
      } finally {
        await client.close();
      }
    },
  },
]);

/** The 15 check ids, in run order (the manifest's `mcp` group, exactly). */
export const MCP_CHECK_IDS = Object.freeze(MCP_CHECKS.map((check) => check.id));

/** The group module's list under the name the other group modules use. */
export const CHECKS = MCP_CHECKS;

/** Run every MCP check in order, one at a time: the SDK runner's and a local test's convenience. */
export async function runMcpChecks(ctx: CheckContext): Promise<Array<{ id: string; group: string; title: string; result: { ok: boolean; detail?: string } }>> {
  const results: Array<{ id: string; group: string; title: string; result: { ok: boolean; detail?: string } }> = [];
  for (const check of MCP_CHECKS) {
    let result: { ok: boolean; detail?: string };
    try {
      result = await check.fn(ctx);
    } catch (error) {
      result = fail(detailOf(error));
    }
    logLine(ctx, `${check.id}: ${result.ok ? 'pass' : 'fail'}${result.detail === undefined ? '' : ` — ${result.detail}`}`);
    results.push({ id: check.id, group: check.group, title: check.title, result });
  }
  return results;
}
// github-core-clone-01's benchmark: the four timed workloads, their rounds, and the perf.json the
// scorer reads (wire.ts PerfFile; manifest.ts BENCH_WORKLOADS, T_REF_MS and the tier formula).
//
// WHAT A TRIAL DOES HERE
//   Four workloads, each a fixed amount of work against the entry, measured with the monotonic clock
//   (performance.now) as the wall time of one round; three rounds a workload (manifest.ts
//   BENCH_ROUNDS), after BENCH_WARMUP_OPS untimed operations. The workload's p50 is the median round.
//     push   200 sequential pushes of a 1 KiB change to one repository: every operation is one
//            receive-pack exchange (advertisement + command list + pack) that creates a new commit on
//            refs/heads/main. Every payload (blob, tree, commit and its pack) is built before the
//            first timing starts, so no object hashing or deflating is ever timed. The whole chain for
//            warm-ups and rounds exists up front; a round walks the next `ops` entries.
//     clone  50 concurrent shallow clones (depth 1) of a 200-commit repository. The history is
//            created once in setup (one push carrying all 200 commits); each clone verifies its
//            pack's checksum but does not parse the objects (parse: false: object parsing is the
//            conformance checks' work, and a benchmark should not measure this client).
//     read   2,000 sequential GET /api/v3/repos/{owner}/{repo}/issues/{number} on one warm
//            keep-alive connection (the same RestClient, whose undici pool reuses the socket).
//     write  200 sequential POST /api/v3/repos/{owner}/{repo}/issues.
//   Setup (repository creation, the clone history, the read workload's issue) happens inside the
//   workload's budget but outside every timed round. A workload whose setup fails is 0 points.
//
// TIME DISCIPLINE (never let a slow entry push the trial past its deadline)
//   Every workload gets the smaller of manifest.ts budgetMs (60 s) and what is left of the benchmark
//   phase (BENCH_PHASE_BUDGET_MS, 240 s, from the first call) and of the env's internal deadline
//   (options.deadlineMs). A timer aborts its in-flight requests at that instant, every operation is
//   checked against the clock before it starts, and the phase stops handing out time when it is gone.
//   A workload that throws, or that does not complete all its rounds inside its budget, earns 0
//   points and stops early. ROUNDS THAT COMPLETED BEFORE THE FAILURE ARE STILL RECORDED in `rounds`,
//   but its p50_ms and p99_ms are the sentinel FAILED_P50_MS (1e9), never a measured number: the
//   scorer floors a measured run at 1 us, so a 0 would sort FIRST on the tie-break, and a partial
//   measurement must not win one either.
//
// THE TWO SCORER RULINGS THIS FILE IMPLEMENTS
//   1. A workload that did not run or was cut by a deadline writes p50_ms = 1e9 and points = 0.
//      When NO workload measured, perf_p50_us is the sentinel 1e9 (the scorer's largest accepted
//      integer, scorer/columns.ts AGENT_MAX_POINTS); otherwise it is round(1000 * the geometric mean
//      of the p50_ms of the workloads that DID measure). The sentinel p50s never enter the mean: 1e9
//      ms would be 1e12 us and the scorer refuses anything past 1e9.
//   2. The per-round field is `rounds` (a number[] of ms), and the totals are `points_total` and
//      `perf_p50_us`. The scorer reads exactly those; `tiers` and `points` are wire.ts's own maps.
//
// THE FILE IT PRODUCES (wire.ts PerfFile, version PERF_VERSION, canonical JSON via
// canonicalJsonLine, at perfFilePath(stateDir) by the caller):
//   {
//     "version": 1,
//     "calibrated": <every T_ref > 0>,
//     "workloads": [
//       { "name": "push"|"clone"|"read"|"write",
//         "rounds": [each completed round's wall ms],
//         "p50_ms": <median round, or 1e9 when failed/cut>,
//         "p99_ms": <largest of 3, or 1e9 when failed/cut>,
//         "ops": <manifest.ts ops>,
//         "points": <0..50, the tier formula, or 0 uncalibrated/failed>,
//         "error": <why it earned 0, when it did; omitted otherwise> }
//     ],
//     "tiers": { "push": 0..4, ... },       // floor(points / 12.5), wire.ts PerfTier
//     "points": { "push": 0..50, ... },
//     "perf_p50_us": <tie-break, or 1e9 when nothing measured>,
//     "points_total": <0..200, the perf column>,
//     "notes": [fixed lines: uncalibrated T_ref names, per-workload failures; no free text]
//   }
//   A per-workload `points` is always recomputed from its p50_ms and T_ref (manifest.ts
//   workloadPoints) when the file is assembled, so a caller cannot hand it a point it did not earn.
//
// POINTS AND T_ref
//   points = round(clamp(25 - 12.5*log2(p50_ms / T_ref_ms), 0, 50)); T_ref_ms > 0 comes from
//   manifest.ts T_REF_MS, which calibration (#18) fills from the house reference forge's measured
//   medians. While a T_ref is 0 the workload still runs (the measurement is what calibration needs)
//   but earns 0 points, the file says `calibrated: false`, and its error line says "uncalibrated".
//
// HOW main.ts CALLS IT (env/src/main.ts, #14; export.ts writes the result)
//   const perf = await runBenchmark({
//     baseUrl: entry.url,                  // wire.ts EntryBase.url, no trailing slash
//     token: process.env[TOKEN_ENV] ?? '', // wire.ts TOKEN_ENV
//     signal: trialAbort.signal,           // the trial's abort (SIGTERM)
//     deadlineMs: deadline.deadlineMs,     // wire.ts deadlineOf(): the env's internal deadline
//     log: (line) => process.stderr.write(`${line}\n`),
//   });
//   writeFileSync(perfFilePath(stateDir), canonicalJsonLine(perf));
//   runBenchmark never throws for anything the entry does: a workload's failure is an `error` in its
//   entry, and a workload that never got time is an entry with p50 1e9 and 0 points. It throws only
//   for a caller's own mistake (no base URL, an unknown workload name).
//   A trial with no benchmark at all (a boot failure: no entry registered) writes
//   failedPerfFile('no entry registered before the boot deadline'): the four workloads as sentinels,
//   0 points and perf_p50_us 1e9, never wire.ts emptyPerfFile's 0 (a 0 would sort first on the
//   tie-break).
//
// WHAT THIS FILE DOES NOT DO
//   No filesystem, no process, no timer longer than a workload's budget, no Math.random and no
//   Date.now: all work data derives from the one seeded scenario (wire.ts buildScenario and a
//   'bench.*' stream of scenarioRng), and the clock is performance.now through options.now.
//   Nothing here is a pass/fail check: a slow entry fails the benchmark, not conformance.

import {
  BENCH_PHASE_BUDGET_MS,
  BENCH_ROUNDS,
  BENCH_WARMUP_OPS,
  BENCH_WORKLOADS,
  BENCH_WORKLOAD_NAMES,
  T_REF_MS,
  benchWorkload,
  isCalibrated,
  perfTieBreakUs,
  perfTiersOf,
  workloadPoints,
  type BenchWorkloadName,
  type BenchWorkloadSpec,
} from './manifest.ts';
import {
  CONFORMANCE_IDENTITY,
  GitClient,
  ZERO_OID,
  buildCommit,
  buildTree,
  hashObject,
  writePack,
  type GitObjectInput,
  type PushCommand,
  type PushResult,
} from './git-client.ts';
import { RestClient, apiPath, type RestResponse } from './rest-client.ts';
import {
  PERF_VERSION,
  buildScenario,
  generateBlobText,
  scenarioRng,
  type PerfFile,
  type PerfWorkload,
  type Scenario,
} from './wire.ts';

// ---------------------------------------------------------------- constants

/**
 * The p50_ms (and p99_ms) a workload writes when it did not run or was cut by a deadline. Not 0:
 * the scorer floors a measured run at 1 us, so a 0 would sort FIRST on the tie-break.
 */
export const FAILED_P50_MS = 1_000_000_000;
/**
 * perf_p50_us when no workload measured. Equal to the scorer's largest accepted integer
 * (scorer/columns.ts AGENT_MAX_POINTS, 1e9): the slowest honest tie-break, never 0.
 */
export const FAILED_PERF_P50_US = 1_000_000_000;

/** The repository each workload creates anew (deleted first, so a re-run starts clean). */
const PUSH_REPO = 'bench-push';
const CLONE_REPO = 'bench-clone';
const READ_REPO = 'bench-read';
const WRITE_REPO = 'bench-write';
/** The one file the push chain changes; every commit replaces its content with a fresh 1 KiB blob. */
const PUSH_FILE = 'bench-data.txt';
/** The one file the 200-commit clone history changes. */
const CLONE_FILE = 'history.txt';
/** Bytes of new content a push's commit carries ("a 1 KiB change"). */
const PUSH_CHANGE_BYTES = 1_024;
/** Bytes of the blob each clone-history commit carries. */
const CLONE_CHANGE_BYTES = 512;
/** How many commits the clone repository's history holds (the workload's "200-commit repository"). */
export const CLONE_HISTORY_COMMITS = 200;
/** A fixed epoch every generated commit timestamp derives from (never Date.now). */
const BENCH_EPOCH_SEC = 1_700_000_000;
/** The branch every workload's repository pushes to. */
const MAIN_REF = 'refs/heads/main';
/** The line an uncalibrated workload's error field and perf.json's notes carry. */
const UNCALIBRATED_ERROR = `uncalibrated: T_ref is 0, so the workload earns 0 points until calibration fills it`;

// ---------------------------------------------------------------- small utilities

/** `value` when it is a finite number, else `fallback`. */
function finiteOr(value: number | undefined, fallback: number): number {
  return typeof value === 'number' && Number.isFinite(value) ? value : fallback;
}

/** `value` as an integer in min..max, else `fallback`. */
function clampInt(value: number | undefined, min: number, max: number, fallback: number): number {
  if (typeof value !== 'number' || !Number.isFinite(value)) return fallback;
  return Math.min(max, Math.max(min, Math.trunc(value)));
}

/** One clock reading rounded to a thousandth of a millisecond (JSON stays small; the clock is ms). */
function roundMs(value: number): number {
  if (!Number.isFinite(value) || value <= 0) return 0;
  return Math.round(value * 1_000) / 1_000;
}

/** The nearest-rank percentile of `rounds`, in ms; FAILED_P50_MS when there is no round at all. */
export function percentileMs(rounds: readonly number[], percentile: number): number {
  if (rounds.length === 0) return FAILED_P50_MS;
  const sorted = [...rounds].sort((a, b) => a - b);
  const p = Number.isFinite(percentile) ? Math.min(100, Math.max(0, percentile)) : 50;
  const rank = Math.ceil((p / 100) * sorted.length);
  const index = Math.min(sorted.length - 1, Math.max(0, rank - 1));
  return sorted[index] ?? FAILED_P50_MS;
}

/** One line naming what a thrown value said (newlines flattened: perf.json's notes are lines). */
function errorLine(err: unknown): string {
  const flat = (text: string): string => text.replace(/\s+/g, ' ').trim();
  if (err instanceof Error) return flat(err.message) === '' ? err.name : `${err.name}: ${flat(err.message)}`;
  return flat(String(err));
}

// ---------------------------------------------------------------- a workload's measurement

/**
 * What one workload measured, before the tier formula turns it into a PerfWorkload. `error` means
 * the workload failed or was cut and its p50/p99 are the sentinel; `uncalibrated` means it measured
 * but its T_ref is 0, so its times stand and its points are 0.
 */
export interface WorkloadMeasurement {
  readonly name: BenchWorkloadName;
  /** Every round that finished before the workload failed, in order, ms. */
  readonly roundsMs: readonly number[];
  /** How many timed rounds the phase asked for (normally manifest.ts spec.rounds). */
  readonly expectedRounds: number;
  /** Why the workload earned no points, when it did not finish all its rounds. */
  readonly error?: string;
  /** Measured, but T_ref is 0: the times are kept, the points are 0. */
  readonly uncalibrated?: boolean;
}

/**
 * One workload's PerfWorkload: p50/p99 from its completed rounds, points from the tier formula
 * (manifest.ts workloadPoints), or p50/p99 = FAILED_P50_MS and 0 points when it failed or was cut
 * short. `tRef` is that workload's T_ref in ms (0 uncalibrated).
 */
export function finishWorkload(spec: BenchWorkloadSpec, measurement: WorkloadMeasurement, tRef: number): PerfWorkload {
  const expected = Math.max(1, Math.trunc(measurement.expectedRounds));
  const rounds = measurement.roundsMs.map(roundMs).filter((ms) => Number.isFinite(ms) && ms >= 0);
  const failed = measurement.error !== undefined || rounds.length !== expected;
  const p50 = failed ? FAILED_P50_MS : roundMs(percentileMs(rounds, 50));
  const p99 = failed ? FAILED_P50_MS : roundMs(percentileMs(rounds, 99));
  const points = failed || measurement.uncalibrated === true ? 0 : workloadPoints(p50, tRef);
  const why = measurement.error ?? (failed ? 'the workload did not finish all its rounds' : measurement.uncalibrated === true ? UNCALIBRATED_ERROR : undefined);
  const result: PerfWorkload = {
    name: spec.name,
    rounds,
    p50_ms: p50,
    p99_ms: p99,
    ops: spec.ops,
    points,
    ...(why !== undefined ? { error: why } : {}),
  };
  return result;
}

/**
 * perf.json from the four workloads' results. Recomputes every workload's points from its own p50
 * and T_ref (a failed workload is 0), sums the column, maps the tiers, and computes the tie-break:
 * the geometric mean of the workloads that measured, or FAILED_PERF_P50_US when none did.
 * `tRefs` is the full four-slot table; `extraNotes` are fixed lines (the uncalibrated names).
 */
export function perfFileOf(
  workloads: readonly PerfWorkload[],
  tRefs: Readonly<Record<BenchWorkloadName, number>> = T_REF_MS,
  extraNotes: readonly string[] = [],
): PerfFile {
  const normalized: PerfWorkload[] = workloads.map((workload) => {
    const name = workload.name as BenchWorkloadName;
    const tRef = finiteOr(tRefs[name], 0);
    const failed = workload.error !== undefined || !(Number.isFinite(workload.p50_ms) && workload.p50_ms < FAILED_P50_MS);
    const points = failed ? 0 : workloadPoints(workload.p50_ms, tRef);
    return {
      name: workload.name,
      rounds: workload.rounds.map(roundMs),
      p50_ms: workload.p50_ms,
      p99_ms: workload.p99_ms,
      ops: workload.ops,
      points,
      ...(workload.error !== undefined ? { error: workload.error } : {}),
    };
  });
  const points: Record<string, number> = {};
  const tiersInput: Record<string, number> = {};
  let pointsTotal = 0;
  for (const workload of normalized) {
    points[workload.name] = workload.points;
    tiersInput[workload.name] = workload.points;
    pointsTotal += workload.points;
  }
  const measured = normalized
    .filter((workload) => Number.isFinite(workload.p50_ms) && workload.p50_ms < FAILED_P50_MS)
    .map((workload) => Math.max(0, workload.p50_ms));
  const perfP50Us = measured.length === 0 ? FAILED_PERF_P50_US : Math.min(FAILED_PERF_P50_US, perfTieBreakUs(measured));
  const notes: string[] = [];
  for (const note of extraNotes) if (note !== '' && !notes.includes(note)) notes.push(note);
  for (const workload of normalized) {
    if (workload.error !== undefined) notes.push(`${workload.name}: ${workload.error}`);
  }
  if (measured.length === 0) notes.push(`no workload measured: perf_p50_us is the sentinel ${FAILED_PERF_P50_US}`);
  else if (measured.length < normalized.length) notes.push(`perf_p50_us is the geometric mean of the ${measured.length} workload(s) that measured`);
  return {
    version: PERF_VERSION,
    calibrated: isCalibrated(tRefs),
    workloads: normalized,
    tiers: perfTiersOf(tiersInput),
    points,
    perf_p50_us: perfP50Us,
    points_total: pointsTotal,
    notes,
  };
}

/**
 * The perf.json a trial with no benchmark at all writes (a boot failure: no entry ever registered).
 * Every workload is the sentinel with `error`, so points_total is 0 and perf_p50_us is the 1e9
 * tie-break, never wire.ts emptyPerfFile's 0 (a 0 would sort first on the tie-break). main.ts should
 * prefer this over emptyPerfFile whenever the benchmark never ran.
 */
export function failedPerfFile(
  error: string,
  tRefs: Readonly<Record<BenchWorkloadName, number>> = T_REF_MS,
  notes: readonly string[] = [],
): PerfFile {
  const why = error === '' ? 'the benchmark did not run' : error;
  const workloads = BENCH_WORKLOADS.map((spec) =>
    finishWorkload(spec, { name: spec.name, roundsMs: [], expectedRounds: spec.rounds, error: why }, 0),
  );
  return perfFileOf(workloads, tRefs, notes);
}

// ---------------------------------------------------------------- the run's own context

/** Thrown by a workload's own deadline/abort check; never escapes runBenchmark. */
class WorkloadStop extends Error {
  readonly reason: 'deadline' | 'aborted';

  constructor(reason: 'deadline' | 'aborted', message: string) {
    super(message);
    this.name = 'WorkloadStop';
    this.reason = reason;
  }
}

/** Everything one workload's body may read and must respect. */
interface WorkloadRun {
  readonly spec: BenchWorkloadSpec;
  readonly baseUrl: string;
  readonly token: string;
  readonly scenario: Scenario;
  readonly now: () => number;
  /** The absolute `now()` reading past which this workload's work is 0. */
  readonly deadlineAt: number;
  /** Aborted at deadlineAt and when the trial aborts: every client call carries it. */
  readonly signal: AbortSignal;
  /** Timed rounds the phase asked for (manifest.ts spec.rounds unless overridden). */
  readonly rounds: number;
  /** Untimed operations before the first round (manifest.ts warmupOps unless overridden). */
  readonly warmupOps: number;
  /** Completed rounds, ms, in order: a body pushes one after every round it finishes. */
  readonly roundsMs: number[];
  readonly log: (line: string) => void;
  /** Set when the workload's own timer fired (rather than the trial's abort). */
  expired: boolean;
  /** What is left of the workload's budget, ms, never negative. */
  remainingMs(): number;
  /** Throw WorkloadStop when the budget or the trial ran out; call before every operation. */
  check(): void;
}

/** The line a workload's deadline failure carries. */
function deadlineText(spec: BenchWorkloadSpec): string {
  return `deadline: the workload did not finish inside its ${spec.budgetMs} ms budget`;
}

// ---------------------------------------------------------------- seeded fixture data

/** A push operation's pre-built bytes: the command list entry and the pack that carries its objects. */
interface PushPayload {
  readonly command: PushCommand;
  readonly pack: Buffer;
}

/**
 * `count` push operations' command+pack, built before any timing starts. Each step creates one commit
 * on refs/heads/main whose tree holds PUSH_FILE with a fresh PUSH_CHANGE_BYTES seeded blob; the first
 * creates the branch (oldOid ZERO_OID), every later one updates it from the previous commit. The
 * pack carries only the three objects the server does not have (blob, tree, commit), so each exchange
 * is exactly "one 1 KiB change and its commit".
 */
function buildPushPayloads(count: number): PushPayload[] {
  const rng = scenarioRng('bench.push');
  const payloads: PushPayload[] = [];
  let parent: string | null = null;
  for (let index = 0; index < Math.max(0, Math.trunc(count)); index += 1) {
    const blob = Buffer.from(generateBlobText(rng, PUSH_CHANGE_BYTES), 'utf8');
    const blobOid = hashObject('blob', blob);
    const tree = buildTree([{ mode: '100644', name: PUSH_FILE, oid: blobOid }]);
    const treeOid = hashObject('tree', tree);
    const commit = buildCommit({
      tree: treeOid,
      parents: parent === null ? [] : [parent],
      message: `bench: push ${index + 1}\n`,
      author: CONFORMANCE_IDENTITY,
      committer: CONFORMANCE_IDENTITY,
      timestamp: BENCH_EPOCH_SEC + index,
    });
    const commitOid = hashObject('commit', commit);
    const objects: GitObjectInput[] = [
      { type: 'blob', data: blob },
      { type: 'tree', data: tree },
      { type: 'commit', data: commit },
    ];
    payloads.push({
      command: { oldOid: parent ?? ZERO_OID, newOid: commitOid, ref: MAIN_REF },
      pack: writePack(objects),
    });
    parent = commitOid;
  }
  return payloads;
}

/**
 * The clone repository's whole history in one pack: CLONE_HISTORY_COMMITS commits on refs/heads/main,
 * each replacing CLONE_FILE's content, so a depth-1 clone has a real 200-commit history to cut off.
 * Built once in setup, outside every timed round.
 */
function buildCloneHistory(): { tip: string; pack: Buffer } {
  const rng = scenarioRng('bench.clone');
  const objects: GitObjectInput[] = [];
  let tip = '';
  for (let index = 0; index < CLONE_HISTORY_COMMITS; index += 1) {
    const blob = Buffer.from(generateBlobText(rng, CLONE_CHANGE_BYTES), 'utf8');
    const blobOid = hashObject('blob', blob);
    const tree = buildTree([{ mode: '100644', name: CLONE_FILE, oid: blobOid }]);
    const treeOid = hashObject('tree', tree);
    const commit = buildCommit({
      tree: treeOid,
      parents: tip === '' ? [] : [tip],
      message: `bench: history ${index + 1}\n`,
      author: CONFORMANCE_IDENTITY,
      committer: CONFORMANCE_IDENTITY,
      timestamp: BENCH_EPOCH_SEC + index,
    });
    tip = hashObject('commit', commit);
    objects.push({ type: 'blob', data: blob }, { type: 'tree', data: tree }, { type: 'commit', data: commit });
  }
  return { tip, pack: writePack(objects) };
}

// ---------------------------------------------------------------- clients and fixtures

/** A git client bound to the entry for one workload; every call carries the workload's signal. */
function gitClientOf(run: WorkloadRun): GitClient {
  return new GitClient({
    baseUrl: run.baseUrl,
    token: run.token,
    signal: run.signal,
    timeoutMs: Math.max(1, run.remainingMs()),
  });
}

/** A REST client bound to the entry for one workload; every call carries the workload's signal. */
function restClientOf(run: WorkloadRun): RestClient {
  return new RestClient({
    baseUrl: run.baseUrl,
    // An empty token sends no Authorization header, as GitClient does; null is RestClient's "none".
    token: run.token === '' ? null : run.token,
    signal: run.signal,
    timeoutMs: Math.max(1, run.remainingMs()),
  });
}

/** The owner every benchmark repository belongs to (the scenario's viewer, as every check uses). */
function ownerOf(run: WorkloadRun): string {
  return run.scenario.viewer.login;
}

/**
 * Delete the workload's repository when it exists, then create it: a re-run in the same entry process
 * starts from an empty repository, so the fixed push chain's first oldOid is ZERO_OID again. DELETE's
 * own answer is not scored (404 when absent is the normal fresh case); the create reports a real
 * failure, and GitClient.createRepo accepts the 422 that says the repository already exists.
 */
async function recreateRepo(run: WorkloadRun, git: GitClient, rest: RestClient, repo: string): Promise<void> {
  const owner = ownerOf(run);
  run.check();
  await rest.delete(apiPath('repos', owner, repo), { timeoutMs: run.remainingMs() });
  run.check();
  await git.createRepo(owner, repo, { signal: run.signal, timeoutMs: run.remainingMs() });
}

/** Throw unless a push's report-status says the ref was updated and the pack unpacked. */
function assertPushOk(result: PushResult, ref: string): void {
  if (result.report === null) throw new Error(`push ${ref}: the entry returned no report-status`);
  if (!result.report.unpackOk) throw new Error(`push ${ref}: unpack failed (${result.report.unpackDetail})`);
  const report = result.report.refs.find((entry) => entry.ref === ref);
  if (report === undefined) throw new Error(`push ${ref}: the report-status did not name the ref`);
  if (!report.ok) throw new Error(`push ${ref}: refused (${report.reason === '' ? 'no reason given' : report.reason})`);
}

/** One REST response as a failure line (newlines flattened: perf.json's notes are lines). */
function describeRest(response: RestResponse): string {
  if (response.status === 0) return `no response (${errorLine(response.error ?? 'unknown transport error')})`;
  const flat = response.text.replace(/\s+/g, ' ').trim();
  const body = flat.length > 160 ? `${flat.slice(0, 160)}…` : flat;
  return body === '' ? `HTTP ${response.status}` : `HTTP ${response.status}: ${body}`;
}

/** The `number` of a created issue's JSON body, or null when it is not a positive safe integer. */
function issueNumberOf(body: unknown): number | null {
  if (typeof body !== 'object' || body === null || Array.isArray(body)) return null;
  const number = (body as Record<string, unknown>).number;
  return typeof number === 'number' && Number.isSafeInteger(number) && number > 0 ? number : null;
}

// ---------------------------------------------------------------- the four workloads

/**
 * push: 200 sequential receive-pack updates of one 1 KiB commit on one repository. Every command and
 * pack is built before the warm-ups; a round walks the next `ops` of them. A refused update fails the
 * workload (the entry did not do the work, so its wall time means nothing).
 */
async function runPush(run: WorkloadRun): Promise<void> {
  const git = gitClientOf(run);
  const rest = restClientOf(run);
  const owner = ownerOf(run);
  await recreateRepo(run, git, rest, PUSH_REPO);
  run.check();
  const total = run.warmupOps + run.rounds * run.spec.ops;
  run.log(`[bench] push: built ${total} push payload(s) before timing`);
  const payloads = buildPushPayloads(total);
  let next = 0;
  const pushOnce = async (): Promise<void> => {
    run.check();
    const payload = payloads[next];
    if (payload === undefined) throw new Error('push: the pre-built payload list ran out');
    next += 1;
    const result = await git.push(owner, PUSH_REPO, [payload.command], {
      pack: payload.pack,
      signal: run.signal,
      timeoutMs: run.remainingMs(),
    });
    assertPushOk(result, MAIN_REF);
  };
  for (let index = 0; index < run.warmupOps; index += 1) await pushOnce();
  for (let round = 0; round < run.rounds; round += 1) {
    run.check();
    const startedAt = run.now();
    for (let index = 0; index < run.spec.ops; index += 1) await pushOnce();
    const elapsed = roundMs(run.now() - startedAt);
    run.roundsMs.push(elapsed);
    run.log(`[bench] push round ${round + 1}/${run.rounds}: ${elapsed} ms`);
  }
}

/**
 * clone: 50 concurrent depth-1 clones of a 200-commit repository, each stream checksum-verified and
 * not object-parsed (parse: false). The 200-commit history is pushed once in setup. A clone that
 * receives no pack (or whose checksum fails, which the client throws) fails the workload.
 */
async function runClone(run: WorkloadRun): Promise<void> {
  const git = gitClientOf(run);
  const rest = restClientOf(run);
  const owner = ownerOf(run);
  await recreateRepo(run, git, rest, CLONE_REPO);
  run.check();
  const history = buildCloneHistory();
  run.log(`[bench] clone: built the ${CLONE_HISTORY_COMMITS}-commit history (${history.pack.length} pack bytes)`);
  const pushed = await git.push(owner, CLONE_REPO, [{ oldOid: ZERO_OID, newOid: history.tip, ref: MAIN_REF }], {
    pack: history.pack,
    signal: run.signal,
    timeoutMs: run.remainingMs(),
  });
  assertPushOk(pushed, MAIN_REF);
  const cloneOnce = async (): Promise<void> => {
    run.check();
    const result = await git.clone(owner, CLONE_REPO, {
      depth: 1,
      parse: false,
      singleBranch: true,
      signal: run.signal,
      timeoutMs: run.remainingMs(),
    });
    if (result.checksumOk !== true) throw new Error('clone: the pack checksum did not verify');
    if (result.packBytes <= 0) throw new Error('clone: the clone received no packfile');
    if (result.refs.length === 0) throw new Error('clone: the clone received no refs');
  };
  for (let index = 0; index < run.warmupOps; index += 1) await cloneOnce();
  for (let round = 0; round < run.rounds; round += 1) {
    run.check();
    const startedAt = run.now();
    await Promise.all(Array.from({ length: run.spec.ops }, () => cloneOnce()));
    const elapsed = roundMs(run.now() - startedAt);
    run.roundsMs.push(elapsed);
    run.log(`[bench] clone round ${round + 1}/${run.rounds}: ${elapsed} ms (${run.spec.ops} concurrent)`);
  }
}

/**
 * read: 2,000 sequential GETs of one issue on a warm keep-alive connection. Setup creates the issue
 * through the REST surface and reads its number; the same RestClient then reuses undici's pooled
 * socket for every read (the 5 warm-ups come first).
 */
async function runRead(run: WorkloadRun): Promise<void> {
  const git = gitClientOf(run);
  const rest = restClientOf(run);
  const owner = ownerOf(run);
  await recreateRepo(run, git, rest, READ_REPO);
  run.check();
  const template = run.scenario.issues[0];
  if (template === undefined) throw new Error('read: the scenario has no issue template');
  const created = await rest.post(apiPath('repos', owner, READ_REPO, 'issues'), {
    body: { title: `${template.title} (bench setup)`, body: template.body },
    timeoutMs: run.remainingMs(),
  });
  if (created.status !== 201) throw new Error(`read: the setup issue create answered ${describeRest(created)}`);
  const number = issueNumberOf(created.body);
  if (number === null) throw new Error('read: the setup issue create answered no numeric issue number');
  const path = apiPath('repos', owner, READ_REPO, 'issues', number);
  const readOnce = async (): Promise<void> => {
    run.check();
    const response = await rest.get(path, { timeoutMs: run.remainingMs() });
    if (response.status !== 200) throw new Error(`read: GET issue ${number} answered ${describeRest(response)}`);
    if (typeof response.body !== 'object' || response.body === null) throw new Error(`read: GET issue ${number} answered no JSON object body`);
  };
  for (let index = 0; index < run.warmupOps; index += 1) await readOnce();
  for (let round = 0; round < run.rounds; round += 1) {
    run.check();
    const startedAt = run.now();
    for (let index = 0; index < run.spec.ops; index += 1) await readOnce();
    const elapsed = roundMs(run.now() - startedAt);
    run.roundsMs.push(elapsed);
    run.log(`[bench] read round ${round + 1}/${run.rounds}: ${elapsed} ms`);
  }
}

/**
 * write: 200 sequential issue creations. Every title is built before the warm-ups; a create that is
 * not a 201 (GitHub's create-issue status) fails the workload.
 */
async function runWrite(run: WorkloadRun): Promise<void> {
  const git = gitClientOf(run);
  const rest = restClientOf(run);
  const owner = ownerOf(run);
  await recreateRepo(run, git, rest, WRITE_REPO);
  run.check();
  const total = run.warmupOps + run.rounds * run.spec.ops;
  const payloads: Array<{ title: string; body: string }> = [];
  for (let index = 0; index < total; index += 1) {
    const template = run.scenario.issues[index % run.scenario.issues.length];
    if (template === undefined) throw new Error('write: the scenario has no issue template');
    payloads.push({ title: `${template.title} [bench ${index + 1}]`, body: template.body });
  }
  const path = apiPath('repos', owner, WRITE_REPO, 'issues');
  let next = 0;
  const writeOnce = async (): Promise<void> => {
    run.check();
    const payload = payloads[next];
    if (payload === undefined) throw new Error('write: the pre-built issue list ran out');
    next += 1;
    const response = await rest.post(path, { body: payload, timeoutMs: run.remainingMs() });
    if (response.status !== 201) throw new Error(`write: the issue create answered ${describeRest(response)}`);
  };
  for (let index = 0; index < run.warmupOps; index += 1) await writeOnce();
  for (let round = 0; round < run.rounds; round += 1) {
    run.check();
    const startedAt = run.now();
    for (let index = 0; index < run.spec.ops; index += 1) await writeOnce();
    const elapsed = roundMs(run.now() - startedAt);
    run.roundsMs.push(elapsed);
    run.log(`[bench] write round ${round + 1}/${run.rounds}: ${elapsed} ms`);
  }
}

/** The workload bodies, keyed by manifest.ts name. */
const WORKLOAD_BODIES: Readonly<Record<BenchWorkloadName, (run: WorkloadRun) => Promise<void>>> = Object.freeze({
  push: runPush,
  clone: runClone,
  read: runRead,
  write: runWrite,
});

// ---------------------------------------------------------------- one workload's phase

/** What a workload needs from the phase around it. */
interface PhaseContext {
  readonly baseUrl: string;
  readonly token: string;
  readonly scenario: Scenario;
  readonly now: () => number;
  /** The absolute `now()` reading the benchmark phase must stop at. */
  readonly phaseEnd: number;
  readonly signal: AbortSignal | undefined;
  readonly rounds: number;
  readonly warmupOps: number;
  readonly log: (line: string) => void;
}

/**
 * Run one workload inside its own budget (manifest.ts budgetMs, capped by the phase's end), with a
 * timer that aborts its in-flight requests at the deadline. Never throws: a failure is the
 * measurement's `error`, and whatever rounds finished are kept.
 */
async function runWorkload(spec: BenchWorkloadSpec, phase: PhaseContext): Promise<WorkloadMeasurement> {
  const startedAt = phase.now();
  const deadlineAt = Math.min(startedAt + spec.budgetMs, phase.phaseEnd);
  if (deadlineAt <= startedAt) {
    return { name: spec.name, roundsMs: [], expectedRounds: phase.rounds, error: 'the benchmark phase deadline fell before the workload ran' };
  }
  const controller = new AbortController();
  if (phase.signal?.aborted === true) controller.abort();
  const state = { expired: false };
  const run: WorkloadRun = {
    spec,
    baseUrl: phase.baseUrl,
    token: phase.token,
    scenario: phase.scenario,
    now: phase.now,
    deadlineAt,
    signal: controller.signal,
    rounds: phase.rounds,
    warmupOps: phase.warmupOps,
    roundsMs: [],
    log: phase.log,
    get expired(): boolean {
      return state.expired;
    },
    set expired(value: boolean) {
      state.expired = value;
    },
    remainingMs(): number {
      return Math.max(0, deadlineAt - phase.now());
    },
    check(): void {
      if (controller.signal.aborted) {
        throw new WorkloadStop(state.expired ? 'deadline' : 'aborted', state.expired ? deadlineText(spec) : 'the trial was aborted');
      }
      if (phase.now() > deadlineAt) {
        state.expired = true;
        controller.abort();
        throw new WorkloadStop('deadline', deadlineText(spec));
      }
    },
  };
  let timer: ReturnType<typeof setTimeout> | undefined;
  const onAbort = (): void => controller.abort();
  if (!controller.signal.aborted) {
    timer = setTimeout(() => {
      state.expired = true;
      controller.abort();
    }, Math.max(1, deadlineAt - phase.now()));
    phase.signal?.addEventListener('abort', onAbort, { once: true });
  }
  try {
    await WORKLOAD_BODIES[spec.name](run);
    return { name: spec.name, roundsMs: [...run.roundsMs], expectedRounds: phase.rounds };
  } catch (err) {
    // Read the abort state before aborting the workload's own in-flight calls below: an entry's
    // error (a 404, a refused push) must be recorded as itself, not as the abort we then send.
    const why =
      err instanceof WorkloadStop
        ? err.message
        : controller.signal.aborted
          ? state.expired
            ? deadlineText(spec)
            : 'the trial was aborted'
          : errorLine(err);
    controller.abort();
    return { name: spec.name, roundsMs: [...run.roundsMs], expectedRounds: phase.rounds, error: why };
  } finally {
    if (timer !== undefined) clearTimeout(timer);
    phase.signal?.removeEventListener('abort', onAbort);
  }
}

// ---------------------------------------------------------------- the phase

/** Everything runBenchmark accepts. Only baseUrl is required; the rest is the sealed main.ts's. */
export interface BenchmarkOptions {
  /** The entry's base URL (wire.ts EntryBase.url), no trailing slash needed. */
  readonly baseUrl: string;
  /** The bearer token every API call presents (wire.ts TOKEN_ENV); '' sends none. */
  readonly token?: string;
  /** The trial's abort (SIGTERM): ends the workload in flight and marks the rest unrun. */
  readonly signal?: AbortSignal;
  /** The env's internal deadline, an absolute performance.now() reading (wire.ts deadline.deadlineMs). */
  readonly deadlineMs?: number;
  /** This phase's own budget, ms; default wire.ts BENCHMARK_BUDGET_MS (240 s). */
  readonly phaseBudgetMs?: number;
  /** T_ref overrides; omitted slots keep manifest.ts T_REF_MS. 0 means uncalibrated. */
  readonly tRefs?: Readonly<Partial<Record<BenchWorkloadName, number>>>;
  /** Timed rounds a workload; default manifest.ts BENCH_ROUNDS (3). A smoke run may pass 1. */
  readonly rounds?: number;
  /** Untimed warm-up operations; default manifest.ts BENCH_WARMUP_OPS (5). */
  readonly warmupOps?: number;
  /** The workloads to run, in order; default manifest.ts BENCH_WORKLOAD_NAMES (all four). */
  readonly workloads?: readonly BenchWorkloadName[];
  /** The monotonic clock; default performance.now. `deadlineMs` is on this clock too. */
  readonly now?: () => number;
  /** A diagnostic line per workload and round (stderr in the sealed env); never scored. */
  readonly log?: (line: string) => void;
}

/**
 * Run the benchmark and return the perf.json body (wire.ts PerfFile). Never throws for what the entry
 * does: every workload's failure is its `error` and 0 points, and a workload the phase never reached
 * writes p50_ms 1e9 with 0 points (the scorer's ruling). The caller writes the result with
 * canonicalJsonLine to wire.ts perfFilePath(stateDir).
 */
export async function runBenchmark(options: BenchmarkOptions): Promise<PerfFile> {
  if (typeof options?.baseUrl !== 'string' || options.baseUrl.trim() === '') {
    throw new TypeError('runBenchmark needs the entry base URL (wire.ts EntryBase.url)');
  }
  const baseUrl = options.baseUrl.trim().replace(/\/+$/, '');
  const token = typeof options.token === 'string' ? options.token : '';
  const now = options.now ?? ((): number => performance.now());
  const rounds = clampInt(options.rounds, 1, 25, BENCH_ROUNDS);
  const warmupOps = clampInt(options.warmupOps, 0, 200, BENCH_WARMUP_OPS);
  const phaseBudget = finiteOr(options.phaseBudgetMs, BENCH_PHASE_BUDGET_MS);
  const phaseStart = now();
  const deadlineMs = finiteOr(options.deadlineMs, Number.POSITIVE_INFINITY);
  const phaseEnd = Math.min(phaseStart + Math.max(1, phaseBudget), deadlineMs);
  const log = options.log ?? ((): void => undefined);
  const scenario = buildScenario();

  const tRefs: Record<BenchWorkloadName, number> = {
    push: T_REF_MS.push,
    clone: T_REF_MS.clone,
    read: T_REF_MS.read,
    write: T_REF_MS.write,
  };
  for (const workload of BENCH_WORKLOADS) {
    const override = options.tRefs?.[workload.name];
    if (override !== undefined) tRefs[workload.name] = finiteOr(override, 0);
  }

  const requested = options.workloads ?? BENCH_WORKLOAD_NAMES;
  const order: BenchWorkloadName[] = [];
  const seen = new Set<BenchWorkloadName>();
  for (const name of requested) {
    if (!BENCH_WORKLOAD_NAMES.includes(name)) throw new TypeError(`unknown benchmark workload ${JSON.stringify(name)} (the workloads are ${BENCH_WORKLOAD_NAMES.join(', ')})`);
    if (seen.has(name)) continue;
    seen.add(name);
    order.push(name);
  }

  const phase: Omit<PhaseContext, 'rounds' | 'warmupOps'> = {
    baseUrl,
    token,
    scenario,
    now,
    phaseEnd,
    signal: options.signal,
    log,
  };
  const measurements: WorkloadMeasurement[] = [];
  for (const name of order) {
    const spec = benchWorkload(name);
    if (options.signal?.aborted === true) {
      measurements.push({ name, roundsMs: [], expectedRounds: rounds, error: 'the trial was aborted before the workload ran' });
      continue;
    }
    if (now() >= phaseEnd) {
      measurements.push({ name, roundsMs: [], expectedRounds: rounds, error: 'the benchmark phase deadline fell before the workload ran' });
      continue;
    }
    log(`[bench] ${name}: ${spec.ops} op(s) a round, ${rounds} round(s), ${warmupOps} warm-up op(s), ${spec.budgetMs} ms budget`);
    const measured = await runWorkload(spec, { ...phase, rounds, warmupOps });
    const tRef = finiteOr(tRefs[name], 0);
    measurements.push(tRef > 0 ? measured : { ...measured, uncalibrated: true });
  }

  const tRefsOut = tRefs;
  const uncalibrated = BENCH_WORKLOADS.filter((workload) => !(finiteOr(tRefsOut[workload.name], 0) > 0)).map((workload) => workload.name);
  const notes: string[] = [];
  if (uncalibrated.length > 0) notes.push(`T_ref is uncalibrated (0) for ${uncalibrated.join(', ')}: those workloads earn 0 points`);

  const workloads = measurements.map((measurement) => {
    const spec = benchWorkload(measurement.name);
    const result = finishWorkload(spec, measurement, finiteOr(tRefsOut[measurement.name], 0));
    log(`[bench] ${measurement.name}: p50 ${result.p50_ms} ms, ${result.points} point(s)${result.error !== undefined ? ` (${result.error})` : ''}`);
    return result;
  });
  return perfFileOf(workloads, tRefsOut, notes);
}
// github-core-clone-01's env program: the sealed house server that grades one running forge.
//
// The entry (the entrant's GitHub-compatible server) starts beside this process, binds an ephemeral port
// and POSTs it to /register; from then on this process dials the address the register request came from.
// The entry long-polls GET /done until the suite is over and exits 0. The harness SIGTERMs this process
// afterwards, which writes (or keeps) the export the sealed scorer reads (wire.ts holds the whole
// contract; export.ts holds the export's bytes and the never-worse rule).
//
// THE PROGRAM, IN ORDER
//   1. listen on MAKEFUN_ENV_HOST (0.0.0.0 in a container, 127.0.0.1 under the process driver) at
//      MAKEFUN_ENV_PORT (8080 when unset, 0 picks a free port), with no SO_REUSEPORT (server/agent-env/
//      listen.ts's semantics). Write <state>/ready once bound: the harness waits for it before starting
//      the entry. Then confirm <state>/ready reads back (30 s) -- a runner that writes it first makes this
//      the start signal -- and wait for the entry's first register (wire.ts RegisterGate; boot budget).
//      <state>/calls.ndjson is written empty at start: the harness stores it as the pass's env log
//      (grader/agent.ts finishPass, ENV_LOG_FILE) and faults `env` on a pass without one. This env makes
//      no model calls, so the log stays empty; it never holds a fabricated one.
//   2. boot: the entry's GET /healthz answered twice within HEALTHZ_BUDGET_MS. No register before the
//      boot budget is a boot failure: every check 0, working 0, a fixed boot note, and /done true at once.
//   3. install the git fixture the GraphQL pull-request checks need (configureGraphQLGit, over a
//      GitClient bound to the entry: it creates the fixture repository through REST and pushes the
//      branch each pull request is opened from), then run every check of
//      [...GIT_CHECKS, ...restChecks(), ...restProtocolChecks(), ...GRAPHQL_CHECKS, ...MCP_CHECKS] in
//      registration order, one at a time, each with its own timeout and its own AbortSignal. A check
//      that times out is recorded 0 with the detail "deadline"; the rest still run. validateCheckSpecs
//      refuses a suite whose group counts are not the manifest's (git 30, repos 15, issues 15, pulls 20,
//      graphql 20, mcp 15, protocol 5): then no check runs and every registered id is 0.
//   4. the benchmark (four workloads, bench.ts), and the export.
//   5. /done answers {"done":true} as soon as the export is written. The process keeps serving until
//      SIGTERM (which rewrites the export only if it is not worse, and exits 0).
//
// DEADLINE DISCIPLINE. The internal deadline is the trial's wall budget less DEADLINE_MARGIN_MS
// (wire.ts deadlineOf; 900 s less 90 s by default, MAKEFUN_TRIAL_WALL_BUDGET_SEC overrides it for a local
// run). The conformance phase is also bounded by CONFORMANCE_BUDGET_MS and the benchmark by
// BENCHMARK_BUDGET_MS (wire.ts PHASE_BUDGET_MS). At the deadline the checks still pending are recorded 0
// with "deadline", the benchmark's remaining workloads are never started (bench.ts's own deadline does the
// same inside a workload), the export is written, /done is answered, and the process exits after a 5 s
// grace if the harness has not SIGTERMed it yet.
//
// WHAT NEVER ENTERS THE EXPORT: a time, a port or a random id. state.json's bytes depend only on the
// checks' pass bits (export.ts: the static perfTiers and the RULING that no measured timing reaches
// state.json); perf.json holds the timings. A SIGTERM at any point still writes an export, so a trial that
// dies mid-suite leaves a scorable one rather than none.
//
// This module imports only env/src modules and Node built-ins; scripts/competitions/build-agent-bundle.ts
// inlines all of it into env/server.mjs (from src/server/main.ts), and sdk/sync.sh copies these files into
// the kit's local runner.

import { mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http';
import {
  BENCHMARK_BUDGET_MS,
  BOOT_BUDGET_MS,
  BOOT_FAILED_NOTE,
  CONFORMANCE_BUDGET_MS,
  CONTAINER_HOST,
  DEFAULT_ENV_PORT,
  DEADLINE_MARGIN_MS,
  DONE_PATH,
  ENV_HOST_ENV,
  ENV_PORT_ENV,
  HEALTHZ_ATTEMPTS,
  HEALTHZ_BUDGET_MS,
  HEALTHZ_PATH,
  MAX_REGISTER_BODY_BYTES,
  PROCESS_DRIVER_HOST,
  REGISTER_BAD_REQUEST_STATUS,
  REGISTER_CONFLICT_STATUS,
  REGISTER_METHOD_STATUS,
  REGISTER_OK_STATUS,
  REGISTER_PATH,
  STATE_DIR_ENV,
  TOKEN_ENV,
  TRIAL_WALL_BUDGET_SEC,
  WireError,
  buildScenario,
  deadlineOf,
  doneComplete,
  doneWaiting,
  entryBase,
  isReadyFile,
  joinPath,
  joinUrl,
  parseRegisterRequest,
  readyBody,
  readyFilePath,
  registerAcceptedBody,
  registerConflictBody,
  stateDirOf,
  waitForReadyFile,
  waitForValue,
  RegisterGate,
  type CheckId,
  type Deadline,
  type EntryBase,
  type PerfFile,
  type Phase,
  type ReadyFile,
  type Scenario,
  type StateFile,
} from './wire.ts';
import {
  checkTimeoutMs,
  fail,
  validateCheckSpecs,
  type CheckContext,
  type CheckResult,
  type CheckSpec,
} from './manifest.ts';
import { GIT_CHECKS } from './checks-git.ts';
import { restChecks, restProtocolChecks } from './checks-rest.ts';
import { GRAPHQL_CHECKS, configureGraphQLGit, type GraphQLGitFixture, type GraphQLGitPush } from './checks-graphql.ts';
import { MCP_CHECKS } from './checks-mcp.ts';
import { failedPerfFile, runBenchmark } from './bench.ts';
import {
  CONFORMANCE_IDENTITY,
  GitClient,
  ZERO_OID,
  buildCommit,
  buildTree,
  hashObject,
  objectsToSend,
  parseCommit,
  parseTree,
  type GitObject,
  type GitObjectType,
  type TreeEntry,
} from './git-client.ts';
import { bootFailureExport, stateExportOf, writeExportPair, type CheckOutcome } from './export.ts';

// ---------------------------------------------------------------- constants

/** The variable that overrides the trial's wall budget for a local run (seconds); the wire constant wins. */
export const WALL_BUDGET_ENV = 'MAKEFUN_TRIAL_WALL_BUDGET_SEC';
/** How long the env waits for <state>/ready to read back before it treats the run as a boot failure. */
export const READY_WAIT_MS = 30_000;
/** How long the env keeps serving after the internal deadline wrote the export and answered /done. */
export const DEADLINE_EXIT_GRACE_MS = 5_000;
/** The longest a timed-out check's abandoned promise gets to settle before the next check starts. */
export const CHECK_DRAIN_GRACE_MS = 1_000;
/** The prefix every diagnostic line carries (the trial's env log). */
export const ENV_LOG_PREFIX = '[env] ';
/** The call log under the state directory: grader/agent.ts finishPass stores it, and a pass without it faults `env`. */
export const CALLS_LOG_FILE = 'calls.ndjson';
/** The fixed epoch a fixture commit carries (wire.ts SCENARIO_EPOCH_SEC): data, never a clock. */
export const FIXTURE_EPOCH_SEC = 1_735_689_600;
/** One git request the fixture makes may take this long (a correct entry answers in milliseconds). */
export const FIXTURE_REQUEST_TIMEOUT_MS = 4_000;
/** All the fixture work for one pushBranch call is bounded by this (inside a GraphQL check's timeout). */
export const FIXTURE_PUSH_BUDGET_MS = 12_000;

// ---------------------------------------------------------------- small utilities

/** A thrown value's line, flattened (a log line is one line). */
function messageOf(err: unknown): string {
  const text = err instanceof Error ? `${err.name}: ${err.message}` : String(err);
  return text.replace(/\s+/g, ' ').trim();
}

function realLog(line: string): void {
  process.stderr.write(`${ENV_LOG_PREFIX}${line}\n`);
}

function sleep(ms: number): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(resolve, Math.max(0, ms));
  });
}

function roundMs(ms: number): number {
  return Number.isFinite(ms) && ms > 0 ? Math.round(ms) : 0;
}

/** The wall budget the internal deadline derives from: the variable when it is a positive number. */
export function trialWallBudgetOf(env: Readonly<Record<string, string | undefined>> = process.env): number {
  const text = env[WALL_BUDGET_ENV];
  const value = text === undefined || text === '' ? Number.NaN : Number(text);
  return Number.isFinite(value) && value > 0 ? value : TRIAL_WALL_BUDGET_SEC;
}

// ---------------------------------------------------------------- the listener

/** Where the env listens: the host as configured and the port (0 picks a free one). */
export interface ListenTarget {
  readonly host: string;
  readonly port: number;
}

/**
 * The host and port to bind, with server/agent-env/listen.ts's semantics: MAKEFUN_ENV_HOST when set; else
 * 127.0.0.1 under the process driver (MAKEFUN_STATE_DIR set) and 0.0.0.0 in a container. MAKEFUN_ENV_PORT
 * when set (0 picks a free port), else 8080. A port that is not digits 0..65535 throws WireError.
 */
export function listenTargetOf(
  env: Readonly<Record<string, string | undefined>> = process.env,
  override: { readonly host?: string; readonly port?: number } = {},
): ListenTarget {
  const stateDir = env[STATE_DIR_ENV];
  const processDriver = stateDir !== undefined && stateDir !== '';
  const host = override.host ?? (env[ENV_HOST_ENV] || (processDriver ? PROCESS_DRIVER_HOST : CONTAINER_HOST));
  const portText = override.port !== undefined ? String(override.port) : env[ENV_PORT_ENV] ?? String(DEFAULT_ENV_PORT);
  if (!/^\d{1,5}$/.test(portText) || Number(portText) > 65535) {
    throw new WireError(`${ENV_PORT_ENV} ${JSON.stringify(portText)} is not a port (0..65535, digits only)`);
  }
  return { host, port: Number(portText) };
}

/** The bound address the ready file names. */
export interface EnvAddress {
  readonly host: string;
  readonly port: number;
}

/** Bind `server` at `target`, reusePort false (no SO_REUSEPORT: a second listener is refused). */
export function bindServer(server: Server, target: ListenTarget): Promise<EnvAddress> {
  return new Promise<EnvAddress>((resolve, reject) => {
    const onError = (err: Error): void => reject(err);
    server.once('error', onError);
    server.listen({ port: target.port, host: target.host, reusePort: false }, () => {
      server.removeListener('error', onError);
      const bound = server.address();
      if (bound === null || typeof bound === 'string') {
        reject(new Error(`the env's listener on ${target.host}:${target.port} has no TCP address`));
        return;
      }
      resolve({ host: target.host, port: bound.port });
    });
  });
}

/** Write <state>/ready whole: the body wire.ts readyBody makes, then a rename. */
export function writeReadyFile(stateDir: string, address: EnvAddress): void {
  mkdirSync(stateDir, { recursive: true });
  const file = readyFilePath(stateDir);
  const tmp = `${file}.tmp`;
  writeFileSync(tmp, `${JSON.stringify(readyBody(address.host, address.port))}\n`, 'utf8');
  renameSync(tmp, file);
}

/** The ready file's parsed body, or null when it is absent or not this contract's. */
export function readReadyFile(stateDir: string): ReadyFile | null {
  try {
    const parsed: unknown = JSON.parse(readFileSync(readyFilePath(stateDir), 'utf8'));
    return isReadyFile(parsed) ? parsed : null;
  } catch {
    return null;
  }
}

// ---------------------------------------------------------------- the env's HTTP surface

/** What the env's server reads: the register gate and whether the export is written. */
export interface EnvServerOptions {
  readonly gate: RegisterGate;
  readonly isDone: () => boolean;
  readonly log: (line: string) => void;
}

function sendJson(res: ServerResponse, status: number, body: unknown, headers: Readonly<Record<string, string>> = {}): void {
  const text = `${JSON.stringify(body)}\n`;
  try {
    res.writeHead(status, {
      'content-type': 'application/json; charset=utf-8',
      'content-length': Buffer.byteLength(text),
      'cache-control': 'no-store',
      ...headers,
    });
    res.end(text);
  } catch {
    // The peer went away between the request and the answer; nothing to write to.
  }
}

function pathOf(req: IncomingMessage): string {
  try {
    return new URL(req.url ?? '/', 'http://env').pathname;
  } catch {
    return '/';
  }
}

/** Read a register body up to the contract's cap; null when the body is past it. */
async function readRegisterBody(req: IncomingMessage): Promise<Buffer | null> {
  const chunks: Buffer[] = [];
  let size = 0;
  for await (const chunk of req) {
    const buffer = chunk as Buffer;
    size += buffer.length;
    if (size > MAX_REGISTER_BODY_BYTES) return null;
    chunks.push(buffer);
  }
  return Buffer.concat(chunks);
}

async function handleRequest(req: IncomingMessage, res: ServerResponse, options: EnvServerOptions): Promise<void> {
  const method = req.method ?? 'GET';
  const path = pathOf(req);

  if (path === REGISTER_PATH) {
    if (method !== 'POST') {
      sendJson(res, REGISTER_METHOD_STATUS, { ok: false, error: 'method_not_allowed', message: `${REGISTER_PATH} takes POST` });
      return;
    }
    const raw = await readRegisterBody(req);
    if (raw === null) {
      sendJson(res, REGISTER_BAD_REQUEST_STATUS, { ok: false, error: 'body_too_large', message: `a register body holds at most ${MAX_REGISTER_BODY_BYTES} bytes` });
      return;
    }
    let body: unknown;
    try {
      body = JSON.parse(raw.toString('utf8'));
    } catch {
      sendJson(res, REGISTER_BAD_REQUEST_STATUS, { ok: false, error: 'bad_json', message: 'the register body is not JSON' });
      return;
    }
    try {
      const register = parseRegisterRequest(body);
      const base = entryBase(req.socket.remoteAddress, register.port);
      if (options.gate.offer(base)) {
        options.log(`register: entry base ${base.url}`);
        sendJson(res, REGISTER_OK_STATUS, registerAcceptedBody());
      } else {
        sendJson(res, REGISTER_CONFLICT_STATUS, registerConflictBody());
      }
    } catch (err) {
      sendJson(res, REGISTER_BAD_REQUEST_STATUS, { ok: false, error: 'bad_request', message: messageOf(err) });
    }
    return;
  }

  if (path === DONE_PATH) {
    if (method !== 'GET') {
      sendJson(res, REGISTER_METHOD_STATUS, { ok: false, error: 'method_not_allowed', message: `${DONE_PATH} takes GET` });
      return;
    }
    // Answered at once, never held: the entry polls (wire.ts DONE_ANSWER_DEADLINE_MS).
    sendJson(res, 200, options.isDone() ? doneComplete() : doneWaiting());
    return;
  }

  sendJson(res, 404, { ok: false, error: 'not_found', message: `no route ${method} ${path}` });
}

/** The env's server: POST /register, GET /done, a JSON 404 for anything else. It binds nothing yet. */
export function createEnvServer(options: EnvServerOptions): Server {
  const server = createServer((req, res) => {
    void handleRequest(req, res, options).catch((err: unknown) => {
      options.log(`a request failed: ${messageOf(err)}`);
      sendJson(res, 500, { ok: false, error: 'internal', message: 'the env failed to answer' });
    });
  });
  server.on('error', (err: Error) => {
    options.log(`the listener reported an error: ${messageOf(err)}`);
  });
  return server;
}

// ---------------------------------------------------------------- the GraphQL fixtures' git adapter

interface ObjectStore {
  readonly objects: Map<string, GitObject>;
}

/** Store one object and answer its id (the fixture's local object model). */
function putObject(store: ObjectStore, type: GitObjectType, data: Buffer): string {
  const oid = hashObject(type, data);
  if (!store.objects.has(oid)) store.objects.set(oid, { type, data });
  return oid;
}

function treeEntriesOf(store: ObjectStore, treeOid: string): TreeEntry[] {
  const tree = store.objects.get(treeOid);
  if (tree === undefined || tree.type !== 'tree') throw new WireError(`the fixture tree ${treeOid} is not in the client store`);
  return parseTree(tree.data);
}

/** The tree a parent commit holds, read from the store (fetching the commit's closure when absent). */
async function loadCommitTree(
  client: GitClient,
  store: ObjectStore,
  owner: string,
  repo: string,
  commitOid: string,
  signal: AbortSignal,
): Promise<TreeEntry[] | null> {
  if (!store.objects.has(commitOid)) {
    const fetched = await client.fetch(owner, repo, { wants: [commitOid], parse: true }, { signal });
    for (const [oid, object] of fetched.objects) if (!store.objects.has(oid)) store.objects.set(oid, object);
  }
  const commit = store.objects.get(commitOid);
  if (commit === undefined || commit.type !== 'commit') return null;
  const tree = store.objects.get(parseCommit(commit.data).tree);
  if (tree === undefined || tree.type !== 'tree') return null;
  return parseTree(tree.data);
}

/** The blob a tree holds at `segments`, or null when the path is absent. */
function findTreePath(store: ObjectStore, entries: readonly TreeEntry[], segments: readonly string[]): string | null {
  const head = segments[0];
  if (head === undefined) return null;
  const entry = entries.find((candidate) => candidate.name === head);
  if (entry === undefined) return null;
  if (segments.length === 1) return entry.mode === '40000' ? null : entry.oid;
  if (entry.mode !== '40000') return null;
  const child = store.objects.get(entry.oid);
  if (child === undefined || child.type !== 'tree') return null;
  return findTreePath(store, parseTree(child.data), segments.slice(1));
}

/** A tree with `segments` set to `blobOid`, every other entry kept: the fixture commit's tree. */
function buildTreeWithPath(store: ObjectStore, entries: readonly TreeEntry[], segments: readonly string[], blobOid: string): string {
  const head = segments[0];
  if (head === undefined || head === '' || head === '.' || head === '..') throw new WireError('the fixture file path has an unusable segment');
  const rest = segments.slice(1);
  const kept = entries.filter((entry) => entry.name !== head);
  if (rest.length === 0) {
    kept.push({ mode: '100644', name: head, oid: blobOid });
  } else {
    const existing = entries.find((entry) => entry.name === head && entry.mode === '40000');
    const childEntries = existing === undefined ? [] : treeEntriesOf(store, existing.oid);
    kept.push({ mode: '40000', name: head, oid: buildTreeWithPath(store, childEntries, rest, blobOid) });
  }
  return putObject(store, 'tree', buildTree(kept));
}

/** Whether the commit's tree already holds `content` at `path` (true, false, or null when unreadable). */
async function fixtureHoldsFile(
  client: GitClient,
  store: ObjectStore,
  owner: string,
  repo: string,
  commitOid: string,
  segments: readonly string[],
  content: string,
  signal: AbortSignal,
): Promise<boolean | null> {
  const entries = await loadCommitTree(client, store, owner, repo, commitOid, signal);
  if (entries === null) return null;
  const oid = findTreePath(store, entries, segments);
  if (oid === null) return false;
  const blob = store.objects.get(oid);
  return blob !== undefined && blob.type === 'blob' ? blob.data.toString('utf8') === content : false;
}

/** One pushBranch call: create the repo if needed, build the commit, push it, read the report. */
async function pushFixtureBranch(
  client: GitClient,
  store: ObjectStore,
  request: GraphQLGitPush,
  signal: AbortSignal,
  log: (line: string) => void,
): Promise<string | null> {
  const path = request.path.replace(/^\/+/, '').replace(/\/+$/, '');
  if (path === '') return 'the fixture file path is empty';
  const segments = path.split('/');
  await client.createRepo(request.owner, request.repo, { signal });
  const prefixes = [`refs/heads/${request.branch}`];
  if (request.from !== undefined) prefixes.push(`refs/heads/${request.from}`);
  const listed = await client.lsRefs(request.owner, request.repo, { signal, prefixes });
  const branchTip = listed.refs.find((ref) => ref.name === `refs/heads/${request.branch}`)?.oid;
  let fromTip: string | undefined;
  if (request.from !== undefined) {
    fromTip = listed.refs.find((ref) => ref.name === `refs/heads/${request.from}`)?.oid;
    if (fromTip === undefined) return `the branch ${request.from} does not exist on ${request.owner}/${request.repo}`;
  }
  if (branchTip !== undefined) {
    const holds = await fixtureHoldsFile(client, store, request.owner, request.repo, branchTip, segments, request.content, signal);
    if (holds === true) {
      log(`git fixture: ${request.branch} already holds ${path}`);
      return null;
    }
    if (holds === null) return `the branch ${request.branch}'s tree could not be read`;
  }
  const parent = branchTip ?? fromTip ?? null;
  const parentEntries = parent === null ? [] : await loadCommitTree(client, store, request.owner, request.repo, parent, signal);
  if (parentEntries === null) return `the parent commit ${String(parent)} could not be read`;
  const blob = putObject(store, 'blob', Buffer.from(request.content, 'utf8'));
  const tree = buildTreeWithPath(store, parentEntries, segments, blob);
  const commit = putObject(
    store,
    'commit',
    buildCommit({
      tree,
      parents: parent === null ? [] : [parent],
      message: `${request.message}\n`,
      timestamp: FIXTURE_EPOCH_SEC,
      author: CONFORMANCE_IDENTITY,
      committer: CONFORMANCE_IDENTITY,
    }),
  );
  const advertisement = await client.advertisement(request.owner, request.repo, 'git-receive-pack', { signal });
  if (advertisement.protocol !== 0) return 'receive-pack advertised a non-v0 protocol';
  const serverTips = advertisement.refs.map((ref) => ref.oid).filter((oid) => oid !== ZERO_OID);
  const objects = objectsToSend((oid) => store.objects.get(oid), serverTips, [commit]);
  const pushed = await client.push(
    request.owner,
    request.repo,
    [{ oldOid: branchTip ?? ZERO_OID, newOid: commit, ref: `refs/heads/${request.branch}` }],
    { objects, signal },
  );
  if (pushed.report === null) return 'the server returned no report-status for the fixture push';
  if (!pushed.report.unpackOk) return `unpack failed: ${pushed.report.unpackDetail}`;
  const rejected = pushed.report.refs.find((ref) => !ref.ok);
  if (rejected !== undefined) return `${rejected.ref}: ${rejected.reason}`;
  log(`git fixture: pushed ${commit.slice(0, 12)} to refs/heads/${request.branch} (${path})`);
  return null;
}

/** What the fixture adapter needs: the entry's origin and token, the trial's abort and a log sink. */
export interface GitFixtureOptions {
  readonly baseUrl: string;
  readonly token: string;
  readonly signal?: AbortSignal;
  readonly log?: (line: string) => void;
  readonly timeoutMs?: number;
}

/**
 * The git adapter checks-graphql.ts's pull-request checks need: pushBranch builds one commit on `branch`
 * (rooted at `from`, or fast-forwarded from the branch's own tip on a re-run), with `path` set to
 * `content`, and pushes it over the suite's smart-HTTP client. It answers null on success or a
 * human-readable failure detail, never a throw (GraphQLGitFixture's contract).
 */
export function createGitFixture(options: GitFixtureOptions): GraphQLGitFixture {
  const client = new GitClient({
    baseUrl: options.baseUrl,
    token: options.token,
    timeoutMs: options.timeoutMs ?? FIXTURE_REQUEST_TIMEOUT_MS,
    signal: options.signal,
  });
  const store: ObjectStore = { objects: new Map() };
  const log = options.log ?? ((): void => undefined);
  return {
    async pushBranch(request: GraphQLGitPush): Promise<string | null> {
      const budget = AbortSignal.timeout(FIXTURE_PUSH_BUDGET_MS);
      const signal = options.signal === undefined ? budget : AbortSignal.any([options.signal, budget]);
      try {
        return await pushFixtureBranch(client, store, request, signal, log);
      } catch (err) {
        return `threw ${messageOf(err)}`;
      }
    },
  };
}

// ---------------------------------------------------------------- one check

/** Run one check with its timeout; a timeout aborts its signal and resolves 0 with "deadline". */
async function runCheck(
  spec: CheckSpec,
  context: CheckContext,
  timeoutMs: number,
  controller: AbortController,
  drainMs: number,
): Promise<CheckResult> {
  let started: Promise<CheckResult>;
  try {
    started = Promise.resolve(spec.fn(context));
  } catch (err) {
    started = Promise.reject(err);
  }
  const guarded = started.then(
    (result: CheckResult): CheckResult =>
      typeof result === 'object' && result !== null && typeof (result as { ok?: unknown }).ok === 'boolean' ? result : fail('the check returned no result'),
    (err: unknown): CheckResult => fail(`threw ${messageOf(err)}`),
  );
  let timedOut = false;
  let timer: ReturnType<typeof setTimeout> | undefined;
  const timeout = new Promise<CheckResult>((resolve) => {
    timer = setTimeout(() => {
      timedOut = true;
      controller.abort();
      resolve(fail('deadline'));
    }, Math.max(1, timeoutMs));
  });
  const result = await Promise.race([guarded, timeout]);
  if (timer !== undefined) clearTimeout(timer);
  if (timedOut && drainMs > 0) {
    // One check in flight at a time: a timed-out check gets a bounded moment to settle after its abort.
    await Promise.race([guarded.then(() => undefined, () => undefined), sleep(drainMs)]);
  }
  return result;
}

// ---------------------------------------------------------------- the run

interface RunState {
  readonly gate: RegisterGate;
  readonly specs: readonly CheckSpec[];
  readonly stateDir: string;
  readonly token: string;
  readonly scenario: Scenario;
  readonly deadline: Deadline;
  readonly now: () => number;
  readonly log: (line: string) => void;
  readonly trial: AbortController;
  readonly results: Record<CheckId, CheckOutcome>;
  readonly phaseMs: Record<Phase, number>;
  bootOk: boolean;
  registered: boolean;
  deadlineFallen: boolean;
  entry: EntryBase | null;
  perf: PerfFile | null;
}

/** Everything one run reports at its end (the handle's `done`). */
export interface SuiteOutcome {
  readonly state: StateFile;
  readonly perf: PerfFile;
  readonly bootOk: boolean;
  readonly registered: boolean;
  readonly working: 0 | 1;
  readonly passed: number;
  readonly total: number;
  readonly deadlineFallen: boolean;
  readonly aborted: boolean;
  readonly phaseMs: Readonly<Record<Phase, number>>;
  readonly durationMs: number;
}

/** The suite's checks, in the settled registration order (the WIRING of #14). */
export function suiteChecks(): CheckSpec[] {
  return [...GIT_CHECKS, ...restChecks(), ...restProtocolChecks(), ...GRAPHQL_CHECKS, ...MCP_CHECKS];
}

/** The boot phase: wait for the first register, then GET /healthz twice. */
async function runBoot(state: RunState): Promise<boolean> {
  const limit = Math.min(BOOT_BUDGET_MS, Math.max(0, state.deadline.deadlineMs - state.now()));
  try {
    await waitForValue(() => state.gate.entry, {
      timeoutMs: limit,
      signal: state.trial.signal,
      now: state.now,
    });
  } catch (err) {
    state.log(`boot: no register inside ${Math.round(limit)} ms (${messageOf(err)})`);
    return false;
  }
  const entry = state.gate.entry;
  if (entry === null) return false;
  state.entry = entry;
  state.registered = true;
  state.log(`boot: the entry registered at ${entry.url}`);
  const healthBudget = Math.min(HEALTHZ_BUDGET_MS, Math.max(0, state.deadline.deadlineMs - state.now()));
  const healthEnd = state.now() + healthBudget;
  let answered = 0;
  for (let attempt = 1; attempt <= HEALTHZ_ATTEMPTS; attempt += 1) {
    const left = Math.floor(healthEnd - state.now());
    if (left <= 0 || state.trial.signal.aborted) break;
    try {
      const response = await fetch(joinUrl(entry.url, HEALTHZ_PATH), {
        method: 'GET',
        headers: { accept: 'application/json' },
        redirect: 'error',
        signal: AbortSignal.any([state.trial.signal, AbortSignal.timeout(Math.max(1, left))]),
      });
      await response.arrayBuffer().catch(() => undefined);
      if (response.status === 200) answered += 1;
      else state.log(`boot: GET ${HEALTHZ_PATH} ${attempt}/${HEALTHZ_ATTEMPTS} answered HTTP ${response.status}`);
    } catch (err) {
      state.log(`boot: GET ${HEALTHZ_PATH} ${attempt}/${HEALTHZ_ATTEMPTS} failed (${messageOf(err)})`);
    }
  }
  state.log(`boot: ${HEALTHZ_PATH} answered ${answered}/${HEALTHZ_ATTEMPTS} times in ${Math.round(healthBudget)} ms`);
  return answered === HEALTHZ_ATTEMPTS;
}

/** Install the git adapter the GraphQL pull-request checks use; null (and a log line) when it cannot be. */
function installGitFixture(state: RunState): void {
  const entry = state.entry;
  if (entry === null) {
    configureGraphQLGit(null);
    return;
  }
  try {
    configureGraphQLGit(createGitFixture({ baseUrl: entry.url, token: state.token, signal: state.trial.signal, log: state.log }));
    state.log('graphql: the git fixture is installed over the suite\'s git client');
  } catch (err) {
    configureGraphQLGit(null);
    state.log(`graphql: the git fixture could not be installed (${messageOf(err)})`);
  }
}

/** The conformance phase: every check, one at a time, each with its own timeout, never overlapping. */
async function runConformance(state: RunState): Promise<void> {
  const issues = validateCheckSpecs(state.specs);
  for (const issue of issues) state.log(`manifest: ${issue}`);
  if (issues.length > 0) {
    // The suite is short of the manifest (a check module mid-build): the export pads every missing declared
    // check with a 0 id (export.ts exportCheckIds), so the denominator stays the manifest's and the checks
    // that do exist still score. A complete suite logs nothing here.
    state.log(`manifest: ${issues.length} issue(s); the suite runs anyway and the unregistered ids export 0`);
  }
  const entry = state.entry;
  if (entry === null) return;
  const phaseEnd = Math.min(state.deadline.deadlineMs, state.now() + CONFORMANCE_BUDGET_MS);
  for (const spec of state.specs) {
    const nowMs = state.now();
    const phaseLeft = Math.min(phaseEnd, state.deadline.deadlineMs) - nowMs;
    if (state.trial.signal.aborted || phaseLeft <= 0) {
      state.results[spec.id] = { ok: false, detail: 'deadline' };
      if (nowMs >= state.deadline.deadlineMs) state.deadlineFallen = true;
      continue;
    }
    const timeoutMs = checkTimeoutMs(spec.timeoutMs, phaseLeft);
    if (timeoutMs <= 0) {
      state.results[spec.id] = { ok: false, detail: 'deadline' };
      continue;
    }
    const controller = new AbortController();
    const onTrialAbort = (): void => controller.abort();
    state.trial.signal.addEventListener('abort', onTrialAbort, { once: true });
    if (state.trial.signal.aborted) controller.abort();
    const context: CheckContext = {
      baseUrl: entry.url,
      token: state.token,
      scenario: state.scenario,
      signal: controller.signal,
      deadlineMs: state.now() + timeoutMs,
      timeoutMs,
      log: (line: string) => state.log(`${spec.id}: ${line}`),
    };
    let result: CheckResult;
    try {
      // The deadline lets go of an abandoned check at once; before it, a bounded drain keeps one in flight.
      const drainMs = state.now() >= state.deadline.deadlineMs ? 0 : CHECK_DRAIN_GRACE_MS;
      result = await runCheck(spec, context, timeoutMs, controller, drainMs);
    } finally {
      state.trial.signal.removeEventListener('abort', onTrialAbort);
    }
    const detail = result.ok ? result.detail : result.detail ?? 'failed';
    state.results[spec.id] = result.ok ? { ok: true, detail } : { ok: false, detail };
    state.log(`${spec.id} ${result.ok ? 'pass' : 'fail'}${detail === undefined ? '' : ` — ${detail}`}`);
    if (state.now() >= state.deadline.deadlineMs) state.deadlineFallen = true;
  }
}

/** The benchmark phase: bench.ts's four workloads, bounded by the phase budget and the deadline. */
async function runBenchmarkPhase(state: RunState): Promise<PerfFile> {
  const entry = state.entry;
  if (entry === null) return failedPerfFile(BOOT_FAILED_NOTE);
  if (state.trial.signal.aborted) return failedPerfFile('the trial was aborted before the benchmark ran');
  const nowMs = state.now();
  if (nowMs >= state.deadline.deadlineMs) {
    state.deadlineFallen = true;
    return failedPerfFile('the internal deadline fell before the benchmark ran');
  }
  const phaseEnd = Math.min(state.deadline.deadlineMs, nowMs + BENCHMARK_BUDGET_MS);
  try {
    return await runBenchmark({
      baseUrl: entry.url,
      token: state.token,
      signal: state.trial.signal,
      deadlineMs: phaseEnd,
      now: state.now,
      log: (line: string) => state.log(line),
    });
  } catch (err) {
    state.log(`the benchmark threw (${messageOf(err)})`);
    return failedPerfFile(`the benchmark threw: ${messageOf(err)}`);
  }
}

/**
 * Write the export from whatever the run has, and answer the run's outcome. Called once per run, on the
 * normal path and on a throw alike; the perf file is bench.ts's measured one, or the sentinel file a run
 * that never benchmarked writes (never wire.ts emptyPerfFile's 0: a 0 would sort first on the tie-break).
 */
function finishSuite(state: RunState, startedAt: number): SuiteOutcome {
  const exportStart = state.now();
  const registered = state.registered || state.gate.registered;
  const perf = state.perf ?? failedPerfFile(registered ? (state.trial.signal.aborted ? 'the trial was aborted before the benchmark finished' : 'the benchmark did not run') : BOOT_FAILED_NOTE);
  const stateFile = stateExportOf({
    checkIds: state.specs.map((spec) => spec.id),
    results: state.results,
    bootOk: state.bootOk,
    notes: registered ? [] : [BOOT_FAILED_NOTE],
  });
  try {
    writeExportPair(state.stateDir, stateFile, perf);
    state.log(`export: state.json (${stateFile.counts.passed}/${stateFile.counts.total} passed, working ${stateFile.working}) and perf.json (${perf.points_total} points) written`);
  } catch (err) {
    state.log(`export: the export could not be written (${messageOf(err)})`);
  }
  state.phaseMs.export = roundMs(state.now() - exportStart);
  state.log(
    `phases: boot ${state.phaseMs.boot} ms, conformance ${state.phaseMs.conformance} ms, benchmark ${state.phaseMs.benchmark} ms, export ${state.phaseMs.export} ms`,
  );
  return {
    state: stateFile,
    perf,
    bootOk: state.bootOk,
    registered,
    working: stateFile.working,
    passed: stateFile.counts.passed,
    total: stateFile.counts.total,
    deadlineFallen: state.deadlineFallen,
    aborted: state.trial.signal.aborted,
    phaseMs: { ...state.phaseMs },
    durationMs: roundMs(state.now() - startedAt),
  };
}

/** The phases in order: ready, boot, conformance, benchmark, export (finishSuite always runs). */
async function runSuite(state: RunState): Promise<SuiteOutcome> {
  const startedAt = state.now();
  try {
    const bootStart = state.now();
    try {
      await waitForReadyFile(() => readReadyFile(state.stateDir), {
        timeoutMs: READY_WAIT_MS,
        signal: state.trial.signal,
        now: state.now,
      });
    } catch (err) {
      state.log(`ready: ${readyFilePath(state.stateDir)} did not read back (${messageOf(err)})`);
      return finishSuite(state, startedAt);
    }
    state.bootOk = await runBoot(state);
    state.phaseMs.boot = roundMs(state.now() - bootStart);
    if (!state.registered) {
      state.log('boot: no entry registered before the boot deadline');
      return finishSuite(state, startedAt);
    }
    if (state.trial.signal.aborted) return finishSuite(state, startedAt);
    installGitFixture(state);
    const conformanceStart = state.now();
    await runConformance(state);
    state.phaseMs.conformance = roundMs(state.now() - conformanceStart);
    if (state.trial.signal.aborted) return finishSuite(state, startedAt);
    const benchmarkStart = state.now();
    state.perf = await runBenchmarkPhase(state);
    state.phaseMs.benchmark = roundMs(state.now() - benchmarkStart);
  } catch (err) {
    state.log(`suite: stopped by ${messageOf(err)}`);
  }
  return finishSuite(state, startedAt);
}

// ---------------------------------------------------------------- the handle

/** What startEnv accepts; every field has a settled default from wire.ts. */
export interface EnvOptions {
  /** The environment to read (default process.env; a test passes a map). */
  readonly env?: Readonly<Record<string, string | undefined>>;
  /** MAKEFUN_STATE_DIR's value (default wire.ts stateDirOf(env)). */
  readonly stateDir?: string;
  /** MAKEFUN_ENV_HOST's value (default the listen.ts semantics). */
  readonly host?: string;
  /** MAKEFUN_ENV_PORT's value (default 8080; 0 picks a free port). */
  readonly port?: number;
  /** The trial's wall budget, seconds (default wire.ts TRIAL_WALL_BUDGET_SEC or MAKEFUN_TRIAL_WALL_BUDGET_SEC). */
  readonly wallBudgetSec?: number;
  /** The suite's checks (default suiteChecks(); a test passes a short list). */
  readonly checks?: readonly CheckSpec[];
  /** The monotonic clock (default performance.now; the deadline is on this clock). */
  readonly now?: () => number;
  /** The diagnostic sink (default stderr with ENV_LOG_PREFIX). */
  readonly log?: (line: string) => void;
  /** How long to keep serving after the internal deadline (default DEADLINE_EXIT_GRACE_MS). */
  readonly exitGraceMs?: number;
}

/** A running env: its listener, its deadline, the suite's outcome and one idempotent stop. */
export interface EnvHandle {
  readonly server: Server;
  readonly address: EnvAddress;
  readonly stateDir: string;
  readonly deadline: Deadline;
  /** Resolves once the suite wrote its export (on the normal path or after a throw). */
  readonly done: Promise<SuiteOutcome>;
  /** Abort, write the export, close the listener; resolves 0. Idempotent. */
  stop(reason?: string): Promise<number>;
  /** Resolves once stopped (the deadline's grace included). */
  readonly stopped: Promise<number>;
}

/** Start the env: bind, write ready, serve /register and /done, run the phases in the background. */
export async function startEnv(options: EnvOptions = {}): Promise<EnvHandle> {
  const env = options.env ?? process.env;
  const stateDir = options.stateDir ?? stateDirOf(env);
  const now = options.now ?? ((): number => performance.now());
  const log = options.log ?? realLog;
  const startedAt = now();
  const wallBudgetSec = options.wallBudgetSec ?? trialWallBudgetOf(env);
  const deadline = deadlineOf(startedAt, wallBudgetSec);
  const token = env[TOKEN_ENV] ?? '';
  const specs = options.checks === undefined ? suiteChecks() : [...options.checks];
  const gate = new RegisterGate();
  const trial = new AbortController();
  const results: Record<CheckId, CheckOutcome> = {};
  const phaseMs: Record<Phase, number> = { boot: 0, conformance: 0, benchmark: 0, export: 0 };
  let done = false;
  const isDone = (): boolean => done;
  const server = createEnvServer({ gate, isDone, log });
  const target = listenTargetOf(env, { host: options.host, port: options.port });
  const address = await bindServer(server, target);
  mkdirSync(stateDir, { recursive: true });
  // The pass's call log (grader/agent.ts ENV_LOG_FILE): finishPass faults `env` when a pass wrote none, and
  // this env makes no model calls, so it writes the empty log the harness stores and never a fabricated line.
  writeFileSync(joinPath(stateDir, CALLS_LOG_FILE), '');
  writeReadyFile(stateDir, address);
  log(`listening on ${address.host}:${address.port}, state ${stateDir}`);
  log(`internal deadline in ${Math.round(deadline.deadlineMs - startedAt)} ms (wall budget ${wallBudgetSec} s less ${DEADLINE_MARGIN_MS} ms)`);

  const state: RunState = {
    gate,
    specs,
    stateDir,
    token,
    scenario: buildScenario(),
    deadline,
    now,
    log,
    trial,
    results,
    phaseMs,
    bootOk: false,
    registered: false,
    deadlineFallen: false,
    entry: null,
    perf: null,
  };

  let resolveStopped: (code: number) => void = () => undefined;
  const stopped = new Promise<number>((resolve) => {
    resolveStopped = resolve;
  });
  let stopping: Promise<number> | null = null;
  let exitTimer: ReturnType<typeof setTimeout> | undefined;

  const stop = (reason?: string): Promise<number> => {
    if (stopping !== null) return stopping;
    stopping = (async (): Promise<number> => {
      if (reason !== undefined) log(`stopping: ${reason}`);
      trial.abort();
      if (exitTimer !== undefined) clearTimeout(exitTimer);
      const registered = state.registered || state.gate.registered;
      const perf = state.perf ?? failedPerfFile(registered ? 'the trial was aborted before the benchmark finished' : BOOT_FAILED_NOTE);
      const stateFile = stateExportOf({
        checkIds: state.specs.map((spec) => spec.id),
        results: state.results,
        bootOk: state.bootOk,
        notes: registered ? [] : [BOOT_FAILED_NOTE],
      });
      try {
        const written = writeExportPair(state.stateDir, stateFile, perf);
        log(`export on stop: state.json ${written.state.written ? 'written' : 'kept'}, perf.json ${written.perf.written ? 'written' : 'kept'}`);
      } catch (err) {
        log(`export on stop: could not be written (${messageOf(err)})`);
      }
      done = true;
      await new Promise<void>((resolve) => {
        server.close(() => resolve());
        server.closeIdleConnections();
        server.closeAllConnections();
      });
      resolveStopped(0);
      return 0;
    })();
    return stopping;
  };

  const donePromise = runSuite(state)
    .catch((err: unknown): SuiteOutcome => {
      log(`suite: threw ${messageOf(err)}`);
      return finishSuite(state, startedAt);
    })
    .then((outcome) => {
      done = true;
      if (outcome.deadlineFallen && stopping === null) {
        log(`the internal deadline fell: exported; exiting ${options.exitGraceMs ?? DEADLINE_EXIT_GRACE_MS} ms after /done`);
        exitTimer = setTimeout(() => {
          void stop('the internal deadline');
        }, options.exitGraceMs ?? DEADLINE_EXIT_GRACE_MS);
      }
      return outcome;
    });

  return {
    server,
    address,
    stateDir,
    deadline,
    done: donePromise,
    stop,
    stopped,
  };
}

/**
 * Start the env, install SIGTERM/SIGINT handlers for the whole life (a signal before the listener is
 * ready writes the boot-failure export), and wait for one of them (or the deadline's grace exit).
 */
export async function runEnv(options: EnvOptions = {}): Promise<number> {
  const env = options.env ?? process.env;
  const stateDir = options.stateDir ?? stateDirOf(env);
  const log = options.log ?? realLog;
  let handle: EnvHandle | null = null;
  const onSignal = (signal: string): void => {
    if (handle !== null) {
      void handle.stop(signal);
      return;
    }
    log(`stopping: ${signal} before the listener was ready`);
    try {
      writeBootFailure(stateDir, suiteChecks().map((spec) => spec.id));
    } catch (err) {
      log(`the boot-failure export could not be written: ${messageOf(err)}`);
    }
    process.exit(0);
  };
  process.on('SIGTERM', onSignal);
  process.on('SIGINT', onSignal);
  try {
    handle = await startEnv({ ...options, env, stateDir, log });
    return await handle.stopped;
  } finally {
    process.removeListener('SIGTERM', onSignal);
    process.removeListener('SIGINT', onSignal);
  }
}

/** The export a run that never started (a fatal error) writes: already-better files on disk are kept. */
function writeBootFailure(stateDir: string, checkIds: readonly CheckId[]): void {
  writeExportPair(stateDir, bootFailureExport(checkIds), failedPerfFile(BOOT_FAILED_NOTE));
}

/**
 * The program: run the env, and never crash without an export. A throw before or during the run writes
 * the boot-failure export (kept only where no better one is on disk) and exits 1; a signal writes the
 * export and exits 0.
 */
export async function main(env: Readonly<Record<string, string | undefined>> = process.env): Promise<number> {
  const stateDir = stateDirOf(env);
  const log = realLog;
  const checkIds = (): CheckId[] => suiteChecks().map((spec) => spec.id);
  const fatal = (label: string, err: unknown): void => {
    log(`${label}: ${messageOf(err)}`);
    try {
      writeBootFailure(stateDir, checkIds());
    } catch (writeErr) {
      log(`the boot-failure export could not be written: ${messageOf(writeErr)}`);
    }
  };
  process.on('uncaughtException', (err: Error) => {
    fatal('uncaught exception', err);
    process.exit(1);
  });
  process.on('unhandledRejection', (reason: unknown) => {
    fatal('unhandled rejection', reason);
    process.exit(1);
  });
  try {
    return await runEnv({ env, log });
  } catch (err) {
    fatal('fatal', err);
    return 1;
  }
}
// github-core-clone-01's export writer: the two files the sealed scorer reads, their bytes, and the rule
// that a worse export never replaces a better one.
//
//   <stateDir>/export/state.json   wire.ts StateFile: the run's pass/fail bits, the counts derived from
//                                  them, a static perfTiers table and working. Canonical JSON (keys sorted
//                                  at every depth, one trailing newline), integers only.
//   <stateDir>/export/perf.json    wire.ts PerfFile: the benchmark's measured rounds, points and tiers.
//
// THE RULING THIS FILE IMPLEMENTS (the item's settled decision): state.json holds no timing-derived value.
// A contender's trial is replayed and the two state exports are compared byte for byte, so a field derived
// from a measured duration would make two runs of the same entry differ on noise alone. The measured bands
// therefore live in perf.json alone (bench.ts perfFileOf), the scorer reads the perf column from
// perf.json (scorer/score.ts reads points_total there), and state.json's perfTiers is the four workload
// names at 0: present, typed 0..4 as wire.ts requires, and identical on every run. manifest.ts
// perfTiersOf() is still the function that turns measured points into bands; it is called by bench.ts,
// never here.
//
// WRITES: synchronous and atomic (a temporary beside the file, written and fsynced, then renamed), because
// a SIGTERM handler writes them from inside the signal. A state export that passed no more checks, or a perf
// export that scored fewer points, than the file already on disk is not written: a completed run survives a
// later boot failure or an abort in the same state directory. An equal export is rewritten: its bytes are
// the same, so a replay compares equal either way.
//
// This module imports Node's fs (it is the writer) and nothing outside env/src; scripts/competitions/
// build-agent-bundle.ts inlines it into the sealed env.

import { closeSync, fsyncSync, mkdirSync, openSync, readFileSync, renameSync, writeSync } from 'node:fs';
import {
  BENCH_WORKLOAD_NAMES,
  CHECK_GROUPS,
  checkGroupOf,
  checkId,
  countsFromChecks,
  stateFromChecks,
  type BenchWorkloadName,
} from './manifest.ts';
import {
  BOOT_FAILED_NOTE,
  canonicalJsonLine,
  exportDirPath,
  isPerfFile,
  isStateFile,
  perfFilePath,
  stateFilePath,
  workingBit,
  type Bit,
  type CheckId,
  type PerfFile,
  type PerfTier,
  type StateFile,
} from './wire.ts';

/** What one check reported: its bit and the line its log showed (a detail never enters an export). */
export interface CheckOutcome {
  readonly ok: boolean;
  readonly detail?: string;
}

/**
 * The perfTiers table state.json carries: the four workloads at 0. Not the measured bands (perf.json's
 * tiers), so two runs of one entry on one seed write identical bytes (see the header).
 */
export const STATIC_PERF_TIERS: Readonly<Record<BenchWorkloadName, PerfTier>> = Object.freeze({
  push: 0,
  clone: 0,
  read: 0,
  write: 0,
});

/** Everything the state export needs: the manifest's ids, the run's results, and whether boot succeeded. */
export interface StateExportInput {
  /** Every check id the manifest declares, in registration order (manifest.ts checkIdsOf(specs)). */
  readonly checkIds: readonly CheckId[];
  /** The run's outcomes; an id with no entry (never reached) is 0. */
  readonly results: Readonly<Record<CheckId, CheckOutcome | undefined>>;
  /** Whether the boot phase succeeded (the entry registered and /healthz answered twice). */
  readonly bootOk: boolean;
  /** Fixed causes only, never a timing (wire.ts notes). */
  readonly notes?: readonly string[];
  /** Pad a suite short of the manifest with one 0 id a missing check (default true); false exports as given. */
  readonly pad?: boolean;
}

/**
 * The manifest's whole id list: `checkIds` plus one `<group>.missing-<n>` id (bit 0) for every check a
 * group declares but does not register. The scorer refuses an export whose counts.total is past its checks
 * map (scorer/score.ts), so a suite mid-build still exports every declared id and the five unregistered
 * checks count 0 against the manifest's denominator instead of shrinking it. A complete suite is unchanged.
 */
export function exportCheckIds(checkIds: readonly CheckId[]): CheckId[] {
  const present = new Set(checkIds);
  const out: CheckId[] = [...present];
  for (const group of CHECK_GROUPS) {
    let registered = 0;
    for (const id of present) if (checkGroupOf(id) === group.id) registered += 1;
    for (let index = registered; index < group.checks; index += 1) {
      let suffix = index - registered + 1;
      let id = checkId(group.id, `missing-${suffix}`);
      while (present.has(id)) {
        suffix += 1;
        id = checkId(group.id, `missing-${suffix}`);
      }
      present.add(id);
      out.push(id);
    }
  }
  return out;
}

/** The run's 0|1 bits, one for every id given (an unrun check is 0). */
export function checksOf(input: StateExportInput): Record<CheckId, Bit> {
  const checks: Record<CheckId, Bit> = {};
  for (const id of input.checkIds) checks[id] = input.results[id]?.ok === true ? 1 : 0;
  return checks;
}

/**
 * state.json from a run: every declared check's bit, counts derived from the bits (manifest.ts
 * countsFromChecks), the static perfTiers, working = 1 only when boot succeeded and at least one check
 * passed (wire.ts workingBit), and the caller's fixed notes. No clock, no port and no random id enters it.
 */
export function stateExportOf(input: StateExportInput): StateFile {
  const checkIds = input.pad === false ? [...input.checkIds] : exportCheckIds(input.checkIds);
  const bitsInput: StateExportInput = { ...input, checkIds };
  const checks = checksOf(bitsInput);
  const counts = countsFromChecks(checks);
  const working = workingBit(input.bootOk, counts.passed);
  const notes = input.notes === undefined ? [] : input.notes.slice();
  return stateFromChecks({ checks, checkIds, perfTiers: STATIC_PERF_TIERS, working, notes });
}

/** The export a boot failure writes: every check 0, working 0, the fixed boot note (wire.ts BOOT_FAILED_NOTE). */
export function bootFailureExport(checkIds: readonly CheckId[], notes: readonly string[] = [BOOT_FAILED_NOTE]): StateFile {
  return stateExportOf({ checkIds, results: {}, bootOk: false, notes });
}

/** The result of one file's write: whether it was written, kept, and where it sits. */
export interface ExportWrite {
  readonly written: boolean;
  readonly kept: boolean;
  readonly path: string;
}

/** A parsed state.json from disk, or null when the file is absent, unreadable or not this contract's. */
export function readStateExport(file: string): StateFile | null {
  try {
    const parsed: unknown = JSON.parse(readFileSync(file, 'utf8'));
    return isStateFile(parsed) ? parsed : null;
  } catch {
    return null;
  }
}

/** A parsed perf.json from disk, or null when the file is absent, unreadable or not this contract's. */
export function readPerfExport(file: string): PerfFile | null {
  try {
    const parsed: unknown = JSON.parse(readFileSync(file, 'utf8'));
    return isPerfFile(parsed) ? parsed : null;
  } catch {
    return null;
  }
}

/**
 * Whether `next` may replace `existing`: not worse. A run that works beats one that does not, and among
 * runs that agree on working, the one with more passing checks wins; an equal state is rewritten (its bytes
 * are the same). Anything else keeps the file already on disk.
 */
export function stateNotWorse(existing: StateFile, next: StateFile): boolean {
  if (next.working !== existing.working) return next.working > existing.working;
  return next.counts.passed >= existing.counts.passed;
}

/** Whether `next` may replace `existing` perf: a run that scored at least as many points may. */
export function perfNotWorse(existing: PerfFile, next: PerfFile): boolean {
  return next.points_total >= existing.points_total;
}

/** Write a file whole: a temporary beside it, written and fsynced, then renamed over it. */
function writeAtomic(file: string, text: string): void {
  const tmp = `${file}.tmp`;
  const fd = openSync(tmp, 'w');
  try {
    writeSync(fd, text);
    fsyncSync(fd);
  } finally {
    closeSync(fd);
  }
  renameSync(tmp, file);
}

/**
 * Write export/state.json with canonicalJsonLine's exact bytes. With `keepBetter` (the default) an export
 * on disk that is not worse than this one is kept; `{ keepBetter: false }` always writes.
 */
export function writeStateExport(stateDir: string, state: StateFile, options: { readonly keepBetter?: boolean } = {}): ExportWrite {
  const dir = exportDirPath(stateDir);
  mkdirSync(dir, { recursive: true });
  const path = stateFilePath(stateDir);
  if (options.keepBetter !== false) {
    const existing = readStateExport(path);
    if (existing !== null && !stateNotWorse(existing, state)) return { written: false, kept: true, path };
  }
  writeAtomic(path, canonicalJsonLine(state));
  return { written: true, kept: false, path };
}

/**
 * Write export/perf.json with canonicalJsonLine's exact bytes. With `keepBetter` (the default) a perf file
 * on disk that scored more points is kept; `{ keepBetter: false }` always writes.
 */
export function writePerfExport(stateDir: string, perf: PerfFile, options: { readonly keepBetter?: boolean } = {}): ExportWrite {
  const dir = exportDirPath(stateDir);
  mkdirSync(dir, { recursive: true });
  const path = perfFilePath(stateDir);
  if (options.keepBetter !== false) {
    const existing = readPerfExport(path);
    if (existing !== null && !perfNotWorse(existing, perf)) return { written: false, kept: true, path };
  }
  writeAtomic(path, canonicalJsonLine(perf));
  return { written: true, kept: false, path };
}

/**
 * Write both exports: state.json first (the authoritative pass/fail set, so a run cut between the two files
 * never pairs a new perf with an older state), then perf.json. Each keeps a better file already on disk.
 */
export function writeExportPair(stateDir: string, state: StateFile, perf: PerfFile): { readonly state: ExportWrite; readonly perf: ExportWrite } {
  const stateWrite = writeStateExport(stateDir, state);
  const perfWrite = writePerfExport(stateDir, perf);
  return { state: stateWrite, perf: perfWrite };
}

/** Every workload name in state.json's perfTiers, for a reader that wants the table's keys. */
export const PERF_TIER_KEYS: readonly BenchWorkloadName[] = Object.freeze([...BENCH_WORKLOAD_NAMES]);

