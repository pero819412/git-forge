{
  "name": "github-core-clone-01-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal GitHub-compatible forge: the lifecycle and two answers, ready to grow into the contest's surface",
  "license": "MIT",
